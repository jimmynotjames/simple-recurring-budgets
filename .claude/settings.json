{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hooks/guard_bash_hygiene.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Skill",
      "Agent",
      "Read(./**)",
      "Edit(./**)",
      "Bash(make *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(python3 *)",
      "Bash(bash scripts/*)",
      "Bash(bash -n scripts/*)",
      "Bash(xcodebuild *)",
      "Bash(xcrun *)",
      "Bash(swiftlint *)",
      "Bash(swiftformat *)",
      "Bash(gitleaks *)",
      "Bash(lefthook *)",
      "Bash(fastlane *)",
      "Bash(openspec *)",
      "Bash(mkdir *)",
      "Bash(lipo *)",
      "Bash(UI_WORKERS=* *)",
      "Bash(UI_RETRY_ON_FAILURE=* *)",
      "Bash(TEST_RUNNER_FORCE_ANIMATIONS=* *)",
      "Bash(SIMULATOR_SLOTS_FEWER=* *)",
      "Bash(SIMULATOR_SLOTS_TIMEOUT=* *)",
      "Bash(SIMULATOR_SLOTS_MASTER=* *)",
      "Bash(rm -f tmp/*)",
      "Bash(rm -rf tmp/*)",
      "mcp__18cf5017-f11b-4601-92d4-9f346ebf3d65",
      "Bash(SUBSET_ONLY=* *)",
      "Bash(rm tmp/*)",
      "Bash(rmdir *)",
      "Bash(chmod +x *)",
      "Bash(mv openspec/changes/* openspec/changes/archive/*)",
      "Bash(tee tmp/*)",
      "Bash(open fastlane/screenshots/*)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(echo *)",
      "Bash(grep *)",
      "Bash(egrep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(awk *)",
      "Bash(tr *)",
      "Bash(jq *)",
      "Bash(sleep *)",
      "Bash(ps *)",
      "Bash(pgrep *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(plutil *)",
      "Bash(security find-identity *)",
      "WebSearch",
      "WebFetch",
      "mcp__ccd_session__mark_chapter"
    ]
  }
}
