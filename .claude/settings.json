{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hooks/guard_bash_hygiene.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Skill",
      "Agent",
      "Read(./**)",
      "Edit(./**)",
      "Bash(make *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(python3 *)",
      "Bash(bash scripts/*)",
      "Bash(bash -n scripts/*)",
      "Bash(xcodebuild *)",
      "Bash(xcrun *)",
      "Bash(swiftlint *)",
      "Bash(swiftformat *)",
      "Bash(gitleaks *)",
      "Bash(lefthook *)",
      "Bash(fastlane *)",
      "Bash(openspec *)",
      "Bash(mkdir *)",
      "Bash(lipo *)",
      "Bash(UI_WORKERS=* *)",
      "Bash(UI_RETRY_ON_FAILURE=* *)",
      "Bash(TEST_RUNNER_FORCE_ANIMATIONS=* *)",
      "Bash(SIMULATOR_SLOTS_FEWER=* *)",
      "Bash(SIMULATOR_SLOTS_TIMEOUT=* *)",
      "Bash(SIMULATOR_SLOTS_MASTER=* *)",
      "Bash(rm -f tmp/*)",
      "Bash(rm -rf tmp/*)",
      "Bash(SUBSET_ONLY=* *)",
      "Bash(rm tmp/*)",
      "Bash(rmdir *)",
      "Bash(chmod +x *)",
      "Bash(mv openspec/changes/* openspec/changes/archive/*)",
      "Bash(tee tmp/*)",
      "Bash(open fastlane/screenshots/*)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(echo *)",
      "Bash(grep *)",
      "Bash(egrep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(awk *)",
      "Bash(tr *)",
      "Bash(jq *)",
      "Bash(sleep *)",
      "Bash(ps *)",
      "Bash(pgrep *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(plutil *)",
      "Bash(security find-identity *)",
      "Bash(softwareupdate --list)",
      "Bash(claude --version)",
      "Bash(npm ls -g @anthropic-ai/claude-code)",
      "WebSearch",
      "WebFetch",
      "mcp__ccd_session__mark_chapter",
      "mcp__mixpanel__Run-Query",
      "mcp__mixpanel__Search-Entities",
      "mcp__mixpanel__Get-Business-Context",
      "mcp__mixpanel__Get-Query-Schema",
      "mcp__mixpanel__List-Dashboards",
      "mcp__mixpanel__Get-Dashboard",
      "mcp__mixpanel__Display-Query",
      "mcp__mixpanel__Get-Report",
      "mcp__mixpanel__Get-Metric",
      "mcp__mixpanel__List-Metrics",
      "mcp__mixpanel__Get-Events",
      "mcp__mixpanel__Get-Property-Values",
      "mcp__mixpanel__List-Properties",
      "mcp__mixpanel__Get-Projects",
      "mcp__mixpanel__List-Organizations",
      "mcp__mixpanel__Get-Lexicon-URL",
      "mcp__mixpanel__Get-Issues",
      "mcp__mixpanel__Find-Duplicate-Event-Groups",
      "mcp__mixpanel__Get-User-Replays-Data",
      "mcp__mixpanel__Get-Experiment",
      "mcp__mixpanel__List-Experiments",
      "mcp__mixpanel__Search-Prior-Experiments",
      "mcp__mixpanel__Run-Experiment-Pre-Launch-Checks",
      "mcp__mixpanel__Explain-Experiment-Health-Check",
      "mcp__mixpanel__Get-Experiment-Results-Interpretation-Guidance",
      "mcp__mixpanel__Get-Experiment-Setup-Guidance",
      "mcp__mixpanel__Get-Feature-Flag",
      "mcp__mixpanel__List-Feature-Flags",
      "mcp__mixpanel__Get-Feature-Flag-Lifecycle-Guidance",
      "mcp__mixpanel__Get-Feature-Flag-Setup-Guidance",
      "mcp__mixpanel__Create-Dashboard",
      "mcp__mixpanel__Update-Dashboard",
      "mcp__mixpanel__Duplicate-Dashboard",
      "mcp__mixpanel__Create-Metric",
      "mcp__mixpanel__Update-Metric"
    ]
  }
}
