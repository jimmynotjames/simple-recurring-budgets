# Fastlane
fastlane/report.xml
fastlane/Preview.html
# Captured App Store screenshots + the snapshot HTML report are build artifacts:
# large, regenerable via `fastlane screenshots`, and never committed (the source of
# truth is App Store Connect + the small ScreenshotSeeds/ catalog). Kept on disk
# locally so `fastlane push_screenshots` can upload them. The .gitkeep is allowlisted
# below so the folder persists in git.
fastlane/screenshots/**/*.png
fastlane/screenshots/screenshots.html
!fastlane/screenshots/.gitkeep
!fastlane/screenshots/**/.gitkeep
fastlane/test_output

# gym build output (.ipa / .xcarchive)
build/

# App Store Connect API keys — never commit (belt-and-suspenders;
# the .p8 lives outside the repo, but block it everywhere just in case)
*.p8
AuthKey_*.p8

# Env files
.env
.env.local

# App secrets — local overrides (real tokens/email/URL); never commit.
# Committed Config/Secrets.xcconfig holds safe placeholders.
config/Secrets.local.xcconfig

# Claude Code
.claude/worktrees/

# Claude Code — local-only (see https://code.claude.com/docs/en/claude-directory)
.claude/settings.local.json
.claude/scheduled_tasks.lock
CLAUDE.local.md

# skills CLI working/source tree — regenerable from skills-lock.json via
# `npx skills experimental_install`. Consumed copies are committed under
# .claude/skills/ (Claude Code) and .cursor/skills/ (Cursor).
.agents/

# Translation pipeline — generated outputs (keep .gitkeep to preserve dirs)
tmp/
