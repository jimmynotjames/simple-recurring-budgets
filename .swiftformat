# https://github.com/nicklockwood/SwiftFormat/blob/master/Rules.md
--swiftversion 6.0
--indent 2
--importgrouping alpha
--wraparguments before-first
--wrapparameters before-first
--header strip
--linebreaks lf
--maxwidth 200
# SwiftLint owns modifier ordering (modifier_order rule with isolation-before-acl order).
# Disabling here prevents the swiftformat→swiftlint conflict on `nonisolated private`.
--disable modifierOrder
# SwiftLint owns brace placement (opening_brace rule, K&R same-line style). SwiftFormat's
# wrapMultilineStatementBraces wants the opposite (brace on its own line) for multiline
# statements, so the two oscillate and swiftlint-fix (run last in pre-commit) wins — leaving
# code that `swiftformat --lint` then rejects in CI. Disable here so swiftformat defers.
--disable wrapMultilineStatementBraces
# Top-level `build/` (gitignored local scratch/artifacts, e.g. ci-repro checkouts) isn't
# covered by SwiftFormat's default excludes (only `.build` is) — exclude it explicitly so
# vendored SPM dependency source never gets formatted.
--exclude build
