# https://github.com/nicklockwood/SwiftFormat/blob/master/Rules.md
--swiftversion 6.0
--indent 2
--importgrouping alpha
--wraparguments before-first
--wrapparameters before-first
--header strip
--linebreaks lf
--maxwidth 200
# SwiftLint owns modifier ordering (modifier_order, isolation before ACL); avoids a
# swiftformat/swiftlint conflict on `nonisolated private`.
--disable modifierOrder
# SwiftLint owns brace placement (opening_brace, K&R same-line). SwiftFormat's
# wrapMultilineStatementBraces wants the brace on its own line for multiline statements;
# the two oscillate, swiftlint-fix (last in pre-commit) wins, and CI's
# `swiftformat --lint` then rejects the result. Disabled so swiftformat defers.
--disable wrapMultilineStatementBraces
# Top-level gitignored `build/` (scratch, e.g. ci-repro checkouts) isn't in SwiftFormat's
# default excludes (only `.build` is); exclude it so vendored SPM source isn't formatted.
--exclude build
