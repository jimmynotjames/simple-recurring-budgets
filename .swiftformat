# https://github.com/nicklockwood/SwiftFormat/blob/master/Rules.md
--swiftversion 6.0
--indent 2
--importgrouping alpha
--wraparguments before-first
--wrapparameters before-first
--header strip
--linebreaks lf
--maxwidth 200
# SwiftLint owns modifier ordering (modifier_order rule with isolation-before-acl order).
# Disabling here prevents the swiftformat→swiftlint conflict on `nonisolated private`.
--disable modifierOrder
