// config/Secrets.local.xcconfig.template — committed template.
//
// Copy this file to config/Secrets.local.xcconfig (gitignored) and fill in
// your real values. Required for TestFlight / App Store shipping.
// See CONTRIBUTING.md § B — Configure secrets.
//
// Note: xcconfig treats "//" as a comment, so URLs use the DOUBLE_SLASH trick.
// DOUBLE_SLASH is defined in the base Secrets.xcconfig file (already included).
// Replace only the host/path portion; keep the $(DOUBLE_SLASH) syntax.

MIXPANEL_DEV_TOKEN = your_32_char_dev_token_here
MIXPANEL_PROD_TOKEN = your_32_char_prod_token_here
FEEDBACK_EMAIL = you@example.com
PRIVACY_POLICY_URL = https:$(DOUBLE_SLASH)your-site.com/privacy
