// config/Secrets.local.xcconfig.template — committed template.
//
// Copy to config/Secrets.local.xcconfig (gitignored) and fill in real values
// (required for TestFlight / App Store). See CONTRIBUTING.md § B.
//
// xcconfig treats "//" as a comment, so URLs use $(DOUBLE_SLASH), defined in the base
// Secrets.xcconfig. Replace only the host/path; keep the $(DOUBLE_SLASH) syntax.

MIXPANEL_DEV_TOKEN = your_32_char_dev_token_here
MIXPANEL_PROD_TOKEN = your_32_char_prod_token_here
FEEDBACK_EMAIL = you@example.com
PRIVACY_POLICY_URL = https:$(DOUBLE_SLASH)your-site.com/privacy
