// Config/Secrets.xcconfig — committed, safe placeholder defaults.
//
// Placeholders let the app build and run on Simulator with no setup; at runtime it
// detects them and falls back to ConsoleAnalyticsClient (no Mixpanel traffic).
//
// For real values (required for TestFlight/App Store), copy
// Config/Secrets.local.xcconfig.template → Config/Secrets.local.xcconfig (gitignored).
//
// Sentinel strings: keep in sync with AppConfig.Placeholder in Swift;
// scripts/verify_release_secrets.sh reads them from this file.
//
// xcconfig treats "//" as a comment, so URLs go through SLASH / DOUBLE_SLASH.

SLASH = /
DOUBLE_SLASH = $(SLASH)$(SLASH)

MIXPANEL_DEV_TOKEN = PLACEHOLDER_MIXPANEL_DEV_TOKEN
MIXPANEL_PROD_TOKEN = PLACEHOLDER_MIXPANEL_PROD_TOKEN
FEEDBACK_EMAIL = noreply@example.com
PRIVACY_POLICY_URL = https:$(DOUBLE_SLASH)example.com/privacy

// Local overrides (gitignored); included last so they win.
#include? "Secrets.local.xcconfig"
