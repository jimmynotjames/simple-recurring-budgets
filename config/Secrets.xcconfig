// Config/Secrets.xcconfig — committed, safe placeholder defaults.
//
// These placeholder values allow the app to compile and run on Simulator
// without any extra setup. The app detects placeholders at runtime and
// falls back to ConsoleAnalyticsClient (no Mixpanel traffic).
//
// To use real values (required for TestFlight/App Store), copy
// Config/Secrets.local.xcconfig.template → Config/Secrets.local.xcconfig
// and fill in your values. That file is gitignored.
//
// Sentinel strings — keep in sync with AppConfig.Placeholder in Swift.
// The release ship guard (scripts/verify_release_secrets.sh) reads these
// directly from this file.
//
// Note: xcconfig treats "//" as a comment, so URLs use a SLASH + DOUBLE_SLASH
// indirection trick to avoid the parser consuming "//".

SLASH = /
DOUBLE_SLASH = $(SLASH)$(SLASH)

MIXPANEL_DEV_TOKEN = PLACEHOLDER_MIXPANEL_DEV_TOKEN
MIXPANEL_PROD_TOKEN = PLACEHOLDER_MIXPANEL_PROD_TOKEN
FEEDBACK_EMAIL = noreply@example.com
PRIVACY_POLICY_URL = https:$(DOUBLE_SLASH)example.com/privacy

// Optional local overrides (gitignored). Included last so values win.
#include? "Secrets.local.xcconfig"
