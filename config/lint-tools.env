# Exact lint and hook tool versions. scripts/check-tool-versions.sh holds local installs to
# these (gate and make system); .github/workflows/ci.yml downloads these releases
# (SwiftLint as the ghcr.io/realm/swiftlint image of the same tag).
# Bump a version here (and SwiftFormat's --min-version in .swiftformat, where set), then
# `brew upgrade <tool>`.
SWIFTFORMAT_VERSION=0.64.1
SWIFTLINT_VERSION=0.65.1
GITLEAKS_VERSION=8.30.1
LEFTHOOK_VERSION=2.2.2
