# App Store Connect API key configuration.
#
# 1. Copy this file to fastlane/.env  (which is gitignored):
#       cp fastlane/.env.template fastlane/.env
# 2. Fill in the three values below from your ASC API key.
#       ASC API key page: App Store Connect > Users and Access > Integrations
# 3. Keep the .p8 file OUTSIDE this repo (e.g. ~/.appstoreconnect/).
#
# fastlane auto-loads fastlane/.env, so no flags are needed.

# 10-character Key ID shown next to the key.
ASC_API_KEY_ID=XXXXXXXXXX

# Issuer ID (UUID) shown at the top of the Integrations page.
ASC_API_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Absolute path to the downloaded .p8 private key (NOT inside this repo).
ASC_API_KEY_FILEPATH=/Users/jimmynotjames/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
