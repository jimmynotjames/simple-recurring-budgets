# App Store / TestFlight automation for Wren. Auth: App Store Connect API key from
# gitignored fastlane/.env. See fastlane/README.md for live vs. dormant lanes.

default_platform(:ios)
require_relative "lib/metadata_publish"

RELEASE_ROOT = File.expand_path("..", __dir__)

SCHEME = "simple-recurring-budgets"
OUTPUT_DIR = "./build"
APP_IDENTIFIER = "com.jimmyho.simple-recurring-budgets"

# Next build number = highest TestFlight build + 1. Derived from App Store Connect
# (source of truth, never collides); its builds API includes builds still processing.
# `initial_build_number: 0` makes a brand-new app/version start at 1.
def next_build_number
  latest = latest_testflight_build_number(
    app_identifier: APP_IDENTIFIER,
    initial_build_number: 0
  )
  latest + 1
end

# Persist the build number into project.pbxproj so local/Xcode Debug builds show the
# last-shipped number (the Settings version row reads CFBundleVersion, synthesized
# from CURRENT_PROJECT_VERSION). Uses a plain gsub so the diff is only the numeric
# tokens: agvtool/`increment_build_number` can't be used (VERSIONING_SYSTEM is unset)
# and the xcodeproj gem would reformat the whole file. Sets every target (app +
# tests), like agvtool. See fastlane/SETUP.md "Build numbers".
def set_project_build_number(number)
  path = "../simple-recurring-budgets.xcodeproj/project.pbxproj"
  contents = File.read(path)
  updated = contents.gsub(/CURRENT_PROJECT_VERSION = \d+;/,
                          "CURRENT_PROJECT_VERSION = #{number};")
  File.write(path, updated)
end

# Release ship guard: fails fast if placeholder secrets remain, before archive/sign/upload.
# Don't call from lanes that ship no Release binary (verify_auth, screenshots,
# push_metadata, push_screenshots).
def verify_ship_secrets!
  sh("../scripts/verify_release_secrets.sh")
end

# Holds up to `want` slots of the machine-wide simulator pool for the whole block
# (AGENTS.md §"Simulator slots") and yields the granted count. The pool is on only
# where its master exists (~/dev/simulator-slots, or $SIMULATOR_SLOTS_MASTER);
# elsewhere this takes nothing and yields nil, leaving the Snapfile's settings alone.
# The holder process watches this one and releases the slots when it exits, however
# it exits. Lanes run from fastlane/, so the repo root is "..".
def with_simulator_slots(want, label)
  master = ENV.fetch("SIMULATOR_SLOTS_MASTER", File.expand_path("~/dev/simulator-slots"))
  unless Dir.exist?(master)
    UI.important("simulator-slots: no shared pool at #{master} (expected outside the maintainer's machine); " \
                 "running without machine-wide coordination. See AGENTS.md §\"Simulator slots\".")
    return yield(nil)
  end

  require "digest"
  root = File.expand_path("..")
  tool = File.join(root, "scripts", "simulator-slots", "simulator_slots.py")
  owns = "[#{Digest::SHA1.hexdigest(root)[0, 8]}]"
  holder = IO.popen(["python3", tool, "hold", "--watch-pid", Process.pid.to_s, "--want", want.to_s,
                     "--label", label, "--root", root, "--owns", owns])
  line = holder.gets
  if line.nil?
    holder.close
    UI.user_error!("simulator-slots granted no slot (exit #{$?&.exitstatus})")
  end
  granted, run_id = line.split
  UI.message("simulator-slots: #{label}: granted #{granted} of #{want} wanted (run #{run_id})")
  rc = 1
  begin
    result = yield(granted.to_i)
    rc = 0
    result
  ensure
    system("python3", tool, "result", "--run", run_id, "--rc", rc.to_s)
    begin
      Process.kill("TERM", holder.pid)
    rescue Errno::ESRCH
      nil
    end
    holder.close
  end
end

# App Store metadata is a release-time concern (not a per-PR one — see
# ci.yml's header comment), so its completeness/limits gate and the
# source-voice check run here, right before the actual metadata upload,
# rather than on every PR.
def verify_metadata_ready!
  sh("python3 ../scripts/translate_metadata/check_metadata.py")
  # Advisory (brand voice): warns, doesn't block the lane.
  sh("python3 ../scripts/translate_metadata/check_source_voice.py") do |status, _result|
    UI.important("check_source_voice: possible voice issue(s) in the en-US source — review the log above.") unless status.success?
  end
end

# Screenshot demo content is also checked at release time, right before capture
# (a malformed/missing locale entry changes what gets captured).
def verify_content_ready!
  sh("python3 ../scripts/screenshot_content/check_content.py")
end

platform :ios do
  # Authenticates every lane with the App Store Connect API key (fastlane/.env: ASC_API_*).
  before_all do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_API_KEY_ID"),
      issuer_id: ENV.fetch("ASC_API_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_API_KEY_FILEPATH"),
      duration: 1200,
      in_house: false
    )
  end

  # ---------------------------------------------------------------------------
  # UTILITY: read-only TestFlight query proving the API key / issuer / .p8 authenticate.
  # ---------------------------------------------------------------------------
  desc "Verify App Store Connect API auth (read-only, builds nothing)"
  lane :verify_auth do
    build_number = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    UI.success("Auth OK. Latest TestFlight build number: #{build_number}")
  end

  # ---------------------------------------------------------------------------
  # LIVE: build + ship a build to TestFlight.
  # ---------------------------------------------------------------------------
  desc "Build and upload a build to TestFlight"
  lane :beta do
    verify_ship_secrets!
    build_number = next_build_number
    UI.message("Auto-incrementing build number to #{build_number} (TestFlight latest + 1)")
    # Write the number into project.pbxproj so the archive and later local Debug
    # builds carry it. -allowProvisioningUpdates lets Xcode create/refresh the
    # distribution cert + app-store profile.
    set_project_build_number(build_number)
    build_app(
      scheme: SCHEME,
      output_directory: OUTPUT_DIR,
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
    # Commit only after a successful upload so the repo records shipped builds only.
    # Scoped to the pbxproj; does not push.
    git_commit(
      path: "simple-recurring-budgets.xcodeproj/project.pbxproj",
      message: "chore(release): set build number to #{build_number}"
    )
    UI.success("Committed build #{build_number} to project.pbxproj. Push when ready.")
  end

  # ---------------------------------------------------------------------------
  # DORMANT: full App Store release. Screenshots and metadata are skipped; flip the
  # skip_* flags to false once metadata/ and screenshots/ are populated and translated.
  # The standard release flow submits the `beta`-lane TestFlight build instead (see
  # docs/app-store-release-checklist.md Phase 4).
  # ---------------------------------------------------------------------------
  desc "Build and submit a release to the App Store (metadata/screenshots skipped for now)"
  lane :release do
    verify_ship_secrets!
    # This lane never uploads screenshots (`fastlane screenshots` + `push_screenshots`
    # do); it only prompts the operator to decide first. Agents have no TTY for
    # UI.confirm: after confirming with the operator that screenshots are current,
    # set RELEASE_SCREENSHOTS_HANDLED=1 to skip the prompt.
    if ENV["RELEASE_SCREENSHOTS_HANDLED"] == "1"
      UI.message("RELEASE_SCREENSHOTS_HANDLED=1 — screenshots decision made upstream; skipping prompt.")
    elsif UI.confirm("Do you need to upload fresh App Store screenshots for this release?")
      UI.user_error!(
        "Stopping so you can handle screenshots first: run `fastlane screenshots` " \
        "(then inspect) and `fastlane push_screenshots`, then re-run `fastlane release`. " \
        "(This lane never uploads screenshots.)"
      )
    end

    build_number = next_build_number
    UI.message("Auto-incrementing build number to #{build_number} (TestFlight latest + 1)")
    # See `beta`: persist the number into project.pbxproj, then archive.
    set_project_build_number(build_number)
    build_app(
      scheme: SCHEME,
      output_directory: OUTPUT_DIR,
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )
    upload_to_app_store(
      skip_screenshots: true,   # TODO: set false when screenshots/ is populated
      skip_metadata: true,      # TODO: set false when metadata/ is translated
      precheck_include_in_app_purchases: false,
      force: true,              # skip the interactive HTML preview confirmation
      submit_for_review: false  # upload only; you press submit in ASC
    )
    # Commit after a successful upload (scoped to pbxproj; no push).
    git_commit(
      path: "simple-recurring-budgets.xcodeproj/project.pbxproj",
      message: "chore(release): set build number to #{build_number}"
    )
    UI.success("Committed build #{build_number} to project.pbxproj. Push when ready.")
  end

  # ---------------------------------------------------------------------------
  # DORMANT: push only localized metadata (no binary), once metadata/<locale>/*.txt
  # is filled in by the translation pipeline.
  # ---------------------------------------------------------------------------
  desc "Upload localized App Store metadata only (no binary, no screenshots)"
  lane :push_metadata do |options|
    requested = options[:app_version].to_s
    UI.user_error!("Pass app_version:<version> explicitly") if requested.strip.empty?
    verify_metadata_ready!
    # Stages a validated copy (English fallback per field, no empty files) for deliver to read.
    sh("python3", File.join(RELEASE_ROOT, "scripts/appstore_metadata.py"), "prepare", "--output", File.join(RELEASE_ROOT, "tmp/appstore-metadata"))
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("No access to #{APP_IDENTIFIER}") unless app && app.bundle_id == APP_IDENTIFIER
    version = app.get_edit_app_store_version(platform: "IOS")
    MetadataPublish.validate_target!(version, requested)
    upload_to_app_store(MetadataPublish.options(APP_IDENTIFIER, requested, File.join(RELEASE_ROOT, "tmp/appstore-metadata")))
  end

  # ---------------------------------------------------------------------------
  # Capture localized screenshots across the device/locale matrix, then rename the
  # runtime-coded folders (de, nb, ar, ...) to App Store storefront codes (de-DE, no,
  # ar-SA, ...) so `deliver` finds them. Config: fastlane/Snapfile; capture is driven
  # by the AppStoreScreenshots UI test.
  #
  # Simulator only, not App Store Connect; inspect fastlane/screenshots/ before
  # `push_screenshots`. Bare device screenshots (no frameit/captions).
  # ---------------------------------------------------------------------------
  desc "Capture localized screenshots in the Simulator, then map folders to storefront codes"
  lane :screenshots do
    verify_content_ready!
    # The Snapfile runs its two devices (iPhone, iPad) concurrently: ask the pool
    # for 2 and run them one at a time if only 1 is granted. Builds run inside the
    # hold, since snapshot builds and tests in one step.
    with_simulator_slots(2, "screenshots") do |granted|
      if granted && granted < 2
        capture_screenshots(concurrent_simulators: false)
      else
        capture_screenshots
      end
    end
    UI.message("Renaming captured folders from runtime codes to App Store storefront codes…")
    sh("python3", "../scripts/screenshot_content/rename_for_deliver.py")
  end

  # ---------------------------------------------------------------------------
  # Upload ONLY localized screenshots. They stage into the unreleased "Prepare for
  # Submission" version; nothing goes live until you submit in App Store Connect.
  # Run after inspecting `fastlane/screenshots/`.
  # ---------------------------------------------------------------------------
  desc "Upload localized App Store screenshots only (no binary, no metadata)"
  lane :push_screenshots do
    upload_to_app_store(
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,                          # skip the interactive HTML preview confirmation
      run_precheck_before_submit: false,    # we're not submitting; precheck can't check IAPs via API key
      submit_for_review: false              # upload only; you press submit in ASC
    )
  end

  # ---------------------------------------------------------------------------
  # Upload ONLY the screenshots under $SUBSET_PATH (default: full tree). Used by
  # scripts/screenshot_content/upload_with_retry.sh to re-upload storefronts that
  # failed a full run. deliver only touches languages present in the path, so a pruned
  # directory overwrites just those storefronts.
  # ---------------------------------------------------------------------------
  desc "Upload only the screenshots under $SUBSET_PATH (subset retry)"
  lane :push_screenshots_subset do
    upload_to_app_store(
      screenshots_path: ENV.fetch("SUBSET_PATH", "./fastlane/screenshots"),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false
    )
  end
end
