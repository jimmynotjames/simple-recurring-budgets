# Config for `fastlane snapshot` (the `screenshots` lane).
#
# Captured by the AppStoreScreenshots UI test (5-shot marketing story), seeded per
# locale from ScreenshotSeeds/<lang>.json (generated by scripts/screenshot_content/).
# The lane then renames runtime-coded folders to App Store storefront codes
# (scripts/screenshot_content/rename_for_deliver.py). See fastlane/SETUP.md.
#
# IMPORTANT: `languages` are the app's RUNTIME locale codes (what the Simulator
# launches with; the set in scripts/translate_catalog/locales.py plus en-US), NOT
# the App Store Connect storefront codes used for metadata/<locale>/ folders
# (runtime `de` vs. storefront `de-DE`, `nb` vs. `no`).

# The two App-Store-required sizes: 6.9" iPhone (Apple scales it down to smaller
# iPhones) and 13" iPad (Wren ships on iPad). Names must match `xcrun simctl list devicetypes`.
devices([
  "iPhone 17 Pro Max",
  "iPad Pro 13-inch (M5)"
])

# App runtime locales (49 from locales.py) + the development language.
languages([
  "en-US",
  "ar",
  "ca",
  "cs",
  "da",
  "de",
  "el",
  "en-AU",
  "en-CA",
  "en-GB",
  "es",
  "es-MX",
  "fi",
  "fr",
  "fr-CA",
  "he",
  "hi",
  "hr",
  "hu",
  "id",
  "it",
  "ja",
  "ko",
  "ms",
  "nb",
  "nl",
  "pl",
  "pt-BR",
  "pt-PT",
  "ro",
  "ru",
  "sk",
  "sv",
  "th",
  "tr",
  "uk",
  "vi",
  "zh-Hans",
  "zh-Hant",
  # Runtime codes of the 11 expansion locales.
  "bn",
  "gu",
  "kn",
  "ml",
  "mr",
  "or",
  "pa",
  "sl",
  "ta",
  "te",
  "ur"
])

scheme("simple-recurring-budgets")

# Only the marketing screenshot test, not the accessibility capture or journey/audit suites.
only_testing(["simple-recurring-budgetsUITests/AppStoreScreenshots"])

output_directory("./fastlane/screenshots")

# Wipe prior screenshots so stale locales/devices don't linger.
clear_previous_screenshots(true)

# Clean status bar (9:41, full battery/signal) for marketing shots.
override_status_bar(true)

# Localize the Simulator UI chrome to the captured language.
localize_simulator(true)

concurrent_simulators(true)
# A failed locale must not abort the 50-locale run.
stop_after_first_error(false)
