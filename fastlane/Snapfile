# Snapfile — configuration for `fastlane snapshot` (the `screenshots` lane).
#
# Captured by the AppStoreScreenshots UI test (5-shot marketing story). The app is
# seeded per-locale from the ScreenshotSeeds/<lang>.json catalog generated by
# scripts/screenshot_content/ (skill: /appstore:screenshot-content). After capture,
# the `screenshots` lane renames the runtime-coded folders to App Store storefront
# codes (scripts/screenshot_content/rename_for_deliver.py). See fastlane/SETUP.md.
#
# IMPORTANT: the `languages` below are the app's RUNTIME locale codes (the ones
# the Simulator is launched with — they must match the locales the app actually
# localizes, i.e. the set in scripts/translate_catalog/locales.py plus en-US).
# These are NOT the same as App Store Connect storefront codes used for the
# metadata/<locale>/ folders (e.g. runtime `de` vs. storefront `de-DE`,
# runtime `nb` vs. storefront `no`). Keep the two straight.

# Devices to capture: the two App-Store-required sizes — a 6.9" iPhone and the 13"
# iPad (required because Wren ships on iPad). Apple scales the 6.9" set down to
# smaller iPhones. Names must match `xcrun simctl list devicetypes`.
devices([
  "iPhone 17 Pro Max",
  "iPad Pro 13-inch (M5)"
])

# App runtime locales (37 from locales.py) + the primary development language.
languages([
  "en-US",
  "ar",
  "ca",
  "cs",
  "da",
  "de",
  "el",
  "en-AU",
  "en-CA",
  "en-GB",
  "es",
  "es-MX",
  "fi",
  "fr",
  "fr-CA",
  "he",
  "hi",
  "hr",
  "hu",
  "id",
  "it",
  "ja",
  "ko",
  "ms",
  "nb",
  "nl",
  "pl",
  "pt-BR",
  "pt-PT",
  "ro",
  "ru",
  "sk",
  "sv",
  "th",
  "tr",
  "uk",
  "vi",
  "zh-Hans",
  "zh-Hant",
  # 11 locales added 2026-03-31 (App Store expansion); runtime codes.
  "bn",
  "gu",
  "kn",
  "ml",
  "mr",
  "or",
  "pa",
  "sl",
  "ta",
  "te",
  "ur"
])

scheme("simple-recurring-budgets")

# Capture ONLY the marketing screenshot test — not the accessibility capture or the
# journey/audit suite. This is what keeps `fastlane screenshots` scoped.
only_testing(["simple-recurring-budgetsUITests/AppStoreScreenshots"])

output_directory("./fastlane/screenshots")

# Wipe prior screenshots before a fresh run so stale locales/devices don't linger.
clear_previous_screenshots(true)

# Clean status bar (9:41, full battery/signal, no carrier clutter) for marketing shots.
override_status_bar(true)

# Localize the Simulator UI chrome to match the captured language.
localize_simulator(true)

concurrent_simulators(true)
# Don't abort the whole 38-locale run on the first failed locale; capture the rest.
stop_after_first_error(false)
