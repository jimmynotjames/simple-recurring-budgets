    "addEditBudget.note.specificDates": {
      "comment": "Caption shown below the Specific Dates period chip explaining that this budget type is non-recurring with no carry-over",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مناسب للرحلات أو عطل أعياد الميلاد أو أي نافذة إنفاق لمرة واحدة. حين تنتهي، تنتهي. لا تكرار، ولا Carry-Over."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal per a un viatge, un cap de setmana de festa o qualsevol altra finestra de despesa única. Quan és acabat, és acabat. Sense repetició, sense Carry-Over."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodí se na výlet, narozeninový víkend nebo jakékoli jednorázové výdaje. Až skončí, skončí. Bez opakování, bez Carry-Over."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Velegnet til en rejse, en fødselsdagweekend eller et engangsforbrug. Når det er slut, er det slut. Ingen gentagelse, ingen carry-over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal für eine Reise, ein Wochenende oder ein einmaliges Zeitfenster. Wenn es vorbei ist, ist es vorbei. Kein Wiederholen, kein Carry-Over."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ιδανικό για ένα ταξίδι, ένα απόγευμα γενεθλίων ή οποιοδήποτε μοναδικό παράθυρο δαπανών. Όταν τελειώσει, τελειώνει. Χωρίς επανάληψη, χωρίς Carry-Over."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good for a trip, a birthday weekend, or any one-off spending window. When it's done, it's done. No repeating, no carry-over."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Good for a trip, a birthday weekend, or any one-off spending window. When it's done, it's done. No repeating, no carry-over."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Good for a trip, a birthday weekend, or any one-off spending window. When it's done, it's done. No repeating, no carry-over."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Good for a trip, a birthday weekend, or any one-off spending window. When it's done, it's done. No repeating, no carry-over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para un viaje, un fin de semana de cumpleaños o cualquier período de gasto puntual. Cuando termina, termina. Sin repetición ni Carry-Over."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para un viaje, un fin de semana de cumpleaños o cualquier período de gasto único. Cuando termine, termina. Sin repetición, sin Carry-Over."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopii matkalle, syntymäpäiväviikonlopulle tai mihin tahansa kertaluonteiseen kulutusjaksolle. Kun se on ohi, se on ohi. Ei toistoa, ei Carry-Overia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idéal pour un voyage, un week-end d'anniversaire, ou toute période de dépenses unique. Une fois terminé, c'est fini. Pas de répétition, pas de Carry-Over."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Idéal pour un voyage, une fin de semaine spéciale ou tout autre événement ponctuel. Une fois terminé, c'est fini. Aucune répétition, aucun cumul."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מושלם לטיול, סוף שבוע יום הולדת או חלון הוצאה חד-פעמי. כשזה נגמר, זה נגמר. ללא חזרה, ללא Carry-Over."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यात्रा, जन्मदिन के वीकेंड, या किसी एक बार के खर्च के लिए उपयुक्त। एक बार खत्म हो गया, तो खत्म। कोई दोहराव नहीं, कोई Carry-Over नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikladno za putovanje, vikend za rođendan ili bilo koji jednokratni period potrošnje. Kad završi, završi. Bez ponavljanja, bez Carry-Over."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jó egy utazáshoz, születésnapi hétvégéhez vagy bármilyen egyszeri kiadáshoz. Ha véget ért, véget ért. Nem ismétlődik, nincs Carry-Over."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocok untuk perjalanan, akhir pekan ulang tahun, atau pengeluaran sekali pakai. Selesai ya sudah. Tidak berulang, tidak ada carry-over."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfetto per un viaggio, un weekend di compleanno o una finestra di spesa occasionale. Quando finisce, finisce. Nessuna ripetizione, nessun Carry-Over."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行、誕生日のお祝い、またはその他の一回限りの支出期間に最適です。終わったら終了です。繰り返しなし、Carry-Overなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행, 생일 주말 등 일회성 지출 기간에 적합합니다. 기간이 끝나면 종료됩니다. 반복이나 Carry-Over는 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuai untuk percutian, hujung minggu istimewa, atau sebarang perbelanjaan satu kali. Apabila selesai, ia selesai. Tiada ulangan, tiada Carry-Over."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer for en tur, en bursdagshelg eller et annet engangstidsrom. Når det er over, er det over. Ingen gjentagelse, ingen Carry-Over."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handig voor een tripje, een verjaardagsweekend of elk eenmalig uitgavenvenster. Wanneer het voorbij is, is het voorbij. Geen herhaling, geen Carry-Over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Idealne dla podróży, weekendu urodzinowego lub jednorazowego okresu wydatków. Gdy się skończy, jest koniec. Bez powtarzania, bez Carry-Over."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para uma viagem, um fim de semana de aniversário ou qualquer janela de gastos única. Quando termina, termina. Sem repetição e sem Carry-Over."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para uma viagem, um fim de semana de aniversário ou qualquer janela de gastos pontual. Quando termina, termina. Sem repetição, sem Carry-Over."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal pentru o călătorie, un weekend sau orice cheltuială punctuală. Când se termină, gata. Fără repetare, fără Carry-Over."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходит для путешествия, дня рождения или любого одноразового периода трат. Когда закончится, всё. Без повторений, без Carry-Over."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideálne pre výlet, víkend narodenín alebo akékoľvek jednorazové výdavky. Keď je to hotové, je to hotové. Bez opakovania, bez Carry-Over."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bra för en resa, en födelsedag eller något engångsevent. När det är klart, är det klart. Ingen upprepning, ingen Carry-Over."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหมาะสำหรับทริป วันเกิด หรือช่วงใช้จ่ายครั้งเดียว เมื่อสิ้นสุดแล้วก็จบ ไม่มีการวนซ้ำหรือ Carry-Over"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir seyahat, bir doğum günü hafta sonu veya herhangi bir tek seferlik harcama penceresi için uygundur. Bittiyse, bitti. Tekrarlanan yok, Carry-Over yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підходить для поїздки, святкового вікенду або будь-якого разового вікна витрат. Коли все завершено — завершено. Без повторень і без Carry-Over."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phù hợp cho chuyến đi, một dịp cuối tuần, hoặc bất kỳ khoảng chi tiêu nào chỉ xảy ra một lần. Kết thúc là xong. Không lặp lại, không Carry-Over."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合出行、生日周末或任何一次性支出时段。完成就完成了。不重复，无Carry-Over。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適合旅行、生日週末或任何一次性開支期間。完成後就結束了。不重複，不結轉。"
          }
        }
      }
    },
