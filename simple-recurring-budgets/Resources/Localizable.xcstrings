        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירה באפליקציה נכשלה שוב ושוב. הקשר אבחון (ללא נתונים אישיים):"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में एक सेव बार-बार विफल हुआ। डायग्नोस्टिक संदर्भ (कोई व्यक्तिगत डेटा नहीं):"
