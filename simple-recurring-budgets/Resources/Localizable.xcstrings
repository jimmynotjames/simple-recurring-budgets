    "settings.weekStart.alert.message": {
      "comment": "Alert body for the week-start day change; argument is the name of the newly selected weekday",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤثر التغيير إلى %@ فوراً على جميع الميزانيات الأسبوعية وميزانيات كل أسبوعين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El canvi a %@ afectarà immediatament tots els pressupostos setmanals i quinzenals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna na %@ okamžitě ovlivní všechny týdenní a dvoutýdenní rozpočty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift til %@ påvirker straks alle ugentlige og 14-dages budgetter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umstellung auf %@ betrifft sofort alle wöchentlichen und zweiwöchentlichen Budgets."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή σε %@ θα επηρεάσει άμεσα όλους τους εβδομαδιαίους και δεκαπενθήμερους προϋπολογισμούς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing to %@ will immediately affect all weekly and biweekly budgets."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing to %@ will immediately affect all weekly and fortnightly budgets."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing to %@ will immediately affect all weekly and biweekly budgets."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing to %@ will immediately affect all weekly and fortnightly budgets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar a %@ afectará inmediatamente a todos los presupuestos semanales y quincenales."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar a %@ afectará inmediatamente todos los presupuestos semanales y quincenales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuttaminen arvoon %@ vaikuttaa välittömästi kaikkiin viikoittaisiin ja kahden viikon budjetteihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer à %@ affectera immédiatement tous les budgets hebdomadaires et bihebdomadaires."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer à %@ affectera immédiatement tous les budgets hebdomadaires et bihebdomadaires."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעבר ל%@ ישפיע מיד על כל התקציבים השבועיים והדו-שבועיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में बदलने से सभी साप्ताहिक और द्विसाप्ताहिक बजट तुरंत प्रभावित होंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjena na %@ odmah će utjecati na sve tjedne i dvotjedne proračune."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ napra váltás azonnal hatással lesz az összes heti és kéthetes büdzsére."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah ke %@ akan langsung memengaruhi semua anggaran mingguan dan dua mingguan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il passaggio a %@ avrà effetto immediato su tutti i budget settimanali e bisettimanali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に変更すると、すべての週次・隔週予算にすぐに影響します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 변경하면 모든 주간 및 격주 예산에 즉시 영향을 줘요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukar kepada %@ akan segera mempengaruhi semua belanjawan mingguan dan dua mingguan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endring til %@ vil umiddelbart påvirke alle ukentlige og annenhverukentlige budsjetter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overschakelen naar %@ heeft direct invloed op alle wekelijkse en tweewekelijkse budgetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana na %@ natychmiast wpłynie na wszystkie budżety tygodniowe i dwutygodniowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar para %@ afetará imediatamente todos os orçamentos semanais e quinzenais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar para %@ irá afetar imediatamente todos os orçamentos semanais e quinzenais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbarea la %@ va afecta imediat toate bugetele săptămânale și bilunare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переход на %@ немедленно повлияет на все еженедельные и двухнедельные бюджеты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmena na %@ okamžite ovplyvní všetky týždenné a dvojtýždenné rozpočty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att byta till %@ påverkar omedelbart alla vecko- och tvåveckorsbudgetar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนเป็น %@ จะส่งผลต่องบประมาณรายสัปดาห์และรายสองสัปดาห์ทั้งหมดทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ olarak değiştirmek tüm haftalık ve iki haftada bir bütçeleri hemen etkiler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна на %@ одразу вплине на всі тижневі та двотижневі бюджети."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi sang %@ sẽ ảnh hưởng ngay đến tất cả ngân sách hàng tuần và hai tuần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改为%@将立即影响所有每周和每两周预算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更為 %@ 將立即影響所有每週和雙週預算。"
          }
        }
      }
    },
