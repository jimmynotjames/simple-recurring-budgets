    "settings.analytics.toggle.accessibilityHint": {
      "comment": "VoiceOver hint for the analytics opt-in toggle in Settings",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح للتطبيق بإرسال بيانات استخدام مجهولة للمساعدة في تحسينه. لا تُضمَّن أي تفاصيل مصروفات أو معرّفات iCloud أو معلومات شخصية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপকে বেনামী ব্যবহারের ডেটা পাঠাতে অনুমতি দেয় অ্যাপ উন্নত করতে। কোনো খরচ বিবরণ, iCloud শনাক্তকারী বা ব্যক্তিগত তথ্য কখনও অন্তর্ভুক্ত করা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que l'app enviï dades d'ús anònimes per ajudar a millorar-la. Mai s'inclouen detalls de despeses, identificadors d'iCloud ni informació personal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje aplikaci odesílat anonymní data o využití pro zlepšení aplikace. Nikdy nejsou zahrnuty podrobnosti o výdajích, identifikátory iCloud ani osobní informace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillader appen at sende anonyme brugsdata for at hjælpe med at forbedre appen. Udgiftsoplysninger, iCloud-identifikatorer eller personlige oplysninger medtages aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht der App das Senden anonymer Nutzungsdaten zur App-Verbesserung. Ausgabendetails, iCloud-Kennungen oder persönliche Informationen werden nie übertragen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέπει στην εφαρμογή να αποστέλλει ανώνυμα δεδομένα χρήσης για τη βελτίωσή της. Δεν συμπεριλαμβάνονται ποτέ λεπτομέρειες εξόδων, αναγνωριστικά iCloud ή προσωπικές πληροφορίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows the app to send anonymous usage data to help improve the app. No expense details, iCloud identifiers, or personal information are ever included."
          }
        },
        "en-AU": {
