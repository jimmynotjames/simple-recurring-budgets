    "settings.iCloud.paused.accessibilityLabel": {
      "comment": "VoiceOver label for the iCloud paused status row; shown when signed in but the SwiftData container is local-only",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة iCloud متوقفة مؤقتاً. ميزانياتك محفوظة على هذا الجهاز فقط ولا تتزامن مع الأجهزة الأخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronització amb iCloud està pausada. Els pressupostos estan desats en aquest dispositiu, però no se sincronitzen amb altres dispositius."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizace iCloud je pozastavena. Vaše rozpočty jsou uloženy v tomto zařízení, ale nesynchronizují se s ostatními zařízeními."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synkronisering er sat på pause. Dine budgetter er gemt på denne enhed, men synkroniseres ikke til andre enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Synchronisierung ist pausiert. Deine Budgets werden auf diesem Gerät gespeichert, aber nicht mit anderen Geräten synchronisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο συγχρονισμός iCloud είναι σε παύση. Οι προϋπολογισμοί σας αποθηκεύονται σε αυτήν τη συσκευή αλλά δεν συγχρονίζονται με άλλες συσκευές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is paused. Your budgets are saved on this device but not syncing to other devices."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is paused. Your budgets are saved on this device but not syncing to other devices."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is paused. Your budgets are saved on this device but not syncing to other devices."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is paused. Your budgets are saved on this device but not syncing to other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud está en pausa. Tus presupuestos están guardados en este dispositivo pero no se sincronizan con otros dispositivos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización de iCloud está en pausa. Tus presupuestos están guardados en este dispositivo pero no se están sincronizando con otros dispositivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synkronointi on keskeytetty. Budjettisi on tallennettu tälle laitteelle, mutta niitä ei synkronoida muihin laitteisiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud est en pause. Tes budgets sont enregistrés sur cet appareil mais ne se synchronisent pas avec les autres."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud est en pause. Tes budgets sont sauvegardés sur cet appareil, mais ne se synchronisent pas avec les autres appareils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סנכרון iCloud מושהה. התקציבים שמורים במכשיר זה אך אינם מסתנכרנים עם מכשירים אחרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud सिंक रुका हुआ है। आपके बजट इस डिवाइस पर सहेजे गए हैं लेकिन अन्य डिवाइस से सिंक नहीं हो रहे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sinkronizacija je pauzirana. Vaši proračuni su spremljeni na ovom uređaju, ali se ne sinkroniziraju s drugim uređajima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud szinkronizálás szünetel. A költségkeretek ezen az eszközön vannak mentve, de nem szinkronizálnak más eszközökre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronisasi iCloud dijeda. Anggaran kamu tersimpan di perangkat ini tapi tidak tersinkron ke perangkat lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione iCloud è in pausa. I tuoi budget sono salvati su questo dispositivo ma non vengono sincronizzati con altri dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud同期は一時停止中です。予算はこのデバイスに保存されていますが、他のデバイスと同期していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화가 일시 중지되었어요. 예산이 이 기기에 저장되어 있지만 다른 기기와 동기화되지 않아요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyegerakan iCloud dijeda. Belanjawan anda disimpan pada peranti ini tetapi tidak disegerakkan ke peranti lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synkronisering er pauset. Budsjettene dine er lagret på denne enheten, men synkroniseres ikke til andre enheter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-sync is onderbroken. Je budgetten worden opgeslagen op dit apparaat maar synchroniseren niet met andere apparaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja iCloud jest wstrzymana. Budżety są zapisane na tym urządzeniu, ale nie są synchronizowane z innymi urządzeniami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização com iCloud está pausada. Seus orçamentos estão salvos neste dispositivo, mas não estão sendo sincronizados com outros dispositivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização do iCloud está em pausa. Os teus orçamentos estão guardados neste dispositivo, mas não estão a sincronizar com outros dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizarea iCloud este în pauză. Bugetele sunt salvate pe acest dispozitiv, dar nu se sincronizează cu celelalte dispozitive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация iCloud приостановлена. Ваши бюджеты сохранены на этом устройстве, но не синхронизируются с другими."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizácia iCloud je pozastavená. Vaše rozpočty sú uložené na tomto zariadení, ale nesynchronizujú sa s inými zariadeniami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synk är pausad. Dina budgetar är sparade på den här enheten men synkroniseras inte till andra enheter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ซิงค์หยุดชั่วคราว งบประมาณของคุณบันทึกในอุปกรณ์นี้แต่ไม่ซิงค์กับอุปกรณ์อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud eşlemesi duraklatıldı. Bütçelerin bu cihaza kaydedildi ama diğer cihazlarla eşlenmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync призупинено. Ваші бюджети збережені на цьому пристрої, але не синхронізуються з іншими пристроями."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync đã tạm dừng. Ngân sách của bạn được lưu trên thiết bị này nhưng không đồng bộ sang thiết bị khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步已暂停。您的预算已保存在此设备上，但未同步到其他设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步已暫停，您的預算已儲存在此裝置，但未同步至其他裝置。"
          }
        }
      }
    },
    "settings.iCloud.paused.footer": {
      "comment": "Section footer shown below the iCloud status row when the app is signed in to iCloud but the SwiftData container is running in local-only mode",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميزانياتك محفوظة على هذا الجهاز فقط. أعد تشغيل التطبيق لإعادة محاولة مزامنة iCloud."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els pressupostos estan desats només en aquest dispositiu. Reinicia l'app per tornar a intentar la sincronització amb iCloud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše rozpočty jsou uloženy pouze v tomto zařízení. Pro opakování synchronizace iCloud restartujte aplikaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine budgetter er kun gemt på denne enhed. Genstart appen for at forsøge iCloud-synkronisering igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Budgets werden nur auf diesem Gerät gespeichert. Starte die App neu, um die iCloud-Synchronisierung erneut zu versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προϋπολογισμοί σας αποθηκεύονται μόνο σε αυτήν τη συσκευή. Επανεκκινήστε την εφαρμογή για να επαναλάβετε τον συγχρονισμό iCloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your budgets are saved on this device only. Restart the app to retry iCloud sync."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your budgets are saved on this device only. Restart the app to retry iCloud sync."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Your budgets are saved on this device only. Restart the app to retry iCloud sync."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your budgets are saved on this device only. Restart the app to retry iCloud sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus presupuestos están guardados solo en este dispositivo. Reinicia la app para reintentar la sincronización con iCloud."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus presupuestos están guardados solo en este dispositivo. Reinicia la app para volver a intentar la sincronización de iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Budjettisi on tallennettu vain tälle laitteelle. Käynnistä sovellus uudelleen kokeillaksesi iCloud-synkronointia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes budgets sont enregistrés sur cet appareil uniquement. Relance l'app pour réessayer la synchronisation iCloud."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes budgets sont sauvegardés sur cet appareil seulement. Redémarre l'appli pour réessayer la synchro iCloud."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקציבים שלך שמורים במכשיר זה בלבד. הפעל מחדש את האפליקציה לניסיון חוזר של סנכרון iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बजट केवल इस डिवाइस पर सहेजे गए हैं। iCloud सिंक फिर से आज़माने के लिए ऐप को पुनः आरंभ करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši proračuni su spremljeni samo na ovom uređaju. Ponovno pokrenite aplikaciju za ponovni pokušaj iCloud sinkronizacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A költségvetéseid csak ezen az eszközön vannak mentve. Az iCloud-szinkronizálás újraindításához indítsd újra az appot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggaran kamu hanya tersimpan di perangkat ini. Mulai ulang aplikasi untuk mencoba sinkronisasi iCloud lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi budget sono salvati solo su questo dispositivo. Riavvia l'app per riprovare la sincronizzazione iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予算はこのデバイスのみに保存されています。iCloud同期を再試行するにはアプリを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예산이 이 기기에만 저장되어 있어요. 앱을 재시작하면 iCloud 동기화를 다시 시도해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belanjawan anda disimpan pada peranti ini sahaja. Mulakan semula aplikasi untuk mencuba semula penyegerakan iCloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Budsjettene dine er bare lagret på denne enheten. Start appen på nytt for å prøve iCloud-synkronisering igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je budgetten worden alleen opgeslagen op dit apparaat. Start de app opnieuw om iCloud-sync te hervatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budżety są zapisane tylko na tym urządzeniu. Uruchom ponownie aplikację, aby spróbować zsynchronizować z iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus orçamentos estão salvos apenas neste dispositivo. Reinicie o aplicativo para tentar sincronizar com o iCloud novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus orçamentos estão guardados apenas neste dispositivo. Reinicia a app para tentar sincronizar com o iCloud."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugetele sunt salvate doar pe acest dispozitiv. Repornește aplicația pentru a reîncerca sincronizarea iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бюджеты сохранены только на этом устройстве. Перезапусти приложение, чтобы повторить синхронизацию с iCloud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše rozpočty sú uložené iba na tomto zariadení. Reštartujte aplikáciu a skúste synchronizáciu iCloud znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina budgetar är sparade enbart på den här enheten. Starta om appen för att försöka synkronisera med iCloud igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งบประมาณของคุณบันทึกในอุปกรณ์นี้เท่านั้น รีสตาร์ทแอปเพื่อลองซิงค์ iCloud อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütçelerin yalnızca bu cihaza kaydedildi. iCloud eşlemesini yeniden denemek için uygulamayı yeniden başlat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші бюджети збережені лише на цьому пристрої. Перезапустіть застосунок, щоб повторити синхронізацію з iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngân sách của bạn chỉ được lưu trên thiết bị này. Khởi động lại ứng dụng để thử lại iCloud sync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的预算仅保存在此设备上。重启应用以重试 iCloud 同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的預算僅儲存在此裝置。請重新啟動應用程式以重試 iCloud 同步。"
          }
        }
      }
