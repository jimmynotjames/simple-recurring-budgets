          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma gravação na aplicação falhou repetidamente. Contexto de diagnóstico (sem dados pessoais):"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
