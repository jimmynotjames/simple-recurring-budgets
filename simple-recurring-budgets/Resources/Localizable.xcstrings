    "settings.iCloud.paused.accessibilityLabel": {
      "comment": "VoiceOver label for the iCloud paused status row; shown when signed in but the SwiftData container is local-only",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة iCloud متوقفة مؤقتاً. ميزانياتك محفوظة على هذا الجهاز فقط ولا تتزامن مع الأجهزة الأخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud সিঙ্ক বিরতিতে। আপনার বাজেটগুলি এই ডিভাইসে সংরক্ষিত কিন্তু অন্য ডিভাইসগুলিতে সিঙ্ক হচ্ছে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronització amb iCloud està pausada. Els pressupostos estan desats en aquest dispositiu, però no se sincronitzen amb altres dispositius."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizace iCloud je pozastavena. Vaše rozpočty jsou uloženy v tomto zařízení, ale nesynchronizují se s ostatními zařízeními."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synkronisering er sat på pause. Dine budgetter er gemt på denne enhed, men synkroniseres ikke til andre enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Synchronisierung ist pausiert. Deine Budgets werden auf diesem Gerät gespeichert, aber nicht mit anderen Geräten synchronisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο συγχρονισμός iCloud είναι σε παύση. Οι προϋπολογισμοί σας αποθηκεύονται σε αυτήν τη συσκευή αλλά δεν συγχρονίζονται με άλλες συσκευές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is paused. Your budgets are saved on this device but not syncing to other devices."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is paused. Your budgets are saved on this device but not syncing to other devices."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is paused. Your budgets are saved on this device but not syncing to other devices."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is paused. Your budgets are saved on this device but not syncing to other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud está en pausa. Tus presupuestos están guardados en este dispositivo pero no se sincronizan con otros dispositivos."
          }
        },
