    "settings.carryOver.toggle.footer" : {
      "comment" : "Explanatory footer below the default carry-over toggle in Settings",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتتبع الفائض أو العجز بمرور الوقت. الإعداد الافتراضي للميزانيات الجديدة. لا تتأثر الميزانيات الحالية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa un seguiment del superàvit o el dèficit al llarg del temps. Configuració per defecte per als pressupostos nous. Els pressupostos existents no es veuen afectats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleduje přebytek nebo schodek v průběhu času. Výchozí nastavení pro nové rozpočty. Stávající rozpočty nejsou ovlivněny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sporer over- eller underskud over tid. Standardindstilling for nye budgetter. Eksisterende budgetter påvirkes ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolgt Überschüsse oder Defizite im Zeitverlauf. Standardeinstellung für neue Budgets. Bestehende Budgets sind davon nicht betroffen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρακολουθεί πλεονάσματα ή ελλείμματα με την πάροδο του χρόνου. Προεπιλογή για νέους προϋπολογισμούς. Δεν επηρεάζει τους υπάρχοντες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tracks surplus or deficit over time. Default setting for new budgets. Existing budgets are not affected."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracks surplus or deficit over time. Default setting for new budgets. Existing budgets are not affected."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracks surplus or deficit over time. Default setting for new budgets. Existing budgets are not affected."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracks surplus or deficit over time. Default setting for new budgets. Existing budgets are not affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra el superávit o déficit a lo largo del tiempo. Ajuste predeterminado para nuevos presupuestos. Los presupuestos existentes no se ven afectados."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rastrea el superávit o déficit a lo largo del tiempo. Configuración predeterminada para nuevos presupuestos. Los presupuestos existentes no se ven afectados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraa ylijäämää tai alijäämää ajan myötä. Oletusasetus uusille budjeteille. Olemassa oleviin budjetteihin ei vaikuteta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suit l'excédent ou le déficit au fil du temps. Paramètre par défaut pour les nouveaux budgets. Les budgets existants ne sont pas affectés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suit le surplus ou le déficit au fil du temps. Paramètre par défaut pour les nouveaux budgets. Les budgets existants ne sont pas affectés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עוקב אחר עודפים או גירעונות לאורך זמן. הגדרת ברירת המחדל לתקציבים חדשים. תקציבים קיימים אינם מושפעים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समय के साथ अधिशेष या घाटे को ट्रैक करता है। नए बजट के लिए डिफ़ॉल्ट सेटिंग। मौजूदा बजट प्रभावित नहीं होते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prati višak ili deficit kroz vrijeme. Zadana postavka za nove proračune. Postojeći proračuni nisu zahvaćeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idővel nyomon követi a többletet vagy a hiányt. Az új büdzsék alapértelmezett beállítása. A meglévő büdzsékre nincs hatással."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melacak surplus atau defisit dari waktu ke waktu. Pengaturan default untuk anggaran baru. Anggaran yang sudah ada tidak terpengaruh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitora il surplus o il deficit nel tempo. Impostazione predefinita per i nuovi budget. I budget esistenti non vengono modificati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間をかけて黒字または赤字を追跡します。新規予算のデフォルト設定です。既存の予算には影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간에 따라 흑자 또는 적자를 추적해요. 새 예산의 기본 설정이에요. 기존 예산에는 영향이 없어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjejaki lebihan atau defisit dari semasa ke semasa. Tetapan lalai untuk belanjawan baharu. Belanjawan sedia ada tidak terjejas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sporer overskudd eller underskudd over tid. Standardinnstilling for nye budsjetter. Eksisterende budsjetter påvirkes ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt overschot of tekort bij over tijd. Standaardinstelling voor nieuwe budgetten. Bestaande budgetten worden niet beïnvloed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledzi nadwyżkę lub deficyt w czasie. Domyślne ustawienie dla nowych budżetów. Istniejące budżety nie są zmieniane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanha superávit ou déficit ao longo do tempo. Configuração padrão para novos orçamentos. Os orçamentos existentes não são afetados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanha excedentes ou défices ao longo do tempo. Definição predefinida para novos orçamentos. Os orçamentos existentes não são afetados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urmărește surplusul sau deficitul în timp. Setare implicită pentru bugete noi. Bugetele existente nu sunt afectate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживает профицит или дефицит со временем. Настройка по умолчанию для новых бюджетов. Существующие бюджеты не затрагиваются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleduje prebytok alebo schodok v priebehu času. Predvolené nastavenie pre nové rozpočty. Existujúce rozpočty nie sú ovplyvnené."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spårar överskott eller underskott över tid. Standardinställning för nya budgetar. Befintliga budgetar påverkas inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตามยอดเกินหรือขาดตามเวลา เป็นค่าเริ่มต้นสำหรับงบประมาณใหม่ งบประมาณที่มีอยู่ไม่ได้รับผลกระทบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaman içindeki fazlayı veya açığı takip eder. Yeni bütçeler için varsayılan ayardır. Mevcut bütçeler etkilenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відстежує надлишок або дефіцит з часом. Налаштування за замовчуванням для нових бюджетів. Наявні бюджети не змінюються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo dõi số dư dư thừa hoặc thâm hụt theo thời gian. Cài đặt mặc định cho ngân sách mới. Không ảnh hưởng đến các ngân sách hiện có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随时间追踪盈余或赤字。适用于新建预算的默认设置，不影响现有预算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追蹤隨時間累積的結餘或赤字。此為新預算的預設設定，不影響現有預算。"
          }
        }
      }
    },
