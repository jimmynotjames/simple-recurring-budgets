    "containerFailure.action.sendFeedback.accessibilityHint": {
      "comment": "VoiceOver hint for the Send Feedback button on the container-failure screen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح رسالة بريد إلكترونية تتضمن تفاصيل الخطأ بدون بيانات شخصية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ত্রুটির বিবরণ সহ একটি ইমেল খোলে, কোনো ব্যক্তিগত ডেটা নেই।"
          }
        },
        "ca": {
