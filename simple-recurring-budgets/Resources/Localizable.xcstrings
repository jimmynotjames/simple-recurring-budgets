        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดชั่วคราวตั้งแต่ %@ คุณยังสามารถเพิ่มค่าใช้จ่ายที่มีวันที่ก่อนหน้านั้นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarihinden beri duraklatıldı. Hâlâ daha öncesine tarihli giderler ekleyebilirsin."
