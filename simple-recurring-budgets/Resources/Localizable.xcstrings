    "budgetDetail.resetCarryOver.alert.message": {
      "comment": "Body of the reset carry-over alert",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم مسح رصيد المُرحَّل والبدء من جديد من صفر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উদ্বৃত্ত স্থানান্তর ব্যালেন্স সাফ হয়ে শূন্য থেকে নতুন করে শুরু হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo del romanent es buidarà i començarà de nou des de zero."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatek převodu bude vymazán a znovu začne od nuly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overførselssaldoen ryddes, og du starter forfra med nul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Übertrag wird gelöscht und beginnt frisch bei null."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Υπόλοιπο Μεταφοράς θα διαγραφεί και θα ξεκινήσει από μηδέν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The carry-over balance will be cleared and start fresh from zero."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The carry-over balance will be cleared and start fresh from zero."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The carry-over balance will be cleared and start fresh from zero."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The carry-over balance will be cleared and start fresh from zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo de remanente se vaciará y empezará de cero."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo acumulado se borrará y comenzará de nuevo desde cero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirron saldo tyhjennetään ja aloitetaan uudelleen nollasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde du report sera effacé et recommencera à zéro."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde du report sera effacé et recommencera à zéro."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આગળ વહન શેષ રાશિ સાફ કરવામાં આવશે અને શૂન્યથી નવું શરૂ થશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יתרת היתרה המועברת תתנוקה ותתחיל טרי מאפס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैरी-ओवर शेष साफ़ कर दिया जाएगा और शून्य से नई शुरुआत होगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanje prijenosa će biti očišćeno i počet će ispočetka od nule."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az átvitel egyenlege törlődik, és nulláról kezd újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo bawaan akan dihapus dan dimulai segar dari nol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo del riporto verrà cancellato e ricomincia da zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り越し残高がクリアされ、ゼロから新しく始まります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂದಕ್ಕೆ ಸಾಗಿಸುವಿಕೆ ಶಿಲ್ಕು ತೆರವುಗೊಳಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಶೂನ್ಯದಿಂದ ಸಂಪೂರ್ಣ ವೃದ್ಧಿಯಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이월 잔액이 비워지고 0부터 새로 시작합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാരി-ഓവർ ബാലൻസ് മായ്ക്കാനും പൂജ്യത്തിൽ നിന്ന് ശുദ്ധമായി ആരംഭിക്കാനും ആണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुढे नेलेली शिल्लक साफ केली जाईल आणि शून्यापासून नव्याने सुरू होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baki bawa ke hadapan akan dipadamkan dan dimulai semula daripada sifar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Overføringssaldoen tømmes og starter på nytt fra null."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het overdrachtsaldo wordt gewist en start schoon op nul."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଗକୁ ନିଆ ବାକି ଶେଷ ସଫା ହେବ ଏବଂ ଶୂନ୍ୟ ଠାରୁ ନୂଆ ଆରମ୍ଭ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੱਗੇ ਲਿਜਾਣਾ ਬਕਾਇਆ ਸਾਫ਼ ਕੀਤਾ ਜਾਵੇਗਾ ਅਤੇ ਸਿਫ਼ਰ ਤੋਂ ਨਵਾਂ ਸ਼ੁਰੂ ਹੋਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo przeniesienia zostanie wyczyszczone i rozpocznie się od nowa od zera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo acumulado será limpo e recomeçará do zero."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo de transição será limpo e recomeçará do zero."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Soldul report va fi șters și va porni din nou de la zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс переноса будет очищен и начнётся заново с нуля."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stav prenosu bude vymazaný a začne nanovo od nuly."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanje prenosa se bo očistilo in nanovo se bo začelo od nič."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Överföringssaldot rensas och börjar om från noll."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முன்கொண்டுசெல் இருப்பு தெளிவுசெய்யப்பட்டு பூஜ்ஜியத்திலிருந்து புதிதாக தொடங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్యారీ-ఓవర్ బ్యాలెన్స్ క్లియర్ చేయబడుతుంది మరియు సున్నా నుండి తాజా ప్రారంభమవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยอดยกมาจะถูกลบและเริ่มใหม่จากศูนย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devir bakiyesi silinecek ve sıfırdan başlayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс перенесення залишку буде очищений і почне знову з нуля."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آگے منتقلی کا بیلنس صاف ہوگا اور صفر سے نیا شروع ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số dư chuyển tiếp sẽ bị xóa và bắt đầu lại từ không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结转余额将被清除并从零重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結轉結餘將被清除並重新開始。"
          }
        }
      }
    },
