          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szüneteltetve %@ óta. Még mindig hozzáadhatsz korábbi dátumú kiadásokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda sejak %@. Anda masih bisa menambahkan pengeluaran bertanggal sebelumnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa dal %@. Puoi ancora aggiungere spese datate prima di allora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から一時停止中。それ以前の日付の支出は引き続き追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 이후 일시 중지됨. 그 이전 날짜의 지출은 계속 추가할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda sejak %@. Anda masih boleh menambah perbelanjaan bertarikh sebelum itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Satt på pause siden %@. Du kan fortsatt legge til utgifter datert før det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerd sinds %@. Je kunt nog steeds uitgaven van vóór die datum toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymano od %@. Nadal możesz dodawać wydatki z wcześniejszą datą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado desde %@. Você ainda pode adicionar despesas datadas antes disso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa desde %@. Ainda podes adicionar despesas datadas antes disso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În pauză din %@. Încă poți adăuga cheltuieli datate înainte de acel moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На паузе с %@. Можно добавлять расходы до этой даты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastavené od %@. Stále môžete pridávať výdavky s dátumom pred týmto okamihom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausad sedan %@. Du kan fortfarande lägga till utgifter daterade före dess."
