        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Očisti stanje prijenosa na nulu. Troškovi se ne mijenjaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nullára állítja az átvitel egyenlegét. A kiadások nem érintettek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
