          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be changed after creating your budget."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be changed after creating your budget."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
