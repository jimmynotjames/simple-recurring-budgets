    "addEditBudget.toggle.carryOver.accessibilityHint" : {
      "comment" : "VoiceOver hint for the carry-over toggle on the Add/Edit Budget screen",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التفعيل، تُرحَّل المبالغ غير المنفقة أو الزائدة إلى الفترات اللاحقة"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan està activat, els imports no gastats o sobrepasats es traslladen als períodes següents"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je zapnuto, nevyčerpané nebo přečerpané částky se přenášejí do dalších období"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når aktiveret overføres ubrugte eller overbrugte beløb til næste periode"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden nicht ausgegebene oder überzogene Beträge periodenübergreifend übertragen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργό, τα αδαπάνητα ή υπερβάλλοντα ποσά μεταφέρονται στις επόμενες περιόδους"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When on, unspent or overspent amounts carry forward across periods"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, unspent or overspent amounts carry forward across periods"
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, unspent or overspent amounts carry forward across periods"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, unspent or overspent amounts carry forward across periods"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al activar, los importes no gastados o excedidos se trasladan entre períodos"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, los montos no gastados o en exceso se transfieren entre períodos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun käytössä, käyttämättömät tai ylitetyt summat siirtyvät jaksojen välillä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu'il est activé, les montants non dépensés ou dépassés sont reportés d'une période à l'autre"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand activé, les montants non dépensés ou dépassés sont reportés d'une période à l'autre"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמופעל, יתרות לא מנוצלות או חריגות מועברות בין תקופות"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चालू होने पर, अखर्च या अतिरिक्त राशि अगली अवधि में ले जाई जाती है"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada je uključeno, nepotrošeni ili prekoračeni iznosi prenose se na sljedeća razdoblja"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekapcsolva az el nem költött vagy túlköltött összegek átkerülnek a következő időszakba"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika aktif, saldo yang tersisa atau kelebihan pengeluaran akan dibawa ke periode berikutnya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivo, gli importi non spesi o in eccesso vengono riportati ai periodi successivi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、未使用または超過した金額が次の期間に繰り越されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 미사용 또는 초과 금액이 다음 기간으로 이월돼요"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila dihidupkan, jumlah yang tidak dibelanjakan atau dibelanjakan berlebihan dibawa ke tempoh berikutnya"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når på, overføres ubrukte eller overbrukte beløp til neste periode"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer ingeschakeld, worden niet-uitgegeven of overschreden bedragen meegenomen naar volgende periodes"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po włączeniu niewydane lub przekroczone kwoty są przenoszone na kolejne okresy"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, valores não gastos ou excedidos são transferidos entre períodos"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, os montantes não gastos ou em excesso transitam para os períodos seguintes"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este activat, sumele necheltuite sau depășite se reportează în perioadele următoare"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При включении неизрасходованные или перерасходованные суммы переносятся на следующие периоды"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je zapnuté, neutratené alebo pretratené sumy sa prenášajú do ďalších období"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När på, förs ospenderade eller överskridna belopp vidare mellan perioder"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิด ยอดที่ไม่ได้ใช้หรือใช้เกินจะยกมาในแต่ละช่วงเวลา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açıkken, harcanmayan veya aşılan tutarlar dönemler arasında devredilir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо увімкнено, невитрачені або перевитрачені суми переносяться на наступні періоди"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, các khoản dư hoặc thâm hụt sẽ được chuyển sang kỳ tiếp theo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，未花费或超支的金额将结转到下一周期"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟時，未使用或超支的金額會結轉至下一個週期"
          }
        }
      }
    },
