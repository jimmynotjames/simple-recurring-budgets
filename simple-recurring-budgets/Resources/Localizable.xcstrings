    "settings.iCloud.unavailable.accessibilityLabel": {
      "comment": "VoiceOver label for the iCloud unavailable status row",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud غير متاح. سجّل الدخول إلى iCloud من الإعدادات لمزامنة ميزانياتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud উপলব্ধ নয়। আপনার বাজেটগুলি সিঙ্ক করতে সেটিংসে iCloud এ সাইন ইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no disponible. Inicia sessió a iCloud des de Configuració per sincronitzar els pressupostos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud není dostupný. Přihlaste se do iCloud v Nastavení, abyste synchronizovali své rozpočty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ikke tilgængelig. Log ind på iCloud i Indstillinger for at synkronisere dine budgetter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud nicht verfügbar. Melde dich in den Einstellungen bei iCloud an, um deine Budgets zu synchronisieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το iCloud δεν είναι διαθέσιμο. Συνδεθείτε στο iCloud μέσω των Ρυθμίσεων για να συγχρονίσετε τους προϋπολογισμούς σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud not available. Sign in to iCloud in Settings to sync your budgets."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud not available. Sign in to iCloud in Settings to sync your budgets."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud not available. Sign in to iCloud in Settings to sync your budgets."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud not available. Sign in to iCloud in Settings to sync your budgets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no disponible. Inicia sesión en iCloud en Ajustes para sincronizar tus presupuestos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no disponible. Inicia sesión en iCloud en Configuración para sincronizar tus presupuestos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ei saatavilla. Kirjaudu iCloudiin Asetuksissa synkronoidaksesi budjettisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud non disponible. Connecte-toi à iCloud dans Réglages pour synchroniser tes budgets."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud non disponible. Connecte-toi à iCloud dans les réglages pour synchroniser tes budgets."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ઉપલબ્ધ નથી. તમારા બજેટ સમન્વય કરવા માટે સેટિંગ્સમાં iCloud માટે સાઇન ઇન કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud אינו זמין. היכנס ל-iCloud בהגדרות כדי לסנכרן את התקציבים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud उपलब्ध नहीं। अपने बजट सिंक करने के लिए Settings में iCloud में साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud nije dostupan. Prijavite se na iCloud u Postavkama za sinkronizaciju proračuna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud nem érhető el. Jelentkezz be az iCloud-ba a Beállításokban a költségvetéseid szinkronizálásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud tidak tersedia. Masuk ke iCloud di Pengaturan untuk menyinkronkan anggaran kamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud non disponibile. Accedi a iCloud nelle Impostazioni per sincronizzare i tuoi budget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudは利用できません。設定でiCloudにサインインして予算を同期してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ಲಭ್ಯವಿಲ್ಲ. ನಿಮ್ಮ ಬಜೆಟ್‌ಗಳು ಸಿಂಕ್ ಮಾಡಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ iCloud ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud를 사용할 수 없어요. 설정에서 iCloud에 로그인하면 예산을 동기화할 수 있어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ലഭ്യമല്ല. നിങ്ങളുടെ ബജറ്റുകൾ സിങ്ക് ചെയ്യാൻ ക്രമീകരണങ്ങളിൽ iCloud ലോഗിൻ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud उपलब्ध नाही. आपल्या budgets सिंक करण्यासाठी सेटिंग्जमध्ये iCloud मध्ये साइन इन करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud tidak tersedia. Log masuk ke iCloud dalam Tetapan untuk menyegerakkan belanjawan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ikke tilgjengelig. Logg på iCloud i Innstillinger for å synkronisere budsjettene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud niet beschikbaar. Log in bij iCloud via Instellingen om je budgetten te synchroniseren."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ଉପଲବ୍ଧ ନାହିଁ। iCloud ରେ ସାଇନ୍ ଇନ୍ କରନ୍ତୁ ଆପଣାର ବଜେଟ୍ ସିଙ୍ଗ୍ କରିବାକୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ਉਪਲਬਧ ਨਹੀਂ। ਤੁਸੀਂ ਦੇ ਬਜਟ ਸਿੰਕ ਕਰਨ ਲਈ ਸੈਟਿੰਗ ਵਿੱਚ iCloud ਵਿੱਚ ਦਾਖਲ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud jest niedostępny. Zaloguj się do iCloud w Ustawieniach, aby synchronizować budżety."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud indisponível. Entre no iCloud em Ajustes para sincronizar seus orçamentos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud não disponível. Inicia sessão no iCloud nas Definições para sincronizar os teus orçamentos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud indisponibil. Conectează-te la iCloud din Setări pentru a sincroniza bugetele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud недоступен. Войди в iCloud в Настройках, чтобы синхронизировать бюджеты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud nie je dostupný. Prihláste sa do iCloud v Nastaveniach, aby sa vaše rozpočty synchronizovali."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ni na voljo. Prijavi se v iCloud v Nastavitvah za sinhronizacijo svojih proračunov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ej tillgänglig. Logga in på iCloud i Inställningar för att synkronisera dina budgetar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud கிடைக்கும் தன்மை இல்லை. உங்கள் பட்ஜெட்டுகளை ஒத்திசைக்க அமைப்புகளில் iCloud க்கு பதிவுசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud లభ్యమైనది కాదు. మీ బడ్జెట్‌లను సంకలనం చేయడానికి సెట్టింగ్‌లలో iCloud కోసం సైన్ ఇన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ไม่พร้อมใช้งาน ลงชื่อเข้าใช้ iCloud ในการตั้งค่าเพื่อซิงค์งบประมาณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud kullanılamıyor. Bütçelerini eşlemek için Ayarlar'dan iCloud'a giriş yap."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud недоступний. Увійдіть до iCloud в Налаштуваннях, щоб синхронізувати бюджети."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud دستیاب نہیں۔ اپنے بجٹس کو مطابقت کے لیے ترتیبات میں iCloud میں سائن ان کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud không khả dụng. Đăng nhập iCloud trong Cài đặt để đồng bộ ngân sách của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 不可用。请在设置中登录 iCloud 以同步您的预算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 不可用，請在「設定」中登入 iCloud 以同步您的預算。"
          }
        }
      }
    },
    "settings.iCloud.unavailable.footer": {
      "comment": "Section footer shown below the iCloud status row when iCloud is unavailable",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى iCloud من الإعدادات لمزامنة ميزانياتك عبر أجهزتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বাজেটগুলি ডিভাইস জুড়ে সিঙ্ক করতে সেটিংসে iCloud এ সাইন ইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessió a iCloud des de Configuració per sincronitzar els pressupostos entre dispositius."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se do iCloud v Nastavení, abyste synchronizovali své rozpočty na všech zařízeních."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på iCloud i Indstillinger for at synkronisere dine budgetter på tværs af enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich in den Einstellungen bei iCloud an, um deine Budgets geräteübergreifend zu synchronisieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε στο iCloud μέσω των Ρυθμίσεων για να συγχρονίσετε τους προϋπολογισμούς σας σε όλες τις συσκευές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud in Settings to sync your budgets across devices."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud in Settings to sync your budgets across devices."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud in Settings to sync your budgets across devices."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud in Settings to sync your budgets across devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud en Ajustes para sincronizar tus presupuestos entre dispositivos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud en Configuración para sincronizar tus presupuestos en todos tus dispositivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu iCloudiin Asetuksissa synkronoidaksesi budjettisi eri laitteilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à iCloud dans Réglages pour synchroniser tes budgets sur tous tes appareils."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à iCloud dans les réglages pour synchroniser tes budgets sur tous tes appareils."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉપકરણોમાં તમારા બજેટ સમન્વય કરવા માટે સેટિંગ્સમાં iCloud માટે સાઇન ઇન કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היכנס ל-iCloud בהגדרות כדי לסנכרן את התקציבים שלך בין מכשירים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने बजट सभी डिवाइस पर सिंक करने के लिए Settings में iCloud में साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se na iCloud u Postavkama za sinkronizaciju proračuna na svim uređajima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezz be az iCloud-ba a Beállításokban, hogy szinkronizáld a költségvetéseidet az eszközök között."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk ke iCloud di Pengaturan untuk menyinkronkan anggaran di semua perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a iCloud nelle Impostazioni per sincronizzare i tuoi budget su tutti i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でiCloudにサインインして、デバイス間で予算を同期してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಬಜೆಟ್‌ಗಳನ್ನು ಸಾಧನಗಳಾದ್ಯಂತ ಸಿಂಕ್ ಮಾಡಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ iCloud ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 iCloud에 로그인하여 여러 기기에서 예산을 동기화하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉപകരണങ്ങളിലുടനീളം നിങ്ങളുടെ ബജറ്റുകൾ സിങ്ക് ചെയ്യാൻ ക്രമീകരണങ്ങളിൽ iCloud ലോഗിൻ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आपल्या budgets डिव्हाइसेस भर सिंक करण्यासाठी सेटिंग्जमध्ये iCloud मध्ये साइन इन करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk ke iCloud dalam Tetapan untuk menyegerakkan belanjawan anda merentas peranti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på iCloud i Innstillinger for å synkronisere budsjettene dine på tvers av enheter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in bij iCloud via Instellingen om je budgetten te synchroniseren op al je apparaten."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣାର ବଜେଟ୍ ଡିଭାଇସ ଅତିକ୍ରମ କରେ ସିଙ୍ଗ୍ କରିବାକୁ iCloud ରେ ସାଇନ୍ ଇନ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਯੰਤਰਾਂ ਵਿੱਚ ਤੁਸੀਂ ਦੇ ਬਜਟ ਸਿੰਕ ਕਰਨ ਲਈ ਸੈਟਿੰਗ ਵਿੱਚ iCloud ਵਿੱਚ ਦਾਖਲ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się do iCloud w Ustawieniach, aby synchronizować budżety na wszystkich urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre no iCloud em Ajustes para sincronizar seus orçamentos entre dispositivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessão no iCloud nas Definições para sincronizar os teus orçamentos em todos os dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te la iCloud din Setări pentru a sincroniza bugetele pe toate dispozitivele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войди в iCloud в Настройках, чтобы синхронизировать бюджеты на всех устройствах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihláste sa do iCloud v Nastaveniach, aby sa vaše rozpočty synchronizovali naprieč zariadeniami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavi se v iCloud v Nastavitvah za sinhronizacijo svojih proračunov med napravami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in på iCloud i Inställningar för att synkronisera dina budgetar på alla enheter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாதனங்களூடே உங்கள் பட்ஜெட்டுகளை ஒத்திசைக்க அமைப்புகளில் iCloud க்கு பதிவுசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డివైసుల అంతటా మీ బడ్జెట్‌లను సంకలనం చేయడానికి సెట్టింగ్‌లలో iCloud కోసం సైన్ ఇన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ iCloud ในการตั้งค่าเพื่อซิงค์งบประมาณของคุณทุกอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütçelerini cihazlar arasında eşlemek için Ayarlar'dan iCloud'a giriş yap."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть до iCloud в Налаштуваннях, щоб синхронізувати бюджети на всіх пристроях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے بجٹس کو ڈیوائسز میں مطابقت کے لیے ترتیبات میں iCloud میں سائن ان کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập iCloud trong Cài đặt để đồng bộ ngân sách trên các thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中登录 iCloud，以跨设备同步您的预算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中登入 iCloud，以跨裝置同步您的預算。"
          }
        }
      }
    },
