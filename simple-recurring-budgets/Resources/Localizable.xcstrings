    "settings.carryOver.toggle.accessibilityHint": {
      "comment": "VoiceOver hint for the default carry-over toggle in Settings",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد ما إذا كان الترحيل مفعّلاً افتراضياً عند إنشاء ميزانية جديدة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Defineix si el romanent està activat per defecte en crear un pressupost nou"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Určuje, zda je Carry-Over při vytváření nového rozpočtu zapnutý ve výchozím stavu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiver om overførsel er aktiveret som standard ved oprettelse af et nyt budget"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, ob der Übertrag beim Erstellen eines neuen Budgets standardmäßig aktiviert ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίζει αν η μεταφορά υπολοίπου είναι ενεργή από προεπιλογή κατά τη δημιουργία νέου προϋπολογισμού"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets whether carry-over is on by default when creating a new budget"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets whether carry-over is on by default when creating a new budget"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets whether carry-over is on by default when creating a new budget"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets whether carry-over is on by default when creating a new budget"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece si el saldo acumulado está activado por defecto al crear un nuevo presupuesto"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Define si el Carry-Over está activado por defecto al crear un presupuesto"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määrittää, onko siirto oletuksena käytössä uutta budjettia luotaessa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit si le report est activé par défaut lors de la création d'un nouveau budget"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit si le solde reporté est activé par défaut lors de la création d'un nouveau budget"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובע אם יתרה מועברת מופעלת כברירת מחדל בעת יצירת תקציב חדש"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया बजट बनाते समय कैरी-ओवर डिफ़ॉल्ट रूप से चालू रहे, यह सेट करता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Određuje je li preneseni saldo zadano uključen pri stvaranju novog proračuna"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megadja, hogy a Carry-Over alapértelmezés szerint be legyen-e kapcsolva új költségkeret létrehozásakor"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur apakah carry-over aktif secara default saat membuat anggaran baru"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta se il Carry-Over è attivo per impostazione predefinita quando si crea un nuovo budget"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規予算作成時の繰越のデフォルト設定を変更します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 예산 생성 시 이월 기능의 기본 설정 여부를 지정해요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menetapkan sama ada baki yang dibawa dihidupkan secara lalai apabila membuat belanjawan baharu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angir om Carry-Over er på som standard når du oppretter et nytt budsjett"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt in of saldo-overdracht standaard is ingeschakeld bij het aanmaken van een nieuw budget"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Określa, czy przeniesienie salda jest domyślnie włączone przy tworzeniu nowego budżetu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define se o Carry-Over fica ativado por padrão ao criar um novo orçamento"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define se o saldo transitado está ativo por omissão ao criar um novo orçamento"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilește dacă Carry-Over este activat implicit la crearea unui buget nou"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определяет, включён ли Carry-Over по умолчанию при создании нового бюджета"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavuje, či je prenesený zostatok predvolene zapnutý pri vytváraní nového rozpočtu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anger om överfört saldo är på som standard när du skapar en ny budget"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดว่าจะเปิดยอดยกมาเป็นค่าเริ่มต้นเมื่อสร้างงบประมาณใหม่หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bütçe oluştururken carry-over'ın varsayılan olarak açık olup olmayacağını belirler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначає, чи буде перенесення залишку увімкнено за замовчуванням при створенні нового бюджету"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt mặc định bật/tắt số dư chuyển kỳ khi tạo ngân sách mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置新建预算时是否默认开启结转"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定建立新預算時是否預設開啟 Carry-Over"
          }
        }
      }
    },
    "settings.carryOver.toggle.footer": {
      "comment": "Explanatory footer below the default carry-over toggle in Settings",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتتبع الفائض أو العجز بمرور الوقت. الإعداد الافتراضي للميزانيات الجديدة. لا تتأثر الميزانيات الحالية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa un seguiment del superàvit o el dèficit al llarg del temps. Configuració per defecte per als pressupostos nous. Els pressupostos existents no es veuen afectats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduje přebytek nebo schodek v průběhu času. Výchozí nastavení pro nové rozpočty. Stávající rozpočty nejsou ovlivněny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sporer over- eller underskud over tid. Standardindstilling for nye budgetter. Eksisterende budgetter påvirkes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgt Überschüsse oder Defizite im Zeitverlauf. Standardeinstellung für neue Budgets. Bestehende Budgets sind davon nicht betroffen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολουθεί πλεονάσματα ή ελλείμματα με την πάροδο του χρόνου. Προεπιλογή για νέους προϋπολογισμούς. Δεν επηρεάζει τους υπάρχοντες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks surplus or deficit over time. Default setting for new budgets. Existing budgets are not affected."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks surplus or deficit over time. Default setting for new budgets. Existing budgets are not affected."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks surplus or deficit over time. Default setting for new budgets. Existing budgets are not affected."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks surplus or deficit over time. Default setting for new budgets. Existing budgets are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra el superávit o déficit a lo largo del tiempo. Ajuste predeterminado para nuevos presupuestos. Los presupuestos existentes no se ven afectados."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastrea el superávit o déficit a lo largo del tiempo. Configuración predeterminada para nuevos presupuestos. Los presupuestos existentes no se ven afectados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa ylijäämää tai alijäämää ajan myötä. Oletusasetus uusille budjeteille. Olemassa oleviin budjetteihin ei vaikuteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit l'excédent ou le déficit au fil du temps. Paramètre par défaut pour les nouveaux budgets. Les budgets existants ne sont pas affectés."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit le surplus ou le déficit au fil du temps. Paramètre par défaut pour les nouveaux budgets. Les budgets existants ne sont pas affectés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוקב אחר עודפים או גירעונות לאורך זמן. הגדרת ברירת המחדל לתקציבים חדשים. תקציבים קיימים אינם מושפעים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय के साथ अधिशेष या घाटे को ट्रैक करता है। नए बजट के लिए डिफ़ॉल्ट सेटिंग। मौजूदा बजट प्रभावित नहीं होते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prati višak ili deficit kroz vrijeme. Zadana postavka za nove proračune. Postojeći proračuni nisu zahvaćeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomon követi a többletet vagy a hiányt az idő múlásával. Új költségkeretek alapértelmezett beállítása. A meglévő költségkeretekre nincs hatással."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melacak surplus atau defisit dari waktu ke waktu. Pengaturan default untuk anggaran baru. Anggaran yang sudah ada tidak terpengaruh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene traccia di avanzi e disavanzi nel tempo. Impostazione predefinita per i nuovi budget. I budget esistenti non vengono modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間をかけて黒字または赤字を追跡します。新規予算のデフォルト設定です。既存の予算には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간에 따라 흑자 또는 적자를 추적해요. 새 예산의 기본 설정이에요. 기존 예산에는 영향이 없어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjejaki lebihan atau defisit dari semasa ke semasa. Tetapan lalai untuk belanjawan baharu. Belanjawan sedia ada tidak terjejas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sporer overskudd eller underskudd over tid. Standardinnstilling for nye budsjetter. Eksisterende budsjetter påvirkes ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt overschot of tekort bij over tijd. Standaardinstelling voor nieuwe budgetten. Bestaande budgetten worden niet beïnvloed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledzi nadwyżkę lub deficyt w czasie. Domyślne ustawienie dla nowych budżetów. Istniejące budżety nie są zmieniane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanha superávit ou déficit ao longo do tempo. Configuração padrão para novos orçamentos. Os orçamentos existentes não são afetados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanha excedentes ou défices ao longo do tempo. Definição predefinida para novos orçamentos. Os orçamentos existentes não são afetados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește surplusul sau deficitul în timp. Setare implicită pentru bugete noi. Bugetele existente nu sunt afectate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживает профицит или дефицит со временем. Настройка по умолчанию для новых бюджетов. Существующие бюджеты не затрагиваются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduje prebytok alebo schodok v priebehu času. Predvolené nastavenie pre nové rozpočty. Existujúce rozpočty nie sú ovplyvnené."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spårar överskott eller underskott över tid. Standardinställning för nya budgetar. Befintliga budgetar påverkas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามยอดเกินหรือขาดตามเวลา เป็นค่าเริ่มต้นสำหรับงบประมาณใหม่ งบประมาณที่มีอยู่ไม่ได้รับผลกระทบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaman içindeki fazlayı veya açığı takip eder. Yeni bütçeler için varsayılan ayardır. Mevcut bütçeler etkilenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежує надлишок або дефіцит з часом. Налаштування за замовчуванням для нових бюджетів. Наявні бюджети не змінюються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi số dư dư thừa hoặc thâm hụt theo thời gian. Cài đặt mặc định cho ngân sách mới. Không ảnh hưởng đến các ngân sách hiện có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时间追踪盈余或赤字。适用于新建预算的默认设置，不影响现有预算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤隨時間累積的結餘或赤字。此為新預算的預設設定，不影響現有預算。"
          }
        }
      }
    },
