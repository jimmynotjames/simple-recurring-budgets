    "settings.carryOver.toggle.accessibilityHint": {
      "comment": "VoiceOver hint for the default carry-over toggle in Settings",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد ما إذا كان المُرحَّل قيد التشغيل بشكل افتراضي عند إنشاء ميزانية جديدة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন বাজেট তৈরি করার সময় উদ্বৃত্ত স্থানান্তর ডিফল্ট হিসাবে চালু থাকে কিনা তা নির্ধারণ করে"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estableix si el romanent està activat per defecte al crear un pressupost nou"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavuje, zda je převod ve výchozím nastavení zapnutý při vytváření nového rozpočtu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiver, om overførsel er aktiveret som standard, når der oprettes et nyt budget"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, ob der Übertrag standardmäßig aktiviert ist, wenn du ein neues Budget erstellst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καθορίζει εάν η Μεταφορά είναι ενεργή από προεπιλογή κατά τη δημιουργία νέου Προϋπολογισμού"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets whether carry-over is on by default when creating a new budget"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets whether carry-over is on by default when creating a new budget"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets whether carry-over is on by default when creating a new budget"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets whether carry-over is on by default when creating a new budget"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece si el remanente está activado de forma predeterminada al crear un nuevo presupuesto"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Define si el saldo acumulado está activado por defecto al crear un nuevo presupuesto"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määrittää, onko siirto päällä oletuksena uutta budjettia luotaessa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détermine si le report est activé par défaut lors de la création d'un nouveau budget"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Détermine si le report est activé par défaut lors de la création d'un nouveau budget"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નવું બજેટ બનાવતી વખતે આગળ વહન ડિફોલ્ટ રીતે ચાલુ છે કે નહીં તે નક્કી કરે છે"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קביעה אם יתרה מועברת פעם כברירת מחדל בעת יצירת תקציב חדש"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया बजट बनाते समय कैरी-ओवर डिफ़ॉल्ट रूप से चालू है या नहीं, यह निर्धारित करता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Određuje je li prijenos uključen prema zadanoj vrijednosti pri stvaranju novog proračuna"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítja, hogy az átvitel alapértelmezetten be legyen kapcsolva új költségkeret létrehozásakor"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menetapkan apakah saldo bawaan aktif secara default saat membuat anggaran baru"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilisce se il riporto è attivato per impostazione predefinita quando crei un nuovo budget"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい予算を作成するときに繰り越しがデフォルトで有効になるかどうかを設定します"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೊಸ ಬಜೆಟ್ ರಚಿಸುವಾಗ ಮುಂದಕ್ಕೆ ಸಾಗಿಸುವಿಕೆ ಡಿಫಾಲ್ಟ ಆನಾಗುತ್ತದೆಯೇ ಎಂಬುದನ್ನು ಹೊಂದಿಸುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 예산 생성 시 기본적으로 이월을 설정할지 여부를 결정합니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുതിയ ബജറ്റ് സൃഷ്ടിക്കുമ്പോൾ കാരി-ഓവർ സ്ഥിരമായി ഓൺ ആണ്ട് സെറ്റിൻഗ് ചെയ്യുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीन budget तयार करताना पुढे नेलेली शिल्लक डिफॉल्टच्या रूपात चालू असेल की नाही हे सेट करते"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menetapkan sama ada bawa ke hadapan aktif secara lalai apabila membuat bajet baharu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angir om overføring er på som standard når du oppretter et nytt budsjett"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt of overdracht standaard is ingeschakeld bij het maken van een nieuw budget"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନୂଆ ବଜେଟ୍ ତୈରି କରିବା ସମୟରେ ଆଗକୁ ନିଆ ବାକି ଡିଫଲ୍ଟ ଅଛିକି ସେଇ ସେଟ୍ କରେ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਵਾਂ ਬਜਟ ਬਣਾਉਂਦੇ ਸਮੇਂ ਅੱਗੇ ਲਿਜਾਣਾ ਪੂਰਵ ਨਿਯਤ ਕਿਆ ਜਾਵੇ ਇਹ ਸੈਟ ਕਰਦਾ ਹੈ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Określa, czy przeniesienie jest włączone domyślnie podczas tworzenia nowego budżetu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define se o saldo acumulado está ativado por padrão ao criar um novo orçamento"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define se a transição está ativada por predefinição ao criar um novo orçamento"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilește dacă reportul este activat implicit atunci când se creează un buget nou"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает перенос по умолчанию при создании нового бюджета"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Určuje, či je prenos štandardne zapnutý pri vytváraní nového rozpočtu"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavi, ali je prenos privzeto vključen pri ustvarjanju novega proračuna"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anger om överföring är aktiverad som standard när en ny budget skapas"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய பட்ஜெட்டை உருவாக்கும்போது முன்கொண்டுசெல் முறையாக இயக்கப்படுகிறதா என்பதை அமைக்கிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొత్త బడ్జెట్‌ను సృష్టించేటప్పుడు డిఫాల్ట్‌గా క్యారీ-ఓవర్ ఆన్‌గా ఉందో లేదో సెట్ చేస్తుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดว่าเปิดยอดยกมาโดยค่าเริ่มต้นเมื่อสร้างงบประมาณใหม่หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir bütçe oluştururken devirin varsayılan olarak açık olup olmayacağını belirler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначає, чи увімкнено перенесення залишку за замовчуванням під час створення нового бюджету"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئے بجٹ بناتے وقت آگے منتقلی ڈیفالٹ طور پر چالو ہو یا نہ ہو"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt xem liệu chuyển tiếp có bật theo mặc định khi tạo ngân sách mới không"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置创建新预算时结转默认是否启用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定建立新預算時是否預設啟用結轉"
          }
        }
      }
    },
    "settings.carryOver.toggle.footer": {
      "comment": "Explanatory footer below the default carry-over toggle in Settings",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتتبع الفائض أو العجز بمرور الوقت. الإعداد الافتراضي للميزانيات الجديدة. لا تتأثر الميزانيات الحالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময়ের সাথে সাথে উদ্বৃত্ত বা ঘাটতি ট্র্যাক করে। নতুন বাজেটের জন্য ডিফল্ট সেটিং। বর্তমান বাজেটগুলি প্রভাবিত হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa un seguiment del superàvit o el dèficit al llarg del temps. Configuració per defecte per als pressupostos nous. Els pressupostos existents no es veuen afectats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduje přebytek nebo schodek v průběhu času. Výchozí nastavení pro nové rozpočty. Stávající rozpočty nejsou ovlivněny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sporer over- eller underskud over tid. Standardindstilling for nye budgetter. Eksisterende budgetter påvirkes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgt Überschüsse oder Defizite im Zeitverlauf. Standardeinstellung für neue Budgets. Bestehende Budgets sind davon nicht betroffen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολουθεί πλεονάσματα ή ελλείμματα με την πάροδο του χρόνου. Προεπιλογή για νέους προϋπολογισμούς. Δεν επηρεάζει τους υπάρχοντες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks surplus or deficit over time. Default setting for new budgets. Existing budgets are not affected."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks surplus or deficit over time. Default setting for new budgets. Existing budgets are not affected."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks surplus or deficit over time. Default setting for new budgets. Existing budgets are not affected."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks surplus or deficit over time. Default setting for new budgets. Existing budgets are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra el superávit o déficit a lo largo del tiempo. Ajuste predeterminado para nuevos presupuestos. Los presupuestos existentes no se ven afectados."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastrea el superávit o déficit a lo largo del tiempo. Configuración predeterminada para nuevos presupuestos. Los presupuestos existentes no se ven afectados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa ylijäämää tai alijäämää ajan myötä. Oletusasetus uusille budjeteille. Olemassa oleviin budjetteihin ei vaikuteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit l'excédent ou le déficit au fil du temps. Paramètre par défaut pour les nouveaux budgets. Les budgets existants ne sont pas affectés."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit le surplus ou le déficit au fil du temps. Paramètre par défaut pour les nouveaux budgets. Les budgets existants ne sont pas affectés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમય દર સમય વધારો અથવા ઘાટ ટ્રેક કરે છે. નવા બજેટ માટે ડિફોલ્ટ સેટિંગ. હાલના બજેટ અસરગ્રસ્ત નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוקב אחר עודפים או גירעונות לאורך זמן. הגדרת ברירת המחדל לתקציבים חדשים. תקציבים קיימים אינם מושפעים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय के साथ अधिशेष या घाटे को ट्रैक करता है। नए बजट के लिए डिफ़ॉल्ट सेटिंग। मौजूदा बजट प्रभावित नहीं होते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prati višak ili deficit kroz vrijeme. Zadana postavka za nove proračune. Postojeći proračuni nisu zahvaćeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomon követi a többletet vagy a hiányt az idő múlásával. Új költségkeretek alapértelmezett beállítása. A meglévő költségkeretekre nincs hatással."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melacak surplus atau defisit dari waktu ke waktu. Pengaturan default untuk anggaran baru. Anggaran yang sudah ada tidak terpengaruh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene traccia di avanzi e disavanzi nel tempo. Impostazione predefinita per i nuovi budget. I budget esistenti non vengono modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間をかけて黒字または赤字を追跡します。新規予算のデフォルト設定です。既存の予算には影響しません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಮಯದ ಸಿದ್ಧಾರ್ಥ ಅಥವಾ ಕೊರತೆಯನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡುತ್ತದೆ. ಹೊಸ ಬಜೆಟ್‌ಗಾಗಿ ಡಿಫಾಲ್ಟ್ ಸೆಟ್ಟಿಂಗ್. ಇತಿಹಾಸ ಬಜೆಟ್‌ಗಳು ಪ್ರಭಾವಿತವಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간에 따라 흑자 또는 적자를 추적해요. 새 예산의 기본 설정이에요. 기존 예산에는 영향이 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സമയത്തിന് ഇതര അല്ലെങ്കിൽ കമ്മി ട്രാക് ചെയ്യുന്നു. പുതിയ ബജറ്റുകളുടെ സ്ഥിരസജ്ജീകരണം. നിലവിലുള്ള ബജറ്റുകൾ ബാധിതമല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कालांतराने शिल्लक किंवा तूट ट्रॅक करते. नवीन budgets साठी डिफॉल्ट सेटिंग. विद्यमान budgets प्रभावित नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjejaki lebihan atau defisit dari semasa ke semasa. Tetapan lalai untuk belanjawan baharu. Belanjawan sedia ada tidak terjejas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sporer overskudd eller underskudd over tid. Standardinnstilling for nye budsjetter. Eksisterende budsjetter påvirkes ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt overschot of tekort bij over tijd. Standaardinstelling voor nieuwe budgetten. Bestaande budgetten worden niet beïnvloed."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସମୟ ଅତିକ୍ରମ କରେ ଅଧିକତା ବା ଘାଟି। ନୂଆ ବଜେଟ୍ ପାଇଁ ଡିଫଲ୍ଟ ସେଟିଂ। ପୂର୍ବ ବଜେଟ୍ ପ୍ରଭାବିତ ନୁହେଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਮੇਂ ਦੇ ਨਾਲ ਵਾਧਾ ਜਾਂ ਘਾਟਾ ਟਰੈਕ ਕਰਦਾ ਹੈ। ਨਵੇ ਬਜਟਾਂ ਲਈ ਪੂਰਵ ਨਿਯਤ ਸੈਟਿੰਗ। ਮੌਜੂਦਾ ਬਜਟ ਪ੍ਰਭਾਵਤ ਨਹੀਂ ਹਨ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledzi nadwyżkę lub deficyt w czasie. Domyślne ustawienie dla nowych budżetów. Istniejące budżety nie są zmieniane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanha superávit ou déficit ao longo do tempo. Configuração padrão para novos orçamentos. Os orçamentos existentes não são afetados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanha excedentes ou défices ao longo do tempo. Definição predefinida para novos orçamentos. Os orçamentos existentes não são afetados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește surplusul sau deficitul în timp. Setare implicită pentru bugete noi. Bugetele existente nu sunt afectate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживает профицит или дефицит со временем. Настройка по умолчанию для новых бюджетов. Существующие бюджеты не затрагиваются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduje prebytok alebo schodok v priebehu času. Predvolené nastavenie pre nové rozpočty. Existujúce rozpočty nie sú ovplyvnené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledi presežkom ali primanjkljajem čez čas. Privzeta nastavitev za nove proračune. Obstoječi proračuni niso vplivani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spårar överskott eller underskott över tid. Standardinställning för nya budgetar. Befintliga budgetar påverkas inte."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேர முழுவதும் உபரி அல்லது பற்றாக்குறையைக் கண்காணிக்கிறது. புதிய பட்ஜெட்டுக்கான ஆரம்ப அமைப்பு. இருக்கும் பட்ஜெட்டுகள் பாதிக்கப்பட்டுவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాలానికి సంచిత సర్ప్లస్ లేదా లోటుని ట్రాక్ చేస్తుంది. కొత్త బడ్జెట్‌ల కోసం డిఫాల్ట్ సెట్టింగ్. ఉపస్థిత బడ్జెట్‌లు ప్రభావితం కాబట్టే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามยอดเกินหรือขาดตามเวลา เป็นค่าเริ่มต้นสำหรับงบประมาณใหม่ งบประมาณที่มีอยู่ไม่ได้รับผลกระทบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaman içindeki fazlayı veya açığı takip eder. Yeni bütçeler için varsayılan ayardır. Mevcut bütçeler etkilenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежує надлишок або дефіцит з часом. Налаштування за замовчуванням для нових бюджетів. Наявні бюджети не змінюються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت کے ساتھ بچت یا خسارے کو ٹریک کرتا ہے۔ نئے بجٹس کے لیے ڈیفالٹ ترتیب۔ موجودہ بجٹس متاثر نہیں ہوتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi số dư dư thừa hoặc thâm hụt theo thời gian. Cài đặt mặc định cho ngân sách mới. Không ảnh hưởng đến các ngân sách hiện có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时间追踪盈余或赤字。适用于新建预算的默认设置，不影响现有预算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤隨時間累積的結餘或赤字。此為新預算的預設設定，不影響現有預算。"
          }
        }
      }
    },
