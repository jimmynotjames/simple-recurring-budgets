    "settings.weekStart.accessibilityHint": {
      "comment": "VoiceOver hint for the week-start day picker in Settings",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤثر تغيير هذا الإعداد على جميع الميزانيات الأسبوعية وميزانيات كل أسبوعين"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El canvi afecta tots els pressupostos setmanals i quinzenals"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna ovlivní všechny týdenní a dvoutýdenní rozpočty"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændring af dette påvirker alle ugentlige og 14-dages budgetter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung betrifft alle wöchentlichen und zweiwöchentlichen Budgets"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή αυτή επηρεάζει όλους τους εβδομαδιαίους και δεκαπενθήμερους προϋπολογισμούς"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing this affects all weekly and biweekly budgets"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing this affects all weekly and fortnightly budgets"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing this affects all weekly and biweekly budgets"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing this affects all weekly and fortnightly budgets"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar esto afecta a todos los presupuestos semanales y quincenales"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar esto afecta todos los presupuestos semanales y quincenales"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutos vaikuttaa kaikkiin viikoittaisiin ja kahden viikon budjetteihin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette modification affecte tous les budgets hebdomadaires et bihebdomadaires"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce changement affecte tous les budgets hebdomadaires et bihebdomadaires"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי זה משפיע על כל התקציבים השבועיים והדו-שבועיים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे बदलने से सभी साप्ताहिक और द्विसाप्ताहिक बजट प्रभावित होते हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjena utječe na sve tjedne i dvotjedne proračune"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Módosítása minden heti és kéthetes büdzsét érint"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah ini akan memengaruhi semua anggaran mingguan dan dua mingguan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica interessa tutti i budget settimanali e bisettimanali"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更するとすべての週次・隔週予算に影響します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경하면 모든 주간 및 격주 예산에 영향을 줘요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah ini mempengaruhi semua belanjawan mingguan dan dua mingguan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endring av dette påvirker alle ukentlige og annenhverukentlige budsjetter"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit heeft invloed op alle wekelijkse en tweewekelijkse budgetten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana ta wpływa na wszystkie budżety tygodniowe i dwutygodniowe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar isso afeta todos os orçamentos semanais e quinzenais"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta alteração afeta todos os orçamentos semanais e quinzenais"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificarea aceasta afectează toate bugetele săptămânale și bilunare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение влияет на все еженедельные и двухнедельные бюджеты"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmena ovplyvní všetky týždenné a dvojtýždenné rozpočty"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringen påverkar alla vecko- och tvåveckorsbudgetar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงนี้ส่งผลต่องบประมาณรายสัปดาห์และรายสองสัปดาห์ทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu değişiklik tüm haftalık ve iki haftada bir bütçeleri etkiler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна впливає на всі тижневі та двотижневі бюджети"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi này ảnh hưởng đến tất cả ngân sách hàng tuần và hai tuần"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改此设置将影响所有每周和每两周预算"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更此設定將影響所有每週和雙週預算"
          }
        }
      }
    },
