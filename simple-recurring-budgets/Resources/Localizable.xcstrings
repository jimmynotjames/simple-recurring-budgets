          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En sparning i appen misslyckades upprepade gånger. Diagnostisk kontext (ingen personlig data):"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกในแอปล้มเหลวซ้ำแล้วซ้ำเล่า ข้อมูลการวินิจฉัย (ไม่มีข้อมูลส่วนตัว):"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamada bir kayıt işlemi tekrar tekrar başarısız oldu. Tanılama bilgisi (kişisel veri yok):"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збереження в додатку не вдалося кілька разів. Діагностичні дані (без персональної інформації):"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu trong ứng dụng không thành công nhiều lần. Thông tin chẩn đoán (không bao gồm dữ liệu cá nhân):"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用中的保存失败重复出现。诊断信息(不含个人数据)："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式中的儲存作業重複失敗。診斷內容（不包含個人資料）："
          }
        }
      }
    },
    "feedback.email.body.prompt": {
      "comment": "Closing prompt at the end of the auto-filled email body, inviting the user to describe what they were doing when the save failed.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى وصف ما كنت تفعله عندما حدثت هذه المشكلة:"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Descriu si us plau què estaves fent quan ha passat això:"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosím popište, co jste dělali, když se to stalo:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv hvad du lavede, da dette skete:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte beschreibe, was du getan hast, als dies passiert ist:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακαλώ περιγράψτε τι κάνατε όταν συνέβη αυτό:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please describe what you were doing when this happened:"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Please describe what you were doing when this happened:"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Please describe what you were doing when this happened:"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Please describe what you were doing when this happened:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, describe qué estabas haciendo cuando ocurrió esto:"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor describe qué estabas haciendo cuando sucedió:"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvaile, mitä teit, kun tämä tapahtui:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décris ce que tu faisais au moment où c'est arrivé :"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Décris ce que tu faisais au moment où c'est arrivé :"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא תאר מה עשית כשזה קרה:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया बताएं कि आप यह कब कर रहे थे जब ऐसा हुआ:"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Molimo opišite što ste radili kada se ovo dogodilo:"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérjük, írd le, mit csináltál, amikor ez történt:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelaskan apa yang Anda lakukan saat hal ini terjadi:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi cosa stavi facendo quando è accaduto:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この問題が発生した時に何をしていたかについて説明してください:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문제가 발생했을 때 어떤 작업을 하고 있었는지 설명해 주세요:"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila huraikan apa yang anda lakukan apabila perkara ini berlaku:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vennligst beskriv hva du gjorde da dette skjedde:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf wat je aan het doen was toen dit gebeurde:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz, co robiłeś, gdy to się stało:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva o que você estava fazendo quando isso aconteceu:"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreve o que estavas a fazer quando isto aconteceu:"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Te rog descrie ce făceai când s-a întâmplat aceasta:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опиши, что ты делал, когда это произошло:"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Popíšte, prosím, čo ste robili, keď sa to stalo:"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv vad du gjorde när det här hände:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดอธิบายว่าคุณกำลังทำอะไรเมื่อเหตุการณ์นี้เกิดขึ้น:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu olduğunda ne yaptığını açıkla:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, опишіть, що ви робили, коли це сталося:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng mô tả những gì bạn đang làm khi lỗi này xảy ra:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请描述发生此情况时您正在做什么："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請描述發生此問題時您正在執行的操作："
          }
        }
      }
    },
