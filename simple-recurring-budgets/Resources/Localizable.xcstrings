    "addEditBudget.orphanWarning.message": {
      "comment": "Body of the orphan-expense alert on the Edit Budget Save confirmation. Explains that orphaned expenses stay in the list but are not counted by the budget.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هذه المصروفات في قائمتك ولكن لن يتم احتسابها بواسطة هذه الميزانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেই খরচগুলি আপনার তালিকায় দেখায় কিন্তু এই বাজেট দ্বারা গণনা করা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquestes despeses segueixen mostrant-se a la llista però no es comptabilitzaran per a aquest pressupost."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto výdaje se stále zobrazují v seznamu, ale nebudou zahrnuty do tohoto rozpočtu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse udgifter vises stadig på listen, men tælles ikke med i dette budget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ausgaben werden in deiner Liste angezeigt, werden aber von diesem Budget nicht berücksichtigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτά τα έξοδα εξακολουθούν να εμφανίζονται στη λίστα σου, αλλά δεν θα υπολογίζονται από αυτόν τον προϋπολογισμό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Those expenses still show in your list but won't be counted by this budget."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Those expenses still show in your list but won't be counted by this budget."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Those expenses still show in your list but won't be counted by this budget."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Those expenses still show in your list but won't be counted by this budget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos gastos se siguen mostrando en tu lista, pero no serán contabilizados por este presupuesto."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos gastos siguen apareciendo en tu lista pero no se contarán en este presupuesto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä kulutustapahtumat näkyvät edelleen luettelossasi, mutta niitä ei lasketa tähän budjettiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces dépenses figurent toujours dans votre liste, mais ne seront pas comptabilisées par ce budget."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces dépenses restent dans ta liste, mais ne seront pas comptées par ce budget."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તે ખર્ચ તમારી સૂચીમાં દેખાય છે પરંતુ આ બજેટ દ્વારા ગણવામાં આવશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוצאות אלו עדיין מופיעות ברשימה שלך, אך לא יספרו על ידי תקציב זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये खर्च अभी भी आपकी सूची में दिखाई देते हैं लेकिन इस बजट द्वारा गिने नहीं जाएंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti troškovi i dalje se prikazuju u popisu, ali ovaj proračun ih neće uzeti u obzir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek a tranzakciók még mindig megjelennek a listában, de erre a költségvetésre nem vonatkoznak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengeluaran tersebut masih ditampilkan dalam daftar Anda tetapi tidak akan dihitung oleh anggaran ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste spese vengono visualizzate nell'elenco ma non verranno conteggiate da questo budget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それらの支出はリストに表示されますが、この予算には集計されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅವು ನಿಮ್ಮ ಪಟ್ಟಿಯಲ್ಲಿ ತೋರುವುದನ್ನು ಮುಂದುವರಿಸುತ್ತವೆ ಆದರೆ ಈ ಬಜೆಟ್‌ನಿಂದ ಎಣಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 거래들은 목록에 계속 표시되지만 이 예산에 포함되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആ ചെലവുകൾ ഇപ്പോഴും നിങ്ങളുടെ ലിസ്റ്റിൽ കാണപ്പെടുന്നു എന്നാൽ ഈ ബജറ്റ് കൊണ്ട് എണ്ണപ്പെടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ते खर्च अजूनही तुमच्या सूचीमध्ये दिसतात पण या budget ने मोजले जाणार नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbelanjaan tersebut masih tersenarai tetapi tidak akan dikira dalam bajet ini."
          }
