    "addEditBudget.schedule.disclosure.accessibilityHint": {
      "comment": "VoiceOver hint for the Schedule disclosure row on the Add/Edit Budget screen",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لإظهار أو إخفاء عناصر التحكم في تاريخ البداية وتاريخ الانتهاء."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca per mostrar o amagar els controls de data d'inici i data de fi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím zobrazíte nebo skryjete ovládací prvky pro datum začátku a data konce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at vise eller skjule startdato- og slutdatokontroller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Ein- oder Ausblenden der Startdatum- und Enddatum-Steuerelemente tippen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε για να εμφανίσετε ή να αποκρύψετε τα στοιχεία ελέγχου ημερομηνίας έναρξης και λήξης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to show or hide the start date and end date controls."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to show or hide the start date and end date controls."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to show or hide the start date and end date controls."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to show or hide the start date and end date controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para mostrar u ocultar los controles de fecha de inicio y fecha de fin."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para mostrar u ocultar los controles de fecha de inicio y fecha de fin."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta näyttääksesi tai piilottaaksesi aloituspäivän ja päättymispäivän ohjausobjektit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez pour afficher ou masquer les contrôles de date de début et de date de fin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez pour afficher ou masquer les contrôles de date de début et de date de fin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש להצגה או הסתרה של בקרי תאריך התחלה ותאריך סיום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरुआत की तिथि और समाप्ति तिथि नियंत्रण दिखाने या छिपाने के लिए टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite da prikaže ili sakrije kontrole datuma početka i datuma završetka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Érintse meg az ütemezési vezérlők megjelenítéséhez vagy elrejtéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk menampilkan atau menyembunyikan kontrol tanggal mulai dan tanggal akhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per mostrare o nascondere i controlli data di inizio e data di fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして、開始日と終了日のコントロールを表示または非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하여 시작 날짜 및 종료 날짜 컨트롤을 표시하거나 숨깁니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik untuk menunjukkan atau menyembunyikan kawalan tarikh mula dan tarikh tamat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å vise eller skjule startdato- og sluttdatokontrollene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om de besturingselementen voor startdatum en einddatum weer te geven of te verbergen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij, aby pokazać lub ukryć formanty daty początkowej i końcowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para mostrar ou ocultar os controles de data de início e data de término."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para mostrar ou ocultar os controlos de data de início e data de término."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge pentru a arăta sau ascunde controalele pentru data de început şi data de sfârşit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы показать или скрыть элементы управления датой начала и датой окончания."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite na zobrazenie alebo skrytie ovládacích prvkov dátumu začiatku a dátumu ukončenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att visa eller dölja kontrollerna för startdatum och slutdatum."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อแสดงหรือซ่อนตัวควบคุมวันเริ่มต้นและวันสิ้นสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç tarihi ve bitiş tarihi kontrollerini göstermek veya gizlemek için dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться, щоб показати або приховати дати початку та завершення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn để hiển thị hoặc ẩn các điều khiển ngày bắt đầu và ngày kết thúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点以显示或隐藏开始日期和结束日期控件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點以顯示或隱藏開始日期和結束日期控制項。"
          }
        }
      }
    },
