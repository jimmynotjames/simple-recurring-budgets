    "containerFailure.body": {
      "comment": "Body text on the container-failure recovery screen. Reassures the user, invites Retry or Send Feedback. Should not mention the error code; the diagnostic context is carried in the Send Feedback email body.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما أثناء تحميل الميزانيات. حاول مجددًا، أو أرسل لنا التفاصيل لكي نتمكن من مساعدتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বাজেটগুলি লোড করতে কিছু ভুল হয়েছে। আবার চেষ্টা করুন বা আমাদের বিবরণ পাঠান যাতে আমরা সাহায্য করতে পারি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguna cosa ha anat malament en carregar els teus pressupostos. Intenta-ho de nou o envia'ns els detalls perquè t'ajudem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při načítání vašich rozpočtů se něco pokazilo. Zkuste to znovu, nebo nám pošlete detaily, abychom vám mohli pomoci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gik noget galt med indlæsningen af dine budgetter. Prøv igen, eller send os detaljerne, så vi kan hjælpe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Laden deiner Budgets ist ein Fehler aufgetreten. Versuche es erneut, oder sende uns die Details, damit wir dir helfen können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι πήγε στραβά κατά τη φόρτωση των προϋπολογισμών σας. Δοκιμάστε ξανά ή στείλτε μας τις λεπτομέρειες για να σας βοηθήσουμε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong loading your budgets. Try again, or send us the details so we can help."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong loading your budgets. Try again, or send us the details so we can help."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong loading your budgets. Try again, or send us the details so we can help."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong loading your budgets. Try again, or send us the details so we can help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo ha fallado al cargar tus presupuestos. Vuelve a intentarlo o envíanos los detalles para poder ayudarte."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal al cargar tus presupuestos. Intenta de nuevo o envíanos los detalles para poder ayudarte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Budjetin lataaminen epäonnistui. Yritä uudelleen tai lähetä meille yksityiskohdat, jotta voimme auttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu lors du chargement de tes budgets. Réessaie, ou envoie-nous les détails pour qu'on puisse t'aider."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s'est produite lors du chargement de tes budgets. Réessaie, ou envoie-nous les détails pour qu'on puisse t'aider."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા બજેટ લોડ કરવામાં કંઈક ખોટું થયું. ફરી પ્રયાસ કરો, અથવા આપણને વિગતો મોકલો જેથી આપણે તમને મદદ કરી શકીએ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש בעת טעינת התקציבים שלך. נסה שוב, או שלח לנו את הפרטים כדי שנוכל לעזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बजट लोड करने में कुछ गलत हुआ। फिर से कोशिश करें, या हमें विवरण भेजें ताकि हम मदद कर सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nešto je pošlo po zlu pri učitavanju vaših proračuna. Pokušajte ponovno ili nam pošaljite detalje kako bismo vam pomogli."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiba történt a költségkeretek betöltésekor. Próbáld újra, vagy küldj részleteket, hogy segíthessünk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan saat memuat anggaran Anda. Coba lagi, atau kirim detail tersebut kepada kami agar kami dapat membantu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore durante il caricamento dei tuoi budget. Riprova o inviaci i dettagli per poter aiutare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予算の読み込み中に問題が発生しました。もう一度試すか、詳細情報をお知らせください。サポートいたします。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಬಜೆಟ್‌ಗಳನ್ನು ಲೋಡ್ ಮಾಡುವಲ್ಲಿ ಏನಾದರೂ ತಪ್ಪಾದೆ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ, ಅಥವಾ ನಾವು ಸಹಾಯ ಮಾಡಲು ವಿವರಗಳನ್ನು ಕಳುಹಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예산 데이터를 불러오는 중에 문제가 발생했습니다. 다시 시도하거나 세부 정보를 보내주시면 도움을 드리겠습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ബജറ്റുകൾ ലോഡ് ചെയ്യുന്നതിൽ എന്തെങ്കിലും തെറ്റായി പോയി. വീണ്ടും ശ്രമിക്കുക, അല്ലെങ്കിൽ നിങ്ങളെ സഹായിക്കാൻ ഞങ്ങൾക്ക് വിശദാംശങ്ങൾ അയയ്ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आपल्या budgets लोड करण्यात काहीतरी चूक झाली. पुन्हा प्रयत्न करा, किंवा आम्हाला तपशील पाठवा जेणेकरून आम्ही मदत करू शकू."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada masalah semasa memuatkan bajet anda. Cuba lagi, atau hantar butiran kepada kami untuk bantuan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe gikk galt da vi skulle laste budsjettene dine. Prøv igjen, eller send oss detaljene så vi kan hjelpe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis bij het laden van je budgetten. Probeer het opnieuw of stuur ons de details zodat we je kunnen helpen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣାର ବଜେଟ୍ ଲୋଡ୍ କରିବାରେ କିଛି ଭୁଲ ହୋଇଗଲା। ଆବାର ଚେଷ୍ଟା କରନ୍ତୁ, କିମ୍ବା ବିବରଣୀ ପଠାନ୍ତୁ ଯାଥା ଆମେ ସାହାଯ୍ୟ କରିପାରିବା।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਦੇ ਬਜਟ ਨੂੰ ਲੋਡ ਕਰਨ ਵਿੱਚ ਕੁਝ ਗਲਤ ਹੋ ਗਿਆ। ਫਿਰ ਕੋਸ਼ਿਸ਼ ਕਰੋ, ਜਾਂ ਸਾਨੂੰ ਵੇਰਵੇ ਭੇਜੋ ਤਾਂ ਜੋ ਸਾਂ ਸਹਾਇਤਾ ਕਰ ਸਕੀ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak przy ładowaniu budżetów. Spróbuj ponownie lub wyślij nam szczegóły, abyśmy mogli Ci pomóc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado ao carregar seus orçamentos. Tente novamente ou envie-nos os detalhes para que possamos ajudar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro ao carregar os teus orçamentos. Tenta novamente ou envia-nos os detalhes para podermos ajudar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva nu a funcționat la încărcarea bugetelor tale. Încearcă din nou sau trimite-ne detaliile pentru a te ajuta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При загрузке бюджетов произошла ошибка. Повторите попытку или отправьте нам сведения, чтобы мы могли помочь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niečo sa pokazilo pri načítavaní vašich rozpočtov. Skúste znova alebo nám pošlite podrobnosti, aby sme vám mohli pomôcť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekaj je šlo narobe pri nalaganju tvojih proračunov. Poskusi znova ali nam pošlji podrobnosti, da ti lahko pomagamo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något gick fel när budgetarna laddades. Försök igen eller skicka oss informationen så kan vi hjälpa till."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பட்ஜெட்டுகளை ஏற்றுவதில் ஏதோ தவறு ஆனது. மீண்டும் முயற்சி செய்யவும், அல்லது நாங்கள் உதவ முடியும் என்பதற்காக விவரங்களை அனுப்பவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ బడ్జెట్‌లను లోడ్ చేయడంలో ఎంత ఖర్చయైనా ఉంది. మళ్లీ ప్రయత్నించండి, లేదా మాకు వివరాలను పంపండి కనుక మేము సహాయం చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาดระหว่างการโหลดงบประมาณของคุณ ลองใหม่อีกครั้ง หรือส่งรายละเอียดให้เราเพื่อที่เราจะได้ช่วยเหลือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütçelerin yüklenirken bir şeyler ters gitti. Tekrar dene ya da ayrıntıları bize gönder, yardımcı olalım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час завантаження ваших бюджетів сталася помилка. Спробуйте ще раз або надішліть нам деталі, щоб ми змогли допомогти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے بجٹس کو لوڈ کرنے میں کوئی خرابی آئی۔ دوبارہ کوشش کریں، یا ہمیں تفصیلات بھیجیں تاکہ ہم مدد کر سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có lỗi khi tải ngân sách của bạn. Thử lại hoặc gửi thông tin cho chúng tôi để chúng tôi có thể giúp bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载预算时出错。请重试，或将详情发送给我们以便帮助您。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入預算時出錯。請重試，或將詳情傳送給我們，以便我們協助您解決。"
          }
        }
      }
    },
