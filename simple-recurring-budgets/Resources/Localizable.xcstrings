            "value": "เปิดอีเมลพร้อมรายละเอียดข้อผิดพลาด ไม่มีข้อมูลส่วนตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hata ayrıntılarıyla birlikte bir e-posta açar, kişisel veri içermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває лист електронної пошти з деталями помилки без особистих даних."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở email với chi tiết lỗi, không có dữ liệu cá nhân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开包含错误详情的邮件，不包含个人数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟包含錯誤詳情的電子郵件，不包含個人資料。"
          }
        }
      }
    },
    "containerFailure.body": {
      "comment": "Body text on the container-failure recovery screen. Reassures the user, invites Retry or Send Feedback. Should not mention the error code; the diagnostic context is carried in the Send Feedback email body.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما أثناء تحميل الميزانيات. حاول مجددًا، أو أرسل لنا التفاصيل لكي نتمكن من مساعدتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguna cosa ha anat malament en carregar els teus pressupostos. Intenta-ho de nou o envia'ns els detalls perquè t'ajudem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při načítání vašich rozpočtů se něco pokazilo. Zkuste to znovu, nebo nám pošlete detaily, abychom vám mohli pomoci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gik noget galt med indlæsningen af dine budgetter. Prøv igen, eller send os detaljerne, så vi kan hjælpe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Laden deiner Budgets ist ein Fehler aufgetreten. Versuche es erneut, oder sende uns die Details, damit wir dir helfen können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι πήγε στραβά κατά τη φόρτωση των προϋπολογισμών σας. Δοκιμάστε ξανά ή στείλτε μας τις λεπτομέρειες για να σας βοηθήσουμε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong loading your budgets. Try again, or send us the details so we can help."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong loading your budgets. Try again, or send us the details so we can help."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong loading your budgets. Try again, or send us the details so we can help."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong loading your budgets. Try again, or send us the details so we can help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo ha fallado al cargar tus presupuestos. Vuelve a intentarlo o envíanos los detalles para poder ayudarte."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal al cargar tus presupuestos. Intenta de nuevo o envíanos los detalles para poder ayudarte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Budjetin lataaminen epäonnistui. Yritä uudelleen tai lähetä meille yksityiskohdat, jotta voimme auttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu lors du chargement de tes budgets. Réessaie, ou envoie-nous les détails pour qu'on puisse t'aider."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s'est produite lors du chargement de tes budgets. Réessaie, ou envoie-nous les détails pour qu'on puisse t'aider."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש בעת טעינת התקציבים שלך. נסה שוב, או שלח לנו את הפרטים כדי שנוכל לעזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बजट लोड करने में कुछ गलत हुआ। फिर से कोशिश करें, या हमें विवरण भेजें ताकि हम मदद कर सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nešto je pošlo po zlu pri učitavanju vaših proračuna. Pokušajte ponovno ili nam pošaljite detalje kako bismo vam pomogli."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiba történt a költségkeretek betöltésekor. Próbáld újra, vagy küldj részleteket, hogy segíthessünk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan saat memuat anggaran Anda. Coba lagi, atau kirim detail tersebut kepada kami agar kami dapat membantu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore durante il caricamento dei tuoi budget. Riprova o inviaci i dettagli per poter aiutare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予算の読み込み中に問題が発生しました。もう一度試すか、詳細情報をお知らせください。サポートいたします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예산 데이터를 불러오는 중에 문제가 발생했습니다. 다시 시도하거나 세부 정보를 보내주시면 도움을 드리겠습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada masalah semasa memuatkan bajet anda. Cuba lagi, atau hantar butiran kepada kami untuk bantuan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe gikk galt da vi skulle laste budsjettene dine. Prøv igjen, eller send oss detaljene så vi kan hjelpe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis bij het laden van je budgetten. Probeer het opnieuw of stuur ons de details zodat we je kunnen helpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak przy ładowaniu budżetów. Spróbuj ponownie lub wyślij nam szczegóły, abyśmy mogli Ci pomóc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado ao carregar seus orçamentos. Tente novamente ou envie-nos os detalhes para que possamos ajudar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro ao carregar os teus orçamentos. Tenta novamente ou envia-nos os detalhes para podermos ajudar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva nu a funcționat la încărcarea bugetelor tale. Încearcă din nou sau trimite-ne detaliile pentru a te ajuta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При загрузке бюджетов произошла ошибка. Повторите попытку или отправьте нам сведения, чтобы мы могли помочь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niečo sa pokazilo pri načítavaní vašich rozpočtov. Skúste znova alebo nám pošlite podrobnosti, aby sme vám mohli pomôcť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något gick fel när budgetarna laddades. Försök igen eller skicka oss informationen så kan vi hjälpa till."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาดระหว่างการโหลดงบประมาณของคุณ ลองใหม่อีกครั้ง หรือส่งรายละเอียดให้เราเพื่อที่เราจะได้ช่วยเหลือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütçelerin yüklenirken bir şeyler ters gitti. Tekrar dene ya da ayrıntıları bize gönder, yardımcı olalım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час завантаження ваших бюджетів сталася помилка. Спробуйте ще раз або надішліть нам деталі, щоб ми змогли допомогти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có lỗi khi tải ngân sách của bạn. Thử lại hoặc gửi thông tin cho chúng tôi để chúng tôi có thể giúp bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载预算时出错。请重试，或将详情发送给我们以便帮助您。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入預算時出錯。請重試，或將詳情傳送給我們，以便我們協助您解決。"
          }
        }
      }
    },
    "containerFailure.email.body.intro": {
      "comment": "First sentence of the auto-filled email body shown when the user taps Send Feedback on the container-creation failure screen. Reassures them that no personal data is included.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على التطبيق فتح مستودع البيانات. سياق التشخيص (بدون بيانات شخصية):"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app no ha pogut obrir el teu emmagatzematge de dades. Context de diagnòstic (sense dades personals):"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace nemohla otevřít vaše úložiště dat. Diagnostické informace (bez osobních údajů):"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen kunne ikke åbne dit datalager. Diagnostiske oplysninger (uden personlige data):"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App konnte deinen Datenspeicher nicht öffnen. Diagnosekontexte (keine persönlichen Daten):"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή δεν μπόρεσε να ανοίξει το χώρο αποθήκευσης δεδομένων σας. Διαγνωστικό περιεχόμενο (χωρίς προσωπικά δεδομένα):"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app couldn't open your data store. Diagnostic context (no personal data):"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The app couldn't open your data store. Diagnostic context (no personal data):"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The app couldn't open your data store. Diagnostic context (no personal data):"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The app couldn't open your data store. Diagnostic context (no personal data):"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no ha podido abrir tu almacén de datos. Contexto de diagnóstico (sin datos personales):"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no pudo abrir tu almacén de datos. Contexto de diagnóstico (sin datos personales):"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus ei voinut avata tietovarastoa. Diagnostiikkatiedot (ei henkilökohtaisia tietoja):"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app n'a pas pu ouvrir votre magasin de données. Contexte de diagnostic (pas de données personnelles) :"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app n'a pas pu ouvrir ta banque de données. Contexte de diagnostic (aucune donnée personnelle) :"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה לא יכלה לפתוח את אחסון הנתונים שלך. הקשר אבחון (ללא נתונים אישיים):"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप आपके डेटा स्टोर को नहीं खोल सका। नैदानिक संदर्भ (कोई व्यक्तिगत डेटा नहीं):"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija nije mogla otvoriti vašu bazu podataka. Dijagnostički kontekst (bez osobnih podataka):"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazás nem tudta megnyitni az adattárat. Diagnosztikai adatok (személyes adatok nélkül):"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi tidak dapat membuka penyimpanan data Anda. Konteks diagnostik (tanpa data pribadi):"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app non ha potuto aprire il tuo archivio dati. Contesto diagnostico (senza dati personali):"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがデータストアを開くことができませんでした。診断情報（個人データは含まれません）："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 데이터 저장소를 열 수 없습니다. 진단 정보(개인 데이터 제외):"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl tidak dapat membuka simpanan data anda. Konteks diagnostik (tanpa data peribadi):"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen kunne ikke åpne datalagringsstedet ditt. Diagnostisk kontekst (ingen personlige data):"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app kon je gegevensopslag niet openen. Diagnostische context (geen persoonlijke gegevens):"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja nie mogła otworzyć magazynu danych. Kontekst diagnostyczny (bez danych osobowych):"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não conseguiu abrir seu armazenamento de dados. Contexto de diagnóstico (sem dados pessoais):"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A app não conseguiu abrir o armazenamento de dados. Contexto de diagnóstico (sem dados pessoais):"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația nu a putut deschide depozitul tău de date. Context de diagnostic (fără date personale):"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению не удалось открыть ваше хранилище данных. Диагностическая информация (без личных данных):"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácii sa nepodarilo otvoriť úložisko dát. Diagnostické informácie (žiadne osobné údaje):"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen kunde inte öppna datalager. Diagnostisk kontext (ingen personlig data):"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปไม่สามารถเปิดคลังข้อมูลของคุณ บริบทการวินิจฉัย (ไม่มีข้อมูลส่วนตัว):"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama veri deponuzu açamadı. Tanılama bağlamı (kişisel veri içermez):"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додаток не зміг відкрити ваше сховище даних. Діагностична інформація (без особистих даних):"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng không thể mở kho dữ liệu của bạn. Thông tin chẩn đoán (không có dữ liệu cá nhân):"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用无法打开您的数据存储。诊断信息（不包含个人数据）："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式無法開啟您的資料儲存。診斷資訊（不包含個人資料）："
          }
        }
      }
    },
    "containerFailure.email.body.prompt": {
      "comment": "Closing prompt at the end of the auto-filled email body on the container-failure surface, inviting the user to describe what was happening when the app couldn't open the data store.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرجاء وصف ما كان يحدث على جهازك عند بدء هذا الخطأ:"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si us plau, descriu què estava passant al teu dispositiu quan va començar:"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Popiš prosím, co se na tvém zařízení dělo, když tento problém začal:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv venligst, hvad der skete på din enhed, da problemet opstod:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte beschreibe, was auf deinem Gerät geschah, als dies begann:"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιγράψτε τι συνέβαινε στη συσκευή σας όταν ξεκίνησε αυτό:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please describe what was happening on your device when this started:"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Please describe what was happening on your device when this started:"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Please describe what was happening on your device when this started:"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Please describe what was happening on your device when this started:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, describe qué estaba sucediendo en tu dispositivo cuando empezó esto:"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor describe qué estaba pasando en tu dispositivo cuando esto comenzó:"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvaile, mitä tapahtui laitteelläsi, kun ongelma alkoi:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décris ce qui se passait sur ton appareil au moment où c'est arrivé :"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Décris ce qui se passait sur ton appareil au moment où ça a commencé :"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא תאר מה היה קורה במכשיר שלך כאשר זה התחיל:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया बताएं कि जब यह शुरू हुआ तो आपके डिवाइस पर क्या चल रहा था:"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opišite što se događalo na vašem uređaju kada je ovo počelo:"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérjük, írd le, mit csináltál az eszközödön, amikor ez a hiba lépett fel:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harap jelaskan apa yang sedang terjadi di perangkat Anda saat masalah ini dimulai:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favore descrivi che cosa stavi facendo sul tuo dispositivo quando questo è iniziato:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この問題が発生したときにデバイスで何をしていたかを説明してください："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문제가 발생했을 때 기기에서 어떤 작업을 하고 있었는지 알려주세요:"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila terangkan apa yang sedang berlaku di peranti anda apabila ini bermula:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær så god og beskriv hva som skjedde på enheten din da problemet startet:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf wat er op je apparaat aan de hand was toen dit begon:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz, co działo się na urządzeniu, gdy problem się pojawił:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva o que estava acontecendo no seu dispositivo quando isso começou:"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreve o que estava a acontecer no teu dispositivo quando isto começou:"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrie te rog ce se întâmpla pe dispozitivul tău când a început:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опиши, что происходило на устройстве, когда это началось:"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosím opíšte, čo sa dialo na vašom zariadení, keď sa to začalo:"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv vad som hände på din enhet när detta började:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดอธิบายว่าอุปกรณ์ของคุณกำลังทำอะไรอยู่เมื่อเกิดปัญหานี้:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sorun başladığında cihazında neler olduğunu açıkla:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, опишіть, що відбувалося на вашому пристрої, коли це почалося:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng mô tả những gì đang xảy ra trên thiết bị của bạn khi điều này bắt đầu:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请描述您的设备上发生此问题时的情况："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請描述當應用程式無法開啟資料儲存時，您的裝置上發生了什麼："
          }
        }
      }
    },
