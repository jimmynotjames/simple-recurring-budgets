    "settings.iCloud.unavailable.accessibilityLabel": {
      "comment": "VoiceOver label for the iCloud unavailable status row",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud غير متاح. سجّل الدخول إلى iCloud من الإعدادات لمزامنة ميزانياتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no disponible. Inicia sessió a iCloud des de Configuració per sincronitzar els pressupostos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud není dostupný. Přihlaste se do iCloud v Nastavení, abyste synchronizovali své rozpočty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ikke tilgængelig. Log ind på iCloud i Indstillinger for at synkronisere dine budgetter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud nicht verfügbar. Melde dich in den Einstellungen bei iCloud an, um deine Budgets zu synchronisieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το iCloud δεν είναι διαθέσιμο. Συνδεθείτε στο iCloud μέσω των Ρυθμίσεων για να συγχρονίσετε τους προϋπολογισμούς σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud not available. Sign in to iCloud in Settings to sync your budgets."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud not available. Sign in to iCloud in Settings to sync your budgets."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud not available. Sign in to iCloud in Settings to sync your budgets."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud not available. Sign in to iCloud in Settings to sync your budgets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no disponible. Inicia sesión en iCloud en Ajustes para sincronizar tus presupuestos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no disponible. Inicia sesión en iCloud en Configuración para sincronizar tus presupuestos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ei saatavilla. Kirjaudu iCloudiin Asetuksissa synkronoidaksesi budjettisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud non disponible. Connecte-toi à iCloud dans Réglages pour synchroniser tes budgets."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud non disponible. Connecte-toi à iCloud dans les réglages pour synchroniser tes budgets."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud אינו זמין. היכנס ל-iCloud בהגדרות כדי לסנכרן את התקציבים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud उपलब्ध नहीं। अपने बजट सिंक करने के लिए Settings में iCloud में साइन इन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud nije dostupan. Prijavite se na iCloud u Postavkama za sinkronizaciju proračuna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud nem érhető el. Jelentkezz be az iCloud-ba a Beállításokban a költségvetéseid szinkronizálásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud tidak tersedia. Masuk ke iCloud di Pengaturan untuk menyinkronkan anggaran kamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud non disponibile. Accedi a iCloud nelle Impostazioni per sincronizzare i tuoi budget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudは利用できません。設定でiCloudにサインインして予算を同期してください。"
          }
        },
        "ko": {
