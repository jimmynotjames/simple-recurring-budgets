    "budgetDetail.menu.resetCarryOver.accessibilityHint": {
      "comment": "VoiceOver hint for the Reset Carry-Over menu item, communicating the destructive (but non-cascading) consequence",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسح رصيد Carry-Over ويجعله صفرًا. لا تتأثر النفقات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Esborra el saldo de Carry-Over a zero. Les despeses no es veuran afectades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vynuluje zůstatek carry-over na nulu. Výdaje nejsou ovlivněny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulstiller carry-over-saldoen til nul. Udgifter påvirkes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt den Carry-Over-Saldo auf null zurück. Ausgaben sind nicht betroffen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει το υπόλοιπο Carry-Over στο μηδέν. Οι δαπάνες δεν επηρεάζονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears the carry-over balance to zero. Expenses are not affected."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears the carry-over balance to zero. Expenses are not affected."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears the carry-over balance to zero. Expenses are not affected."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears the carry-over balance to zero. Expenses are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece el saldo de Carry-Over a cero. Los gastos no se ven afectados."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece el saldo de Carry-Over en cero. Los gastos no se ven afectados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nollaa käyttämätön saldo nollaan. Kulut eivät muutu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet le solde Carry-Over à zéro. Les dépenses ne sont pas affectées."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface le solde Carry-Over à zéro. Les dépenses ne sont pas modifiées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוחק את יתרת ה-Carry-Over לאפס. ההוצאות לא מושפעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Carry-Over बैलेंस को शून्य पर सेट करता है। खर्च प्रभावित नहीं होते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Briše Carry-Over saldo na nulu. Rashodi nisu zahvaćeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Carry-Over egyenleget nullázza. A kiadások nem érintettek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus saldo carry-over menjadi nol. Pengeluaran tidak terpengaruh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella il saldo Carry-Over a zero. Le spese non vengono modificate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Carry-Overの残高をゼロにクリアします。支出は影響を受けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Carry-Over 잔액을 0으로 초기화합니다. 지출은 영향을 받지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapuskan baki Carry-Over kepada sifar. Perbelanjaan tidak terjejas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tømmer Carry-Over-saldoen til null. Utgifter påvirkes ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wist het Carry-Over-saldo naar nul. Uitgaven worden niet beïnvloed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeruje saldo Carry-Over. Wydatki nie są objęte zmianami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa o saldo de carry-over para zero. As despesas não são afetadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa o saldo do Carry-Over para zero. As despesas não são afetadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge soldul Carry-Over la zero. Cheltuielile nu sunt afectate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнуляет остаток Carry-Over. Расходы не затрагиваются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymaže zostatok Carry-Over na nulu. Výdavky nie sú ovplyvnené."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställer Carry-Over-saldot till noll. Utgifter påverkas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างยอด Carry-Over เป็นศูนย์ ค่าใช้จ่ายจะไม่ได้รับผลกระทบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Carry-Over bakiyesini sıfıra ayarlar. Giderler etkilenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скидає баланс Carry-Over до нуля. Витрати не змінюються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa số dư Carry-Over về 0. Các khoản chi không bị ảnh hưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将结转余额清零。不影响开支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將結餘清除為零。費用不受影響。"
          }
        }
      }
    },
