    "settings.analytics.toggle.accessibilityHint": {
      "comment": "VoiceOver hint for the analytics opt-in toggle in Settings",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح للتطبيق بإرسال بيانات استخدام مجهولة للمساعدة في تحسينه. لا تُضمَّن أي تفاصيل مصروفات أو معرّفات iCloud أو معلومات شخصية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que l'app enviï dades d'ús anònimes per ajudar a millorar-la. Mai s'inclouen detalls de despeses, identificadors d'iCloud ni informació personal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje aplikaci odesílat anonymní data o využití pro zlepšení aplikace. Nikdy nejsou zahrnuty podrobnosti o výdajích, identifikátory iCloud ani osobní informace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillader appen at sende anonyme brugsdata for at hjælpe med at forbedre appen. Udgiftsoplysninger, iCloud-identifikatorer eller personlige oplysninger medtages aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht der App das Senden anonymer Nutzungsdaten zur App-Verbesserung. Ausgabendetails, iCloud-Kennungen oder persönliche Informationen werden nie übertragen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέπει στην εφαρμογή να αποστέλλει ανώνυμα δεδομένα χρήσης για τη βελτίωσή της. Δεν συμπεριλαμβάνονται ποτέ λεπτομέρειες εξόδων, αναγνωριστικά iCloud ή προσωπικές πληροφορίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows the app to send anonymous usage data to help improve the app. No expense details, iCloud identifiers, or personal information are ever included."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows the app to send anonymous usage data to help improve the app. No expense details, iCloud identifiers, or personal information are ever included."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows the app to send anonymous usage data to help improve the app. No expense details, iCloud identifiers, or personal information are ever included."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows the app to send anonymous usage data to help improve the app. No expense details, iCloud identifiers, or personal information are ever included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que la app envíe datos de uso anónimos para ayudar a mejorar la app. Nunca se incluyen detalles de gastos, identificadores de iCloud ni información personal."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que la app envíe datos de uso anónimos para ayudar a mejorarla. Nunca se incluyen detalles de gastos, identificadores de iCloud ni información personal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sallii sovelluksen lähettää anonyymiä käyttötietoa sovelluksen kehittämiseksi. Kulutietoja, iCloud-tunnisteita tai henkilökohtaisia tietoja ei koskaan sisällytetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise l'app à envoyer des données d'utilisation anonymes pour améliorer l'app. Les détails des dépenses, identifiants iCloud et informations personnelles ne sont jamais inclus."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à l'app d'envoyer des données d'utilisation anonymes pour aider à l'améliorer. Aucun détail de dépense, identifiant iCloud ou renseignement personnel n'est jamais inclus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאפשר לאפליקציה לשלוח נתוני שימוש אנונימיים לשיפור האפליקציה. פרטי הוצאות, מזהי iCloud או מידע אישי אינם נכללים לעולם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप को ऐप सुधारने में मदद के लिए अनाम उपयोग डेटा भेजने की अनुमति देता है। इसमें कभी भी खर्च की जानकारी, iCloud पहचानकर्ता या व्यक्तिगत जानकारी शामिल नहीं होती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopušta aplikaciji slanje anonimnih podataka o korištenju radi poboljšanja aplikacije. Detalji troškova, iCloud identifikatori ni osobni podaci nikada nisu uključeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehetővé teszi, hogy az alkalmazás névtelen használati adatokat küldjön a fejlesztés elősegítése érdekében. Soha nem tartalmaz kiadási adatokat, iCloud azonosítókat vagy személyes információkat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengizinkan aplikasi mengirimkan data penggunaan anonim untuk membantu meningkatkan aplikasi. Detail pengeluaran, identifier iCloud, atau informasi pribadi tidak pernah disertakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente all'app di inviare dati di utilizzo anonimi per migliorare l'app. Non vengono mai inclusi dettagli sulle spese, identificatori iCloud o informazioni personali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが匿名の使用データを送信し、改善に役立てることを許可します。支出の詳細、iCloudの識別子、個人情報は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 익명 사용 데이터를 전송하여 앱 개선에 도움을 줄 수 있도록 허용합니다. 지출 세부 정보, iCloud 식별자 또는 개인 정보는 포함되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membenarkan aplikasi menghantar data penggunaan tanpa nama untuk membantu menambah baik aplikasi. Tiada butiran perbelanjaan, pengecam iCloud, atau maklumat peribadi yang akan disertakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar appen sende anonym bruksdata for å hjelpe med å forbedre appen. Utgiftsdetaljer, iCloud-identifikatorer eller personlig informasjon inkluderes aldri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee kan de app anonieme gebruiksgegevens verzenden om de app te verbeteren. Er worden nooit uitgavendetails, iCloud-identificatoren of persoonlijke informatie meegestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala aplikacji wysyłać anonimowe dane użytkowania w celu jej ulepszania. Szczegóły wydatków, identyfikatory iCloud ani dane osobowe nigdy nie są uwzględniane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o app envie dados de uso anônimos para ajudar a melhorá-lo. Nenhum detalhe de despesa, identificador iCloud ou informação pessoal é incluído."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que a app envie dados de utilização anónimos para ajudar a melhorá-la. Nunca são incluídos detalhes de despesas, identificadores iCloud ou informações pessoais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite aplicației să trimită date anonime de utilizare pentru a ajuta la îmbunătățirea aplicației. Nu sunt incluse niciodată detalii despre cheltuieli, identificatori iCloud sau informații personale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет приложению отправлять анонимные данные об использовании для его улучшения. Данные о расходах, идентификаторы iCloud и личная информация никогда не включаются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje aplikácii odosielať anonymné údaje o používaní na zlepšenie aplikácie. Nikdy nie sú zahrnuté podrobnosti o výdavkoch, identifikátory iCloud ani osobné informácie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåter appen att skicka anonym användningsdata för att hjälpa till att förbättra appen. Inga utgiftsdetaljer, iCloud-identifierare eller personlig information inkluderas någonsin."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้แอปส่งข้อมูลการใช้งานแบบไม่ระบุตัวตนเพื่อช่วยพัฒนาแอป ไม่มีรายละเอียดรายจ่าย ตัวระบุ iCloud หรือข้อมูลส่วนบุคคลรวมอยู่ด้วยเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın geliştirilmesine yardımcı olmak için anonim kullanım verisi göndermesine izin verir. Gider ayrıntıları, iCloud tanımlayıcıları veya kişisel bilgiler hiçbir zaman dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяє додатку надсилати анонімні дані про використання для покращення роботи. Деталі витрат, ідентифікатори iCloud та особиста інформація ніколи не включаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép ứng dụng gửi dữ liệu sử dụng ẩn danh để giúp cải thiện ứng dụng. Không bao gồm chi tiết khoản chi tiêu, mã định danh iCloud hay thông tin cá nhân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许应用发送匿名使用数据以帮助改善应用。不包含任何支出详情、iCloud 标识符或个人信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 App 傳送匿名使用資料，以協助改善 App。絕不包含支出明細、iCloud 識別資訊或個人資訊。"
          }
        }
      }
    },
    "settings.analytics.toggle.footer": {
      "comment": "Footer below the analytics opt-in toggle. Discloses what is/is not transmitted (§5 analytics-spec.md). budget_name and budget_allocation_amount are accepted-risk exceptions. Mentions that the locale-based default can be changed.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تساعد بيانات الاستخدام المجهولة في استكشاف المشكلات وفهم طريقة الاستخدام. ما يُضمَّن: إعدادات الميزانية مثل الفترة الزمنية، ورمز العملة، وتشغيل/إيقاف Carry-Over، ومبلغ التخصيص، وما إلى ذلك. ما لا يُضمَّن أبداً: أسماء المصروفات، والمبالغ، والتواريخ، وأي معرّفات Apple/iCloud، وأي ملاحظات نصية أو معلومات شخصية. تم اختيار الإعداد الأولي تلقائياً استناداً إلى منطقة جهازك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dades d'ús anònimes ajuden a diagnosticar problemes i entendre l'ús. Què s'inclou: la configuració del pressupost, com ara el període, el codi de moneda, el Carry-Over activat/desactivat, l'import assignat, etc. Què mai s'inclou: noms de despeses, imports, dates, cap identificador d'Apple/iCloud, cap nota de text lliure ni informació personal. La configuració inicial es va triar automàticament en funció de la regió del dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymní data o využití pomáhají řešit problémy a lépe rozumět způsobu používání. Co je zahrnuto: nastavení rozpočtu jako období, kód měny, Carry-Over zapnuto/vypnuto, výše alokace apod. Co není nikdy zahrnuto: názvy výdajů, částky, data, jakékoliv identifikátory Apple/iCloud, volné poznámky ani osobní informace. Výchozí nastavení bylo zvoleno automaticky podle oblasti vašeho zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme brugsdata hjælper med at løse problemer og forstå brugen. Hvad der medtages: budgetindstillinger som periode, valutakode, Carry-Over til/fra, allokeringsbeløb og lignende. Hvad der aldrig medtages: udgiftsnavne, beløb, datoer, Apple/iCloud-identifikatorer, fritekstnoter eller personlige oplysninger. Den indledende indstilling blev automatisk valgt baseret på din enheds region."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme Nutzungsdaten helfen dabei, Probleme zu beheben und die Nutzung besser zu verstehen. Enthalten: Budgeteinstellungen wie Zeitraum, Währungscode, Carry-Over ein/aus, Zuweisungsbetrag usw. Nie enthalten: Ausgabennamen, -beträge, -daten, Apple/iCloud-Kennungen, Freitextnotizen oder persönliche Informationen. Die anfängliche Einstellung wurde automatisch anhand der Region deines Geräts gewählt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ανώνυμα δεδομένα χρήσης βοηθούν στην αντιμετώπιση προβλημάτων και στην κατανόηση της χρήσης. Τι συμπεριλαμβάνεται: Ρυθμίσεις προϋπολογισμού όπως η περίοδος, ο κωδικός νομίσματος, το Carry-Over ενεργό/ανενεργό, το ποσό κατανομής, κ.λπ. Τι δεν συμπεριλαμβάνεται ποτέ: Ονόματα εξόδων, ποσά, ημερομηνίες, αναγνωριστικά Apple/iCloud, σημειώσεις ελεύθερου κειμένου ή προσωπικές πληροφορίες. Η αρχική ρύθμιση επιλέχθηκε αυτόματα με βάση την περιοχή της συσκευής σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous usage data helps troubleshoot issues and understand usage. What’s included: Budget settings like period, currency code, carry-over on/off, allocation amount, and so on. What’s never included: Expense names, amounts, dates, any Apple/iCloud identifiers, any free-text notes or personal information. The initial setting was chosen automatically based on your device’s region."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous usage data helps troubleshoot issues and understand usage. What's included: Budget settings like period, currency code, carry-over on/off, allocation amount, and so on. What's never included: Expense names, amounts, dates, any Apple/iCloud identifiers, any free-text notes or personal information. The initial setting was chosen automatically based on your device's region."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous usage data helps troubleshoot issues and understand usage. What's included: Budget settings like period, currency code, carry-over on/off, allocation amount, and so on. What's never included: Expense names, amounts, dates, any Apple/iCloud identifiers, any free-text notes or personal information. The initial setting was chosen automatically based on your device's region."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous usage data helps troubleshoot issues and understand usage. What's included: Budget settings like period, currency code, carry-over on/off, allocation amount, and so on. What's never included: Expense names, amounts, dates, any Apple/iCloud identifiers, any free-text notes or personal information. The initial setting was chosen automatically based on your device's region."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de uso anónimos ayudan a resolver problemas y entender el uso. Qué se incluye: ajustes del presupuesto como el periodo, el código de divisa, Carry-Over activado/desactivado, el importe asignado, etc. Qué nunca se incluye: nombres de gastos, importes, fechas, ningún identificador de Apple/iCloud, notas de texto libre ni información personal. La configuración inicial se eligió automáticamente según la región de tu dispositivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de uso anónimos ayudan a solucionar problemas y entender cómo se usa la app. Qué se incluye: configuraciones del presupuesto como el período, el código de divisa, Carry-Over activado/desactivado, el monto asignado, entre otros. Qué nunca se incluye: nombres de gastos, montos, fechas, ningún identificador de Apple/iCloud, notas de texto libre ni información personal. La configuración inicial se eligió automáticamente según la región de tu dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyymi käyttötieto auttaa vianhaussa ja käytön ymmärtämisessä. Mukana: budjettiasetukset kuten kausi, valuuttakoodi, Carry-Over käytössä/ei ja kohdentamissumma. Ei koskaan mukana: kulunimikkeitä, summia, päivämääriä, Apple- tai iCloud-tunnisteita, vapaatekstejä tai henkilökohtaisia tietoja. Alkuasetus valittiin automaattisesti laitteesi alueen perusteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données d'utilisation anonymes aident à résoudre les problèmes et à comprendre l'utilisation. Ce qui est inclus : paramètres de budget tels que la période, le code devise, le Carry-Over activé/désactivé, le montant alloué, etc. Ce qui n'est jamais inclus : noms des dépenses, montants, dates, identifiants Apple/iCloud, notes ou informations personnelles. Le réglage initial a été choisi automatiquement selon la région de votre appareil."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données d'utilisation anonymes aident à diagnostiquer les problèmes et à comprendre l'utilisation. Ce qui est inclus : les paramètres de budget comme la période, le code de devise, l'activation ou désactivation du Carry-Over, le montant alloué, etc. Ce qui n'est jamais inclus : les noms, montants et dates des dépenses, les identifiants Apple/iCloud, les notes ou renseignements personnels. Le réglage initial a été choisi automatiquement en fonction de la région de votre appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתוני שימוש אנונימיים מסייעים בפתרון בעיות ובהבנת דפוסי שימוש. מה כלול: הגדרות תקציב כמו תקופה, קוד מטבע, Carry-Over פועל/כבוי, סכום הקצאה וכן הלאה. מה לא כלול לעולם: שמות הוצאות, סכומים, תאריכים, כל מזהי Apple‏/iCloud, הערות חופשיות או מידע אישי. ההגדרה הראשונית נבחרה אוטומטית בהתאם לאזור המכשיר שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनाम उपयोग डेटा समस्याओं को सुलझाने और उपयोग को समझने में मदद करता है। क्या शामिल है: बजट सेटिंग्स जैसे अवधि, मुद्रा कोड, Carry-Over चालू/बंद, आवंटन राशि आदि। क्या कभी शामिल नहीं होता: खर्च के नाम, राशियाँ, तारीखें, कोई भी Apple/iCloud पहचानकर्ता, कोई भी मुक्त-पाठ नोट या व्यक्तिगत जानकारी। प्रारंभिक सेटिंग आपके डिवाइस के क्षेत्र के आधार पर स्वचालित रूप से चुनी गई थी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonimni podaci o korištenju pomažu u rješavanju problema i razumijevanju korištenja. Što je uključeno: postavke proračuna poput razdoblja, koda valute, Carry-Over uključeno/isključeno, iznosa dodjele i slično. Što nikada nije uključeno: nazivi troškova, iznosi, datumi, identifikatori Apple/iCloud, slobodni tekstualni zapisi ni osobni podaci. Početna postavka odabrana je automatski na temelju regije uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A névtelen használati adatok segítenek a problémák elhárításában és a használat megértésében. Ami belekerül: költségvetés-beállítások, például az időszak, a pénznemkód, a Carry-Over be/ki, a keretösszeg és így tovább. Ami soha nem kerül bele: kiadások neve, összege, dátuma, Apple/iCloud azonosítók, szabad szöveges megjegyzések vagy személyes adatok. A kezdeti beállítást az eszköz régiója alapján határoztuk meg automatikusan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data penggunaan anonim membantu memecahkan masalah dan memahami penggunaan. Yang disertakan: Pengaturan anggaran seperti periode, kode mata uang, Carry-Over aktif/nonaktif, jumlah alokasi, dan sebagainya. Yang tidak pernah disertakan: Nama pengeluaran, jumlah, tanggal, identifier Apple/iCloud apa pun, catatan teks bebas atau informasi pribadi apa pun. Pengaturan awal dipilih secara otomatis berdasarkan wilayah perangkat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di utilizzo anonimi aiutano a risolvere i problemi e comprendere l'utilizzo. Cosa è incluso: impostazioni del budget come periodo, codice valuta, Carry-Over attivo/disattivo, importo allocato e così via. Cosa non è mai incluso: nomi delle spese, importi, date, identificatori Apple/iCloud, note in formato libero o informazioni personali. L'impostazione iniziale è stata scelta automaticamente in base alla regione del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名の使用データは、問題のトラブルシューティングや使用状況の把握に役立ちます。含まれるデータ：期間、通貨コード、Carry-Overのオン/オフ、配分金額などの予算設定。含まれないデータ：支出の名称、金額、日付、AppleまたはiCloudの識別子、フリーテキストのメモや個人情報。初期設定はデバイスの地域に基づいて自動的に選択されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익명 사용 데이터는 문제 해결 및 앱 사용 현황 파악에 도움이 됩니다. 포함되는 정보: 예산 기간, 통화 코드, Carry-Over 켜기/끄기, 배정 금액 등 예산 설정. 포함되지 않는 정보: 지출 이름, 금액, 날짜, Apple/iCloud 식별자, 자유 입력 메모 또는 개인 정보. 초기 설정은 기기의 지역을 기반으로 자동으로 선택되었습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data penggunaan tanpa nama membantu menyelesaikan masalah dan memahami penggunaan. Yang disertakan: Tetapan belanjawan seperti tempoh, kod mata wang, Carry-Over hidup/mati, jumlah peruntukan, dan sebagainya. Yang tidak pernah disertakan: Nama perbelanjaan, jumlah, tarikh, sebarang pengecam Apple/iCloud, sebarang nota teks bebas atau maklumat peribadi. Tetapan awal dipilih secara automatik berdasarkan rantau peranti anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonym bruksdata hjelper med feilsøking og forståelse av bruken. Hva som inkluderes: Budsjettinnstillinger som periode, valutakode, Carry-Over av/på, beløp og lignende. Hva som aldri inkluderes: Utgiftsnavn, beløp, datoer, Apple/iCloud-identifikatorer, fritekstnotater eller personlig informasjon. Den opprinnelige innstillingen ble valgt automatisk basert på enhetens region."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonieme gebruiksgegevens helpen bij het oplossen van problemen en het begrijpen van gebruik. Wat is inbegrepen: budgetinstellingen zoals periode, valutacode, Carry-Over aan/uit, toewijzingsbedrag, enzovoort. Wat nooit is inbegrepen: namen van uitgaven, bedragen, datums, Apple/iCloud-identificatoren, vrije notities of persoonlijke informatie. De begininstelling is automatisch gekozen op basis van de regio van je apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonimowe dane użytkowania pomagają w rozwiązywaniu problemów i rozumieniu sposobu użytkowania. Co jest uwzględniane: ustawienia budżetu, takie jak okres, kod waluty, Carry-Over włączony/wyłączony, kwota alokacji itp. Co nigdy nie jest uwzględniane: nazwy wydatków, kwoty, daty, żadne identyfikatory Apple/iCloud, notatki ani dane osobowe. Ustawienie początkowe zostało wybrane automatycznie na podstawie regionu urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados de uso anônimos ajudam a identificar problemas e entender o uso do app. O que é incluído: configurações de orçamento como período, código de moeda, Carry-Over ativado/desativado, valor de alocação, entre outros. O que nunca é incluído: nomes de despesas, valores, datas, identificadores Apple/iCloud, notas de texto livre ou informações pessoais. A configuração inicial foi escolhida automaticamente com base na região do seu dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de utilização anónimos ajudam a resolver problemas e a compreender o uso. O que está incluído: definições do orçamento como período, código de moeda, Carry-Over ativado/desativado, montante da verba, entre outros. O que nunca está incluído: nomes de despesas, montantes, datas, quaisquer identificadores Apple/iCloud, notas de texto livre ou informações pessoais. A definição inicial foi escolhida automaticamente com base na região do dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele anonime de utilizare ajută la depanarea problemelor și la înțelegerea utilizării. Ce este inclus: setări de buget precum perioada, codul valutei, Carry-Over activat/dezactivat, suma alocată și altele. Ce nu este inclus niciodată: numele cheltuielilor, sumele, datele, niciun identificator Apple/iCloud, nicio notă liberă sau informație personală. Setarea inițială a fost aleasă automat în funcție de regiunea dispozitivului tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонимные данные об использовании помогают устранять проблемы и анализировать работу приложения. Что включается: настройки бюджета, такие как период, код валюты, состояние Carry-Over (вкл./выкл.), сумма распределения и т. д. Что никогда не включается: названия расходов, суммы, даты, идентификаторы Apple/iCloud, свободный текст или личная информация. Начальная настройка была выбрана автоматически на основе региона вашего устройства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymné údaje o používaní pomáhajú pri riešení problémov a pochopení toho, ako aplikáciu ľudia používajú. Čo je zahrnuté: nastavenia rozpočtu, ako sú obdobie, kód meny, zapnutie/vypnutie Carry-Over, výška prídelu a podobne. Čo nie je nikdy zahrnuté: názvy ani výšky výdavkov, dátumy, žiadne identifikátory Apple/iCloud, žiadne poznámky ani osobné informácie. Počiatočné nastavenie bolo zvolené automaticky na základe regiónu vášho zariadenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonym användningsdata hjälper till med felsökning och förståelse av användningsmönster. Vad som inkluderas: Budgetinställningar som period, valutakod, Carry-Over av/på, allokeringsbelopp och liknande. Vad som aldrig inkluderas: Utgiftsnamn, belopp, datum, Apple/iCloud-identifierare, fritextanteckningar eller personlig information. Den initiala inställningen valdes automatiskt baserat på enhetens region."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลการใช้งานแบบไม่ระบุตัวตนช่วยแก้ไขปัญหาและทำความเข้าใจการใช้งาน ข้อมูลที่รวมอยู่: การตั้งค่างบประมาณ เช่น รอบเวลา รหัสสกุลเงิน การเปิด/ปิด Carry-Over จำนวนเงินที่จัดสรร และอื่นๆ ข้อมูลที่ไม่รวม: ชื่อรายจ่าย จำนวนเงิน วันที่ ตัวระบุ Apple/iCloud ใดๆ บันทึกข้อความอิสระหรือข้อมูลส่วนบุคคล การตั้งค่าเริ่มต้นถูกเลือกโดยอัตโนมัติตามภูมิภาคของอุปกรณ์คุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonim kullanım verileri sorunları gidermeye ve kullanımı anlamaya yardımcı olur. Dahil olanlar: Dönem, para birimi kodu, carry-over açık/kapalı, tahsis tutarı gibi bütçe ayarları. Hiçbir zaman dahil edilmeyenler: Gider adları, tutarlar, tarihler, Apple/iCloud tanımlayıcıları, serbest metin notlar veya kişisel bilgiler. İlk ayar cihazının bölgesine göre otomatik seçildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонімні дані про використання допомагають виявляти проблеми та розуміти використання. Що включається: налаштування бюджету, як-от період, код валюти, Carry-Over увімк./вимк., сума виділення тощо. Що ніколи не включається: назви витрат, суми, дати, будь-які ідентифікатори Apple/iCloud, вільний текст чи особиста інформація. Початкове налаштування було вибрано автоматично на основі регіону вашого пристрою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu sử dụng ẩn danh giúp khắc phục sự cố và hiểu cách sử dụng. Những gì được bao gồm: cài đặt ngân sách như kỳ, mã tiền tệ, Carry-Over bật/tắt, số tiền phân bổ, v.v. Những gì không bao giờ được bao gồm: Tên khoản chi tiêu, số tiền, ngày tháng, bất kỳ mã định danh Apple/iCloud nào, ghi chú tự do hoặc thông tin cá nhân. Cài đặt ban đầu được chọn tự động dựa trên vùng của thiết bị bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名使用数据有助于排查问题并了解使用情况。包含内容：预算设置（如周期、货币代码、Carry-Over 开关状态、分配金额等）。不包含内容：支出名称、金额、日期、任何 Apple/iCloud 标识符、任何文字备注或个人信息。初始设置已根据您设备所在地区自动选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名使用資料有助於排查問題並了解使用情況。共享內容：預算設定，如週期、貨幣代碼、Carry-Over 開關、配額金額等。絕不共享：消費名稱、金額、日期、任何 Apple／iCloud 識別資訊，以及任何自由輸入的備註或個人資料。初始設定已依據裝置所在地區自動選擇。"
          }
        }
      }
    },
