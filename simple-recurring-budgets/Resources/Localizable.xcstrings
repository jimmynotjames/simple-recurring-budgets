    "budgetDetail.menu.resetBudget.accessibilityHint": {
      "comment": "VoiceOver hint for the destructive Reset Budget menu item, communicating the irreversible consequence",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف جميع النفقات لهذه الميزانية نهائيًا، ويعيد Carry-Over إلى الصفر، ويستأنف الميزانية إن كانت موقوفة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentment totes les despeses d'aquest pressupost, restableix el Carry-Over a zero i reprèn el pressupost si està en pausa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvale smaže všechny výdaje tohoto rozpočtu, vynuluje přenesený zůstatek a obnoví rozpočet, pokud je pozastaven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter permanent alle udgifter for dette budget, nulstiller carry-over til nul og genoptager budgettet, hvis det er sat på pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht alle Ausgaben für dieses Budget dauerhaft, setzt den Carry-Over auf null zurück und setzt das Budget fort, falls es pausiert ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει οριστικά όλα τα έξοδα αυτού του προϋπολογισμού, μηδενίζει το Carry-Over και συνεχίζει τον προϋπολογισμό αν είναι σε παύση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes every expense for this budget, resets carry-over to zero, and resumes the budget if it is paused."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes every expense for this budget, resets carry-over to zero, and resumes the budget if it is paused."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes every expense for this budget, resets carry-over to zero, and resumes the budget if it is paused."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes every expense for this budget, resets carry-over to zero, and resumes the budget if it is paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente todos los gastos de este presupuesto, restablece el saldo acumulado a cero y reanuda el presupuesto si está pausado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente todos los gastos de este presupuesto, restablece el Carry-Over a cero y lo reanuda si está pausado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa pysyvästi kaikki tämän budjetin kulut, nollaa Carry-Overin ja jatkaa budjettia, jos se on tauolla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement toutes les dépenses de ce budget, réinitialise le solde reporté à zéro et reprend le budget s'il est en pause."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement toutes les dépenses de ce budget, réinitialise le Carry-Over à zéro et reprend le budget s'il est suspendu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוחק לצמיתות כל הוצאה בתקציב זה, מאפס את היתרה המובאה לאפס, וחוזר לתקציב אם הוא הושהה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बजट के सभी खर्चों को स्थायी रूप से हटाता है, आगे ले जाई गई राशि को शून्य में रीसेट करता है, और यदि बजट रोका गया है, तो इसे फिर से चालू करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajno briše sve troškove za ovaj proračun, poništava Carry-Over na nulu i nastavlja proračun ako je pauziran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Véglegesen törli az összes kiadást ehhez a költségkerethez, a Carry-Over értékét nullára állítja, és folytatja a költségkeretet, ha szüneteltetve van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus semua pengeluaran untuk anggaran ini secara permanen, mengatur ulang Carry-Over ke nol, dan melanjutkan anggaran jika sedang dijeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente tutte le spese per questo budget, azzera il Carry-Over e riprende il budget se è sospeso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この予算のすべての支出を完全に削除し、繰越額をゼロにリセットして、一時停止中の場合は予算を再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 예산의 모든 지출을 영구적으로 삭제하고, 이월액을 0으로 초기화하며, 일시 중지된 예산을 재개합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadam kekal semua perbelanjaan untuk bajet ini, menetapkan semula Carry-Over kepada sifar, dan menyambung semula bajet jika ia dijeda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter alle utgifter for dette budsjettet permanent, nullstiller Carry-Over til null og gjenopptar budsjettet hvis det er på pause."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert permanent alle uitgaven voor dit budget, zet de carry-over terug naar nul en hervat het budget als het gepauzeerd is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usuwa wszystkie wydatki z tego budżetu, resetuje Carry-Over do zera i wznawia budżet, jeśli jest wstrzymany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui permanentemente todas as despesas deste orçamento, redefine o Carry-Over para zero e retoma o orçamento se estiver pausado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente todas as despesas deste orçamento, repõe o saldo a zero e retoma o orçamento se estiver pausado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge definitiv toate cheltuielile acestui buget, resetează Carry-Over la zero și reia bugetul dacă este întrerupt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Навсегда удаляет все расходы по этому бюджету, сбрасывает Carry-Over до нуля и возобновляет бюджет, если он приостановлен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrvalo vymaže všetky výdavky tohto rozpočtu, vynuluje Carry-Over na nulu a obnoví rozpočet, ak je pozastavený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar permanent bort alla utgifter för den här budgeten, återställer carry-over till noll och återupptar budgeten om den är pausad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบรายการค่าใช้จ่ายทั้งหมดของงบประมาณนี้อย่างถาวร รีเซ็ตยอดเงินที่นำไปยังงวดถัดไปเป็นศูนย์ และเริ่มทำงานของงบประมาณอีกครั้งหากหยุดชั่วคราวอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bütçenin tüm harcamalarını kalıcı olarak siler, bakiyeyi sıfırlar ve duraklatılmışsa bütçeyi devam ettirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаточно видаляє всі витрати цього бюджету, скидає carry-over до нуля та відновлює бюджет, якщо він на паузі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa vĩnh viễn tất cả chi phí cho ngân sách này, đặt lại số dư chuyển tiếp về 0 và tiếp tục ngân sách nếu nó đang tạm dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除此预算的所有支出，将结转余额重置为零，如预算已暂停则恢复预算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除此預算的所有支出、將結餘結轉重設為零，以及若預算已暫停將恢復執行。"
          }
        }
      }
    },
