        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅವಧಿಗಳಾದ್ಯಂತ ಸಂಚಿತ ಮೀರಿದ ಮತ್ತು ಅತ್ಯಲ್ಪ ಖರ್ಚಾಗತಿಕೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기간별 초과 및 미달 지출이 누적 적용됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാലയളവുകളിലുടനീളം ജമയായി അമിതവ്യയവും കുറവ്വ്യയവും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कालावधींमध्ये संचयी अधिक आणि कमी खर्च."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah lebih dan kurang belanja terkumpul merentas tempoh."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumulativ over- og underskudd over flere perioder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumulatieve over- en onderspending over periodes."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅବଧି ଜୁଡ଼ି ଅଳ୍ପ ଓ ବାହୁଲ୍ୟ ଖର୍ଚ୍ଚ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਿਆਦਾਂ ਭਰ ਜਮ ਹੋਈ ਜਾਂ ਘਾਟੇ ਵਾਲੀ ਖਰਚ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skumulowane nadwyżki i niedobory między okresami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastos acima ou abaixo do orçamento acumulados entre períodos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumulativo de gastos a mais e a menos ao longo dos períodos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheltuielile și economiile se acumulează între perioade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накопленный перерасход и остаток суммируются по периодам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumulatívne prekročenie a úspora výdavkov naprieč obdobiami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumulativno preseganje in primanjkljaj čez obdobja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumulativt över- och underspendande mellan perioder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காலங்களூடே சேர்க்கப்பட்ட மிகமாற்றம் மற்றும் குறைவான செலவு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాలాలు అంతటా సంచిత ఓవర్ మరియు అండర్-స్పెండింగ్."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สะสมการใช้จ่ายมากเกินกว่าและน้อยกว่าอัตราในแต่ละช่วงเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönemler arasında kümülatif fazla ve yetersiz harcama."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Накопичується перевитрата та недовитрата за періодами."
          }
