    "addEditBudget.chip.period.locked.accessibilityHint": {
      "comment": "VoiceOver hint for a period chip in Edit mode; tells the user the period is immutable post-creation",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقفل. لا يمكن تغيير الفترة بعد إنشاء ميزانيتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquejat. El període no es pot canviar un cop creat el pressupost."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamčeno. Období nelze po vytvoření rozpočtu změnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Låst. Perioden kan ikke ændres, efter du har oprettet dit budget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesperrt. Der Zeitraum kann nach dem Erstellen deines Budgets nicht mehr geändert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κλειδωμένο. Η περίοδος δεν μπορεί να αλλαχθεί μετά τη δημιουργία του προϋπολογισμού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked. Period can't be changed after creating your budget."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked. Period can't be changed after creating your budget."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked. Period can't be changed after creating your budget."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked. Period can't be changed after creating your budget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. El periodo no se puede cambiar una vez creado el presupuesto."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. El período no puede cambiarse después de crear tu presupuesto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukittu. Kautta ei voi muuttaa budjetin luomisen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillé. La période ne peut pas être modifiée après la création du budget."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillé. La période ne peut pas être modifiée après la création du budget."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נעול. לא ניתן לשנות את התקופה לאחר יצירת התקציב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक है। बजट बनाने के बाद अवधि बदली नहीं जा सकती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaključano. Razdoblje se ne može promijeniti nakon stvaranja proračuna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zárolt. Az időszak a költségvetés létrehozása után nem módosítható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terkunci. Periode tidak dapat diubah setelah anggaran dibuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccato. Il periodo non può essere modificato dopo aver creato il budget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック済み。予算を作成した後は期間を変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠김. 예산 생성 후에는 기간을 변경할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikunci. Tempoh tidak boleh diubah selepas bajet dibuat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Låst. Perioden kan ikke endres etter at budsjettet er opprettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrendeld. Periode kan niet worden gewijzigd na het aanmaken van je budget."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowane. Okresu nie można zmienić po utworzeniu budżetu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. O período não pode ser alterado após a criação do orçamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueado. O período não pode ser alterado após criar o orçamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocat. Perioada nu poate fi modificată după crearea bugetului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокировано. Период нельзя изменить после создания бюджета."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknuté. Obdobie nemožno po vytvorení rozpočtu zmeniť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låst. Perioden kan inte ändras efter att din budget har skapats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล็อกอยู่ ไม่สามารถเปลี่ยนรอบเวลาได้หลังจากสร้างงบประมาณแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitli. Bütçeni oluşturduktan sonra dönem değiştirilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблоковано. Після створення бюджету змінити період неможливо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khóa. Kỳ không thể thay đổi sau khi tạo ngân sách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已锁定。预算创建后无法更改周期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已鎖定。預算建立後無法更改週期。"
          }
        }
      }
    },
