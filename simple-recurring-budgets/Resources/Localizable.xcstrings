            "value" : "أنشئ أول ميزانية متكررة لك لتتبع ما تنفقه كل يوم أو أسبوع أو أسبوعين أو شهر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea el teu primer pressupost recurrent per fer un seguiment de les despeses de cada dia, setmana, quinzena o mes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte svůj první opakující se rozpočet a začněte sledovat své výdaje každý den, týden, dva týdny nebo měsíc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret dit første tilbagevendende budget og begynd at spore, hvad du bruger hver dag, uge, to uger eller måned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle dein erstes wiederkehrendes Budget, um deine täglichen, wöchentlichen, zweiwöchentlichen oder monatlichen Ausgaben zu verfolgen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε τον πρώτο σας επαναλαμβανόμενο προϋπολογισμό για να παρακολουθείτε τις δαπάνες σας κάθε ημέρα, εβδομάδα, δεκαπενθήμερο ή μήνα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Create your first recurring budget to start tracking what you spend each day, week, biweek, or month."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create your first recurring budget to start tracking what you spend each day, week, biweek, or month."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create your first recurring budget to start tracking what you spend each day, week, biweek, or month."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create your first recurring budget to start tracking what you spend each day, week, biweek, or month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea tu primer presupuesto recurrente para empezar a controlar lo que gastas cada día, semana, quincena o mes."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea tu primer presupuesto recurrente para comenzar a rastrear lo que gastas cada día, semana, quincena o mes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo ensimmäinen toistuva budjettisi ja aloita päivittäisten, viikoittaisten, kahden viikon tai kuukausittaisten menojen seuranta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez votre premier budget récurrent pour commencer à suivre vos dépenses chaque jour, semaine, quinzaine ou mois."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée ton premier budget récurrent pour commencer à suivre tes dépenses chaque jour, chaque semaine, aux deux semaines ou chaque mois."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צור את התקציב המחזורי הראשון שלך כדי להתחיל לעקוב אחר ההוצאות היומיות, השבועיות, הדו-שבועיות או החודשיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रतिदिन, सप्ताह, द्विसाप्ताहिक, या महीने के खर्च को ट्रैक करना शुरू करने के लिए अपना पहला आवर्ती बजट बनाएं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stvorite prvi ponavljajući proračun za praćenje potrošnje svaki dan, tjedan, dva tjedna ili mjesec."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hozza létre az első ismétlődő büdzsét, és kövesse nyomon napi, heti, kéthetes vagy havi kiadásait."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat anggaran berulang pertamamu untuk mulai melacak pengeluaran setiap hari, minggu, dua minggu, atau bulan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea il tuo primo budget ricorrente per iniziare a monitorare le spese giornaliere, settimanali, bisettimanali o mensili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の定期予算を作成して、毎日・毎週・隔週・毎月の支出を記録しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 번째 반복 예산을 만들어 매일, 매주, 격주 또는 매월 지출을 추적해 보세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat belanjawan berulang pertama anda untuk mula menjejaki perbelanjaan setiap hari, minggu, dua minggu, atau bulan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opprett ditt første gjentagende budsjett for å følge hva du bruker hver dag, uke, annenhver uke eller måned."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak je eerste terugkerende budget om bij te houden wat je elke dag, week, twee weken of maand uitgeeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz swój pierwszy cykliczny budżet, aby zacząć śledzić wydatki każdego dnia, tygodnia, dwutygodnia lub miesiąca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie seu primeiro orçamento recorrente para começar a acompanhar o que você gasta a cada dia, semana, quinzena ou mês."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie o seu primeiro orçamento recorrente para começar a acompanhar o que gasta por dia, semana, quinzena ou mês."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creează primul tău buget recurent pentru a urmări ce cheltuiești în fiecare zi, săptămână, bilunar sau lună."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте свой первый регулярный бюджет, чтобы начать отслеживать расходы каждый день, неделю, две недели или месяц."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvorte svoj prvý opakujúci sa rozpočet a začnite sledovať, koľko míňate každý deň, týždeň, dvojtýždeň alebo mesiac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapa din första återkommande budget och börja spåra vad du spenderar varje dag, vecka, tvåvecka eller månad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างงบประมาณแรกของคุณเพื่อติดตามค่าใช้จ่ายรายวัน รายสัปดาห์ รายสองสัปดาห์ หรือรายเดือน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük, haftalık, iki haftada bir veya aylık harcamalarınızı takip etmeye başlamak için ilk yinelenen bütçenizi oluşturun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створіть свій перший регулярний бюджет, щоб відстежувати витрати щодня, щотижня, кожні два тижні або щомісяця."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo ngân sách định kỳ đầu tiên để theo dõi chi tiêu hàng ngày, hàng tuần, hai tuần một lần hoặc hàng tháng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建您的第一个周期性预算，开始追踪每天、每周、每两周或每月的支出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立您的第一個週期性預算，開始追蹤每日、每週、雙週或每月的花費。"
          }
        }
      }
    },
