        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a költségvetés létrehozása után nem módosítható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak dapat diubah setelah anggaran dibuat."
