    "addEditBudget.field.icon.accessibilityHint": {
      "comment": "VoiceOver hint for the optional budget icon chip",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح منتقى الأيقونات لاختيار أيقونة للميزانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাজেটের জন্য একটি আইকন নির্বাচন করতে একটি নির্বাচক খোলে।"
