          "stringUnit": {
            "state": "translated",
            "value": "ಬಜೆಟ್ ಮುಂದುವರಿಸುತ್ತದೆ ಆದ್ದರಿಂದ ನೀವು ಮತ್ತೆ ಖರ್ಚುಗಳನ್ನು ಲಾಗ್ ಮಾಡಬಹುದು"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예산을 재개하여 지출을 다시 기록할 수 있습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബജറ്റ് പുനരാരംഭിക്കുന്നതിനാൽ നിങ്ങൾക്ക് ചെലവുകൾ ഫിരിഞ്ഞ് കൂട്ടാൻ കഴിയും"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Budget पुन्हा सुरू करते जेणेकरून तुम्ही पुन्हा खर्च नोंद करू शकता"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyambung semula bajet supaya anda boleh log perbelanjaan semula"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenopptar budsjettet slik at du kan registrere utgifter igjen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hervat het budget zodat je opnieuw uitgaven kunt bijhouden"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବଜେଟ୍ ପୁନଃଆରମ୍ଭ କରେ ଯାଥା ଆପଣ ଖର୍ଚ୍ଚ ଲଗ୍ କରିପାରିବେ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਜਟ ਮੁੜ-ਸ਼ੁਰੂ ਕਰਦਾ ਹੈ ਤਾਂ ਜੋ ਤੁਸੀਂ ਖਰਚ ਦੋਬਾਰਾ ਲਾਗ ਕਰ ਸਕੋ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wznawia budżet, abyś mógł ponownie dodawać wydatki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retoma o orçamento para que você possa registrar despesas novamente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Retoma o orçamento para poderes registar despesas novamente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reia bugetul pentru a putea înregistra din nou cheltuieli"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возобновляет бюджет, чтобы снова записывать расходы"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví rozpočet, aby ste mohli znovu zaznamenávať výdavky"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaljuje proračun, da lahko ponovno beležiš stroške"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återupptar budgeten så att du kan registrera utgifter igen"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பட்ஜெட்டைத் தொடர்ந்து நீங்கள் மீண்டும் செலவுகளைப் பதிவுசெய்யலாம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బడ్జెట్‌ను కొనసాగిస్తుంది కనుక మీరు ఖర్చులను నమోదు చేయవచ్చు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลับมาใช้งบประมาณเพื่อบันทึกค่าใช้จ่ายได้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütçeyi sürdürerek tekrar gider kaydedebilirsin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлює бюджет, щоб ви могли знову записувати витрати"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بجٹ کو دوبارہ شروع کرتا ہے تاکہ آپ دوبارہ اخراجات درج کر سکیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục ngân sách để bạn có thể ghi lại chi phí"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复预算，以便再次记录支出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復預算，以便再次記錄支出"
          }
        }
      }
    },
