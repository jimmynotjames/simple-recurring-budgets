    "addEditBudget.note.carryOver" : {
      "comment" : "Caption below the carry-over toggle explaining what carry-over does",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
