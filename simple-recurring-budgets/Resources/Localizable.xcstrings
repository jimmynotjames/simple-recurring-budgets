    "saveError.alert.message": {
      "comment": "Body shown on the save-failure alert for the first two attempts. Reassures the user their input is intact and offers a retry.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما أثناء حفظ التغييرات. معلوماتك لا تزال هنا — يرجى المحاولة مرة أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi ha hagut un problema en desar els teus canvis. La teva informació segueix aquí — si us plau, torna-ho a intentar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při ukládání změn došlo k chybě. Vaše informace jsou stále zde — zkuste to prosím znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gik noget galt under gemning af dine ændringer. Dine oplysninger er stadig her – prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Speichern deiner Änderungen ist etwas schief gelaufen. Deine Informationen sind noch vorhanden – bitte versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι πήγε στραβά κατά την αποθήκευση των αλλαγών σας. Τα δεδομένα σας είναι εδώ — δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong saving your changes. Your information is still here — please try again."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong saving your changes. Your information is still here — please try again."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong saving your changes. Your information is still here — please try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong saving your changes. Your information is still here — please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo ha fallado al guardar los cambios. La información sigue aquí — inténtalo de nuevo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal al guardar tus cambios. Tu información sigue aquí — por favor intenta de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutoksiasi tallennettaessa tapahtui virhe. Tiedot ovat edelleen tallennettuina — yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu lors de la sauvegarde. Tes informations sont toujours là — réessaie."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s'est produite lors de l'enregistrement. Tes informations sont toujours là — réessaie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש בעת שמירת השינויים שלך. המידע שלך עדיין כאן — בבקשה נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके परिवर्तन सहेजते समय कुछ गलत हुआ। आपकी जानकारी अभी भी यहाँ है — कृपया फिर से प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nešto je pošlo po krivu pri spremanju promjena. Vaši podaci su i dalje ovdje — pokušajte ponovo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valami hiba történt a módosítások mentésekor. Az adataid még itt vannak — próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan saat menyimpan perubahan Anda. Informasi Anda masih tersimpan — silakan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore durante il salvataggio delle modifiche. Le tue informazioni sono ancora qui — riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更の保存中にエラーが発生しました。入力内容は残っています。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 저장하는 중에 문제가 발생했습니다. 정보는 안전하게 보관되어 있습니다 — 다시 시도해주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada yang tidak kena semasa menyimpan perubahan anda. Maklumat anda masih di sini — sila cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe gikk galt ved lagring av endringene dine. Opplysningene dine er fortsatt her — prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis bij het opslaan. Je gegevens zijn er nog — probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak podczas zapisywania zmian. Twoje informacje są tutaj — spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado ao salvar suas alterações. Suas informações ainda estão aqui — tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro ao guardar as tuas alterações. As tuas informações continuam aqui — tenta novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva nu a funcționat la salvarea modificărilor. Informațiile tale sunt încă aici — te rog încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить изменения. Данные на месте — попробуй ещё раз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri ukladaní zmien sa vyskytla chyba. Vaše údaje sú stále tu — skúste prosím znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något gick fel när ändringarna sparades. Din information finns kvar här — försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีบางอย่างผิดพลาดในการบันทึกการเปลี่ยนแปลงของคุณ ข้อมูลของคุณยังอยู่ที่นี่ — โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler kaydedilirken bir sorun oluştu. Bilgilerin hâlâ burada — lütfen tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось пішло не так під час збереження змін. Ваші дані все ще тут — спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi khi lưu thay đổi của bạn. Thông tin của bạn vẫn còn đây — vui lòng thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存您的更改时出了点问题。您的信息仍然完好——请再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存變更時發生問題。您的資訊仍在此處——請重試。"
          }
        }
      }
    },
    "saveError.alert.message.escalated": {
      "comment": "Body shown on the save-failure alert after three consecutive failures of the same operation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نتمكن من حفظ التغييرات. معلوماتك لا تزال هنا — حاول مرة أخرى، أو أرسل لنا تفاصيل الخطأ لكي نتمكن من مساعدتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hem pogut desar els teus canvis. La teva informació segueix aquí — torna-ho a intentar, o envia'ns els detalls de l'error perquè t'ajudem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se nám uložit vaše změny. Vaše informace jsou stále zde — zkuste to znovu, nebo nám pošlete podrobnosti o chybě, abychom vám mohli pomoci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke gemme dine ændringer. Dine oplysninger er stadig her – prøv igen, eller send os fejloplysningerne, så vi kan hjælpe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten deine Änderungen nicht speichern. Deine Informationen sind noch vorhanden – versuche es erneut, oder sende uns die Fehlerdetails, damit wir dir helfen können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορέσαμε να αποθηκεύσουμε τις αλλαγές σας. Τα δεδομένα σας είναι εδώ — δοκιμάστε ξανά ή στείλτε μας τα στοιχεία σφάλματος για να σας βοηθήσουμε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't save your changes. Your information is still here — try again, or send us the error details so we can help."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't save your changes. Your information is still here — try again, or send us the error details so we can help."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't save your changes. Your information is still here — try again, or send us the error details so we can help."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't save your changes. Your information is still here — try again, or send us the error details so we can help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido guardar los cambios. La información sigue aquí — inténtalo de nuevo o envíanos los detalles del error para ayudarte."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos guardar tus cambios. Tu información sigue aquí — intenta de nuevo o envíanos los detalles del error para poder ayudarte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutoksiasi ei voitu tallentaa. Tiedot ovat edelleen tallennettuina — yritä uudelleen tai lähetä meille virhetiedot, jotta voimme auttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas pu sauvegarder tes modifications. Tes informations sont toujours là — réessaie, ou envoie-nous les détails de l'erreur."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas pu enregistrer tes modifications. Tes informations sont toujours là — réessaie, ou envoie-nous les détails de l'erreur pour qu'on puisse t'aider."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לשמור את השינויים שלך. המידע שלך עדיין כאן — נסה שוב, או שלח לנו את פרטי השגיאה כדי שנוכל לעזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपके परिवर्तन नहीं सहेज सके। आपकी जानकारी अभी भी यहाँ है — फिर से प्रयास करें, या हमें त्रुटि विवरण भेजें ताकि हम आपकी मदद कर सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjene nije bilo moguće spremiti. Vaši podaci su i dalje ovdje — pokušajte ponovo ili nam pošaljite detalje greške kako bismo mogli pomoći."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült a módosítások mentése. Az adataid még itt vannak — próbáld újra, vagy küldd el az üzeneteket, hogy segíteni tudjunk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak dapat menyimpan perubahan Anda. Informasi Anda masih tersimpan — coba lagi, atau kirimkan detail kesalahan kepada kami agar kami dapat membantu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo potuto salvare le tue modifiche. Le tue informazioni sono ancora qui — riprova o inviaci i dettagli dell'errore per aiutarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を保存できませんでした。入力内容は残っています。再度お試しいただくか、エラーの詳細をお送りください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 저장할 수 없습니다. 정보는 안전하게 보관되어 있습니다 — 다시 시도하거나 오류 세부 정보를 보내주시면 도움을 드리겠습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak dapat menyimpan perubahan anda. Maklumat anda masih di sini — cuba lagi, atau hantar butiran ralat kepada kami supaya kami dapat membantu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke lagre endringene dine. Opplysningene dine er fortsatt her — prøv igjen, eller send oss feilopplysningene slik at vi kan hjelpe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wijzigingen konden niet worden opgeslagen. Je gegevens zijn er nog — probeer het opnieuw of stuur ons de foutdetails zodat we kunnen helpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać Twoich zmian. Twoje informacje są tutaj — spróbuj ponownie lub wyślij nam szczegóły błędu, aby mogliśmy Ci pomóc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos salvar suas alterações. Suas informações ainda estão aqui — tente novamente ou nos envie os detalhes do erro para ajudarmos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar as tuas alterações. As tuas informações continuam aqui — tenta novamente ou envia-nos os detalhes do erro para podermos ajudar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "N-am putut salva modificările tale. Informațiile tale sunt încă aici — încearcă din nou, sau trimite-ne detaliile erorii pentru a te putea ajuta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения не сохранились. Данные на месте — попробуй ещё раз или отправь нам детали ошибки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše zmeny sa nepodarilo uložiť. Vaše údaje sú stále tu — skúste znova alebo nám pošlite podrobnosti chyby, aby sme vám mohli pomôcť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunde inte spara ändringarna. Din information finns kvar här — försök igen, eller skicka oss felinformationen så kan vi hjälpa till."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกการเปลี่ยนแปลงของคุณได้ ข้อมูลของคุณยังอยู่ที่นี่ — ลองอีกครั้งหรือส่งรายละเอียดข้อผิดพลาดให้เราเพื่อให้เราสามารถช่วยได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler kaydedilemedi. Bilgilerin hâlâ burada — tekrar dene ya da hata ayrıntılarını bize gönder, yardımcı olalım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти ваші зміни. Ваші дані все ще тут — спробуйте ще раз або надішліть нам деталі помилки, щоб ми могли допомогти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi không thể lưu thay đổi của bạn. Thông tin của bạn vẫn còn đây — hãy thử lại, hoặc gửi cho chúng tôi chi tiết lỗi để chúng tôi có thể giúp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们无法保存您的更改。您的信息仍然完好——请再试一次，或者向我们发送错误详情以便我们帮助您。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存您的變更。您的資訊仍在此處——請重試，或傳送我們錯誤詳細資料以便我們協助您。"
          }
        }
      }
    },
