          "stringUnit": {
            "state": "translated",
            "value": "繰越残高がクリアされ、ゼロからやり直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이월 잔액이 초기화되어 0부터 다시 시작돼요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baki Carry-Over akan dikosongkan dan bermula semula dari sifar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Carry-Over-saldoen tømmes og starter på nytt fra null."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het overgedragen saldo wordt gewist en begint opnieuw bij nul."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo Carry-Over zostanie wyczyszczone i zacznie od nowa od zera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo de Carry-Over será apagado e começará do zero."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo de Carry-Over será limpo e recomeçará do zero."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Soldul Carry-Over va fi șters și va reîncepe de la zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс Carry-Over будет очищен и начнётся заново с нуля."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
