    "addEditBudget.action.delete.accessibilityHint": {
      "comment": "VoiceOver hint for the Delete Budget button, communicating the destructive and irreversible consequence",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف هذه الميزانية ونفقاتها نهائياً."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentment aquest pressupost i les seves despeses."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvale odstraní tento rozpočet a jeho výdaje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter dette budget og dets udgifter permanent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht dieses Budget und alle Ausgaben dauerhaft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει οριστικά αυτόν τον προϋπολογισμό και τα έξοδά του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes this budget and its expenses."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes this budget and its expenses."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes this budget and its expenses."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes this budget and its expenses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente este presupuesto y sus gastos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente este presupuesto y sus gastos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa tämän budjetin ja sen kulut pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement ce budget et ses dépenses."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement ce budget et ses dépenses."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוחק לצמיתות את התקציב והוצאותיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बजट और इसके सभी खर्च स्थायी रूप से हटा देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajno briše ovaj proračun i sve troškove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Véglegesen törli ezt a büdzsét és a hozzá tartozó kiadásokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus anggaran ini beserta pengeluarannya secara permanen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente questo budget e le sue spese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この予算とその支出を完全に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 예산과 모든 지출을 영구적으로 삭제해요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadamkan belanjawan ini dan perbelanjaannya secara kekal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter dette budsjettet og alle utgifter permanent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert dit budget en de uitgaven permanent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usuwa ten budżet i jego wydatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui permanentemente este orçamento e suas despesas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente este orçamento e as suas despesas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge definitiv acest buget și cheltuielile sale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет этот бюджет и все его расходы безвозвратно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrvalo odstráni tento rozpočet a jeho výdavky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort den här budgeten och dess utgifter permanent."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบงบประมาณและค่าใช้จ่ายทั้งหมดอย่างถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bütçeyi ve harcamalarını kalıcı olarak siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаточно видаляє цей бюджет та його витрати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa vĩnh viễn ngân sách này và các chi tiêu của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除此预算及其所有支出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
