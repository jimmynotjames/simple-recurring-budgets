    "addEditExpense.paused.caption.format": {
      "comment": "Proactive caption shown below the When card in Add/Edit Expense when the bound budget is paused; argument is the abbreviated pausedSince date",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقفة منذ %@. لا يزال بإمكانك إضافة نفقات بتاريخ سابق لذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ থেকে বিরতিতে। আপনি তখনও সেই তারিখের আগে খরচ যোগ করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa des de %@. Encara pots afegir despeses amb data anterior a aquell moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastaveno od %@. Stále můžete přidávat výdaje s datem před tímto okamžikem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat på pause siden %@. Du kan stadig tilføje udgifter dateret før det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert seit %@. Du kannst weiterhin Ausgaben mit einem früheren Datum hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε παύση από %@. Μπορείς να προσθέσεις έξοδα με ημερομηνία πριν από τότε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused since %@. You can still add expenses dated before then."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused since %@. You can still add expenses dated before then."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused since %@. You can still add expenses dated before then."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused since %@. You can still add expenses dated before then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa desde %@. Aún puedes añadir gastos con fecha anterior a ese momento."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa desde %@. Aún puedes agregar gastos con fecha anterior a ese momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskeytetty %@ lähtien. Voit silti lisätä kuluja, joiden päivämäärä on ennen sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendu depuis le %@. Tu peux toujours ajouter des dépenses datées d'avant."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendu depuis %@. Tu peux quand même ajouter des dépenses datées avant cette date."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ થી થોભાવેલું. તમે તે પહેલાની તારીખવાળા ખર્ચ ઉમેરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מושהה מאז %@. עדיין ניתן להוסיף הוצאות בתאריך מוקדם מכך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ से रुका हुआ। आप अभी भी उससे पहले की तारीख वाले खर्च जोड़ सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzirano od %@. I dalje možeš dodati troškove s datumom prije toga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szüneteltetve %@ óta. Még mindig hozzáadhatsz korábbi dátumú kiadásokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda sejak %@. Anda masih bisa menambahkan pengeluaran bertanggal sebelumnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa dal %@. Puoi ancora aggiungere spese datate prima di allora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から一時停止中。それ以前の日付の支出は引き続き追加できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ರಿಂದ ವಿರಾಮಗೊಂಡಿದೆ. ನೀವು ಅದಕ್ಕಿಂತ ಮೊದಲೆ ದಿನಾಂಕಾಯ್ತ ಖರ್ಚುಗಳನ್ನು ಸೇರಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 이후 일시 중지됨. 그 이전 날짜의 지출은 계속 추가할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ മുതൽ താൽക്കാലികമായി നിർത്തിയിരിക്കുന്നു. നിങ്ങൾക്കുള്ള ചെലവുകൾ അതിനുമുമ്പ് ദ്വാരം കൂട്ടാൻ കഴിയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पासून थांबवलेले. तुम्ही अजूनही त्यानंतरच्या तारखेला खर्च जोडू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda sejak %@. Anda masih boleh menambah perbelanjaan bertarikh sebelum itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Satt på pause siden %@. Du kan fortsatt legge til utgifter datert før det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerd sinds %@. Je kunt nog steeds uitgaven van vóór die datum toevoegen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ଠାରୁ ବିରତ। ଆପଣ ତଥାପି ସେ ତାରିଖ ପୂର୍ବରେ ଖର୍ଚ୍ଚ ଯୋଡ଼ିପାରିବେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਤੋਂ ਰੋਕਿਆ। ਤੁਸੀਂ ਅਜੇ ਵੀ ਉਸ ਤੋਂ ਪਹਿਲਾਂ ਦੀ ਤਾਰੀਖ਼ ਦੇ ਖਰਚੇ ਸ਼ਾਮਲ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymano od %@. Nadal możesz dodawać wydatki z wcześniejszą datą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado desde %@. Você ainda pode adicionar despesas datadas antes disso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa desde %@. Ainda podes adicionar despesas datadas antes disso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În pauză din %@. Încă poți adăuga cheltuieli datate înainte de acel moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На паузе с %@. Можно добавлять расходы до этой даты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastavené od %@. Stále môžete pridávať výdavky s dátumom pred týmto okamihom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začasno ustavljeno od %@. Stroške s prejšnjimi datumi lahko še vedno dodajaš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausad sedan %@. Du kan fortfarande lägga till utgifter daterade före dess."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ முதல் இடைநிறுத்தப்பட்டது. நீங்கள் இன்னும் அப்போது முன்னர் தேதியிட்ட செலவுகளைச் சேர்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "విరామం %@ నుండి. మీరు ఇప్పటికీ ఆ ముందు తేదీ ఖర్చులను జోడించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดชั่วคราวตั้งแต่ %@ คุณยังสามารถเพิ่มค่าใช้จ่ายที่มีวันที่ก่อนหน้านั้นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarihinden beri duraklatıldı. Hâlâ daha öncesine tarihli giderler ekleyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На паузі з %@. Ви все ще можете додавати витрати з ранішою датою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ سے روکا ہوا۔ آپ اس سے پہلے درج شدہ اخراجات شامل کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạm dừng từ %@. Bạn vẫn có thể thêm chi phí có ngày trước thời điểm đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自%@起已暂停。您仍可添加更早日期的支出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已於 %@ 暫停。仍可新增該日期前的消費記錄。"
          }
        }
      }
    },
