    "budgetDetail.resetCarryOver.alert.message": {
      "comment": "Body of the reset carry-over alert",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم مسح رصيد Carry-Over والبدء من جديد من الصفر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo romanent s'esborrarà i tornarà a començar des de zero."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstatek Carry-Over bude vymazán a začne znovu od nuly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Carry-over-saldoen ryddes og starter forfra fra nul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Carry-Over-Saldo wird gelöscht und bei null neu gestartet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το υπόλοιπο μεταφοράς θα διαγραφεί και θα ξεκινήσει από το μηδέν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The carry-over balance will be cleared and start fresh from zero."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The carry-over balance will be cleared and start fresh from zero."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The carry-over balance will be cleared and start fresh from zero."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The carry-over balance will be cleared and start fresh from zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo acumulado se borrará y empezará de cero."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo de Carry-Over se borrará y comenzará desde cero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirtosaldo tyhjennetään ja aloitetaan alusta nollasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde reporté sera effacé et repartira de zéro."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde reporté sera effacé et repartira à zéro."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יתרת ה-Carry-Over תנוקה ותתחיל מחדש מאפס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Carry-Over शेष साफ़ हो जाएगा और शून्य से नए सिरे से शुरू होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanje Carry-Over bit će obrisano i početi iznova od nule."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Carry-Over egyenleg törlődik, és nulláról kezdődik újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo carry-over akan dihapus dan dimulai dari nol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo del Carry-Over verrà cancellato e ripartirà da zero."
          }
        },
