        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de modifier ça après la création du budget."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ બજેટ બનાવ્યા પછી બદલી શકાતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשנות זאת לאחר יצירת התקציב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बजट बनाने के बाद यह नहीं बदला जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo se ne može promijeniti nakon stvaranja proračuna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a költségvetés létrehozása után nem módosítható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak dapat diubah setelah anggaran dibuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non può essere modificato dopo aver creato il budget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予算を作成した後は変更できません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಬಜೆಟ್ ರಚಿಸಿದ ನಂತರ ಇದನ್ನು ಬದಲಾಯಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예산을 만든 후에는 변경할 수 없어요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബജറ്റ് സൃഷ്ടിച്ച ശേഷം ഇത് മാറ്റാൻ കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Budget तयार केल्यानंतर हे बदलता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak boleh diubah selepas membuat belanjawan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan ikke endres etter at budsjettet er opprettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet worden gewijzigd nadat je budget is aangemaakt."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ବଜେଟ୍ ତୈରି ହେବାପରେ ଏଟା ବଦଳାଯାଇ ପାରିବ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਬਜਟ ਬਣਾਉਣ ਤੋਂ ਬਾਅਦ ਨਹੀਂ ਬਦਲਿਆ ਜਾ ਸਕਦਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego nie można zmienić po utworzeniu budżetu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não pode ser alterado após a criação do orçamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode ser alterado após criar o orçamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta nu poate fi modificată după crearea bugetului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это нельзя изменить после создания бюджета."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto nemožno zmeniť po vytvorení rozpočtu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ne moreš spremeniti po ustvarjanju proračuna."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här kan inte ändras efter att din budget har skapats."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பட்ஜெட்டை உருவாக்கியபின் இதை மாற்ற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బడ్జెట్‌ను సృష్టించిన తర్వాత దీన్ని మార్చలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปลี่ยนแปลงได้หลังจากสร้างงบประมาณแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütçeni oluşturduktan sonra bu değiştirilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це неможливо змінити після створення бюджету."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بجٹ بنانے کے بعد یہ تبدیل نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thay đổi sau khi tạo ngân sách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预算创建后无法更改此项。"
