    "addEditBudget.note.currencyLabelOnly": {
      "comment": "Inline note shown below the currency picker when the user selects a different currency, warning that no conversion is applied",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير العملة يُحدِّث التسمية فقط، أي لا يتم تحويل العملة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canviar la moneda només actualitza l'etiqueta. És a dir, no es fa cap conversió de divises."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna měny aktualizuje pouze popisek. Tj. Neprovádí se žádný přepočet měny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændring af valuta opdaterer kun etiketten. Der foretages ingen valutakonvertering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die Währung änderst, wird nur die Bezeichnung aktualisiert. Es findet keine Währungsumrechnung statt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή νομίσματος ενημερώνει μόνο την ετικέτα. Δεν γίνεται μετατροπή νομίσματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing currency only updates the label. I.e. No currency conversion."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing currency only updates the label. I.e. No currency conversion."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing currency only updates the label. I.e. No currency conversion."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing currency only updates the label. I.e. No currency conversion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la divisa solo actualiza la etiqueta. No se aplica ninguna conversión."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la moneda solo actualiza la etiqueta. No aplica conversión de moneda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuutan vaihto päivittää vain tunnuksen. Valuuttamuunnosta ei tehdä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer la devise met uniquement à jour le libellé. Aucune conversion de devise n'est appliquée."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer la devise met à jour l'étiquette seulement. Aucune conversion n'est appliquée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי מטבע מעדכן רק את התווית. כלומר, אין המרת מטבע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुद्रा बदलने से केवल लेबल अपडेट होता है। यानी कोई मुद्रा रूपांतरण नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjena valute mijenja samo oznaku, tj. ne provodi se pretvorba valute."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pénznem megváltoztatása csak a feliratot frissíti. Azaz: nincs pénznemkonverzió."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengganti mata uang hanya mengubah label. Tidak ada konversi mata uang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare la valuta aggiorna solo l'etichetta. Non viene applicata alcuna conversione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通貨を変更してもラベルが更新されるだけです。つまり、通貨の換算は行われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화를 변경하면 표시 단위만 바뀝니다. 즉, 환율 변환은 적용되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukar mata wang hanya mengemas kini label. Tiada penukaran mata wang dilakukan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å endre valuta oppdaterer kun etiketten. Ingen valutakonvertering utføres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wijzigen van de valuta werkt alleen het label bij. Er vindt geen valutaconversie plaats."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana waluty aktualizuje tylko etykietę. Tj. brak przeliczenia walut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar a moeda atualiza apenas o rótulo. Ou seja, sem conversão de moeda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar a moeda apenas atualiza a etiqueta. I.e. Sem conversão de moeda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbarea monedei actualizează doar eticheta. Fără conversie valutară."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение валюты обновляет только метку. Конвертация валюты не выполняется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmena meny aktualizuje iba označenie. Žiadny prepočet meny sa nevykoná."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att ändra valuta uppdaterar bara etiketten. Dvs. ingen valutakonvertering görs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนสกุลเงินจะอัปเดตเฉพาะป้ายกำกับเท่านั้น ไม่มีการแปลงสกุลเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para birimi değiştirmek yalnızca etiketi günceller. Dönüşüm uygulanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна валюти оновлює лише мітку. Конвертація валюти не виконується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi tiền tệ chỉ cập nhật nhãn. Không có chuyển đổi tiền tệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改货币仅更新标签显示，不进行汇率换算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改貨幣只會更新標籤，不會進行任何貨幣換算。"
          }
        }
      }
    },
    "addEditBudget.note.periodLocked": {
      "comment": "Caption below the period chip grid in edit mode, explaining that the period is locked",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تغيير هذا بعد إنشاء ميزانيتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això no es pot canviar un cop creat el pressupost."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto nelze po vytvoření rozpočtu změnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan ikke ændres, efter du har oprettet dit budget."
          }
        },
        "de": {
