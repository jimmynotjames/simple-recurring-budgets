        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf wat er op je apparaat aan de hand was toen dit begon:"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦୟାକରି ବର୍ଣ୍ଣନା କରନ୍ତୁ ଯାହା ଆପଣାର ଡିଭାଇସରେ ଘଟୁଥିଲା ଯେତେବେଳେ ଏଟା ଆରମ୍ଭ ହୋଇଗଲା:"
