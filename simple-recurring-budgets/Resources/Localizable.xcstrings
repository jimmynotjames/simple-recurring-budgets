    "feedback.email.body.intro": {
      "comment": "First sentence of the auto-filled email body shown when the user taps Send Feedback after a repeated save failure. Reassures them that no personal data is included.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الحفظ في التطبيق مرارًا وتكرارًا. سياق تشخيصي (بدون بيانات شخصية):"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una operació de desar a l'app ha fallat repetidament. Context de diagnòstic (sense dades personals):"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukládání v aplikaci se opakovně nezdařilo. Diagnostické informace (bez osobních údajů):"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En gemning i appen mislykkedes gentagne gange. Diagnostisk kontekst (ingen personlige data):"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Speichern in der App ist wiederholt fehlgeschlagen. Diagnosedaten (keine persönlichen Daten):"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποτυχία αποθήκευσης στην εφαρμογή επανειλημμένα. Διαγνωστικό περιεχόμενο (χωρίς προσωπικά δεδομένα):"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A save in the app failed repeatedly. Diagnostic context (no personal data):"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A save in the app failed repeatedly. Diagnostic context (no personal data):"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A save in the app failed repeatedly. Diagnostic context (no personal data):"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A save in the app failed repeatedly. Diagnostic context (no personal data):"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un guardado en la app falló repetidamente. Contexto de diagnóstico (sin datos personales):"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló un guardado en la app repetidamente. Contexto de diagnóstico (sin datos personales):"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksessa tallennus epäonnistui toistuvasti. Diagnostiikat (ei henkilötietoja):"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde dans l'app a échoué plusieurs fois. Contexte de diagnostic (aucune donnée personnelle) :"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde dans l'application a échoué à plusieurs reprises. Contexte de diagnostic (aucune donnée personnelle) :"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירה באפליקציה נכשלה שוב ושוב. הקשר אבחון (ללא נתונים אישיים):"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में एक सेव बार-बार विफल हुआ। डायग्नोस्टिक संदर्भ (कोई व्यक्तिगत डेटा नहीं):"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremanje u aplikaciji nije uspjelo više puta. Dijagnostički kontekst (bez osobnih podataka):"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazásban egy mentés többször egymás után sikertelen volt. Diagnosztikai adatok (nincs személyes adat):"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan di aplikasi gagal berulang kali. Konteks diagnostik (tanpa data pribadi):"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un salvataggio nell'app non è andato a buon fine ripetutamente. Contesto diagnostico (nessun dato personale):"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内の保存が繰り返し失敗しました。診断情報（個人データなし）:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 저장이 반복적으로 실패했습니다. 진단 정보 (개인 데이터 없음):"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpanan dalam aplikasi gagal berulang kali. Konteks diagnostik (tiada data peribadi):"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En lagring i appen mislyktes gjentatte ganger. Diagnostisk kontekst (ingen personlige data):"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
