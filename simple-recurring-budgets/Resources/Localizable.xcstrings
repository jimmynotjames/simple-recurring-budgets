    "budgetDetail.menu.resetBudget.accessibilityHint" : {
      "comment" : "VoiceOver hint for the destructive Reset Budget menu item, communicating the irreversible consequence",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف جميع مصروفات هذه الميزانية نهائياً ويعيد الترحيل إلى الصفر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina permanentment totes les despeses d'aquest pressupost i posa el romanent a zero."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trvale odstraní všechny výdaje tohoto rozpočtu a resetuje přenesený zůstatek na nulu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter alle udgifter for dette budget permanent og nulstiller overførslen til nul."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht alle Ausgaben für dieses Budget dauerhaft und setzt den Übertrag auf null zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράφει οριστικά όλα τα έξοδα αυτού του προϋπολογισμού και μηδενίζει τη μεταφορά υπολοίπου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Permanently deletes every expense for this budget and resets carry-over to zero."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently deletes every expense for this budget and resets carry-over to zero."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently deletes every expense for this budget and resets carry-over to zero."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently deletes every expense for this budget and resets carry-over to zero."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina permanentemente todos los gastos de este presupuesto y restablece el saldo acumulado a cero."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina permanentemente todos los gastos de este presupuesto y restablece el saldo acumulado a cero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa pysyvästi kaikki tämän budjetin kulut ja nollaa siirron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime définitivement toutes les dépenses de ce budget et remet le report à zéro."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime définitivement toutes les dépenses de ce budget et remet le solde reporté à zéro."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוחק לצמיתות את כל ההוצאות בתקציב זה ומאפס את היתרה המועברת לאפס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस बजट के सभी खर्च स्थायी रूप से हटा देता है और कैरी-ओवर शून्य पर रीसेट करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trajno briše sve troškove ovog proračuna i postavlja preneseni saldo na nulu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Véglegesen törli a büdzsé összes kiadását, és nullára állítja az áthozott egyenleget."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus semua pengeluaran untuk anggaran ini secara permanen dan mereset saldo carryover ke nol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente tutte le spese di questo budget e azzera il saldo riportato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この予算のすべての支出を完全に削除し、繰越残高をゼロにリセットします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 예산의 모든 지출을 영구적으로 삭제하고 이월 잔액을 0으로 초기화해요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memadamkan semua perbelanjaan untuk belanjawan ini secara kekal dan menetapkan semula baki yang dibawa kepada sifar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter alle utgifter for dette budsjettet permanent og nullstiller overføringssaldoen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert alle uitgaven voor dit budget permanent en reset het overgedragen saldo naar nul."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwale usuwa wszystkie wydatki z tego budżetu i zeruje przeniesione saldo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui permanentemente todas as despesas deste orçamento e redefine o saldo acumulado para zero."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina permanentemente todas as despesas deste orçamento e repõe o saldo transitado a zero."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Șterge definitiv toate cheltuielile acestui buget și resetează soldul reportat la zero."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет все расходы этого бюджета и обнуляет перенесённый баланс."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natrvalo odstráni všetky výdavky tohto rozpočtu a vynuluje prenesený zostatok."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bort alla utgifter för den här budgeten permanent och återställer det överförda saldot till noll."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบรายจ่ายทั้งหมดของงบประมาณนี้อย่างถาวรและรีเซ็ตยอดยกมาเป็นศูนย์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bütçedeki tüm harcamaları kalıcı olarak siler ve devredilen bakiyeyi sıfırlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остаточно видаляє всі витрати цього бюджету та скидає перенесений залишок до нуля."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa vĩnh viễn tất cả chi tiêu của ngân sách này và đặt lại số dư chuyển kỳ về không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久删除此预算的所有支出，并将结转余额重置为零。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久刪除此預算的所有支出，並將 Carry-Over 重設為零。"
          }
        }
      }
    },
