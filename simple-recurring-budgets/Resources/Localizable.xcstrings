          "stringUnit": {
            "state": "translated",
            "value": "Descrivi cosa stavi facendo quando è accaduto:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この問題が発生した時に何をしていたかについて説明してください:"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಸಂಭವಿಸಿದಾಗ ನೀವು ಏನು ಮಾಡುತ್ತಿದ್ದಿರಿ ಎಂಬುದನ್ನು ವರ್ಣಿಸಿ:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문제가 발생했을 때 어떤 작업을 하고 있었는지 설명해 주세요:"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് സംഭവിച്ച സമയത്ത് നിങ്ങൾ എന്തായിരുന്നെന്ന് വിവരിക്കുക:"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया वर्णन करा की हे कधी घडले तेव्हा काय करीत होते:"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila huraikan apa yang anda lakukan apabila perkara ini berlaku:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vennligst beskriv hva du gjorde da dette skjedde:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf wat je aan het doen was toen dit gebeurde:"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦୟାକରି ବର୍ଣ୍ଣନା କରନ୍ତୁ ଯାହା ଆପଣ କରୁଥିଲେ ଏଟା ଘଟିଥିଲା:"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਰਪਾ ਕਰਕੇ ਵੇਰਵਾ ਦਿਓ ਕਿ ਜਦ ਇਹ ਹੋਿਆ ਤੁਸੀਂ ਕੀ ਕਰ ਰਹੇ ਸੀ:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz, co robiłeś, gdy to się stało:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva o que você estava fazendo quando isso aconteceu:"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreve o que estavas a fazer quando isto aconteceu:"
          }
        },
