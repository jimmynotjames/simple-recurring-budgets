        }
      }
    },
    "addEditBudget.note.specificDates": {
      "comment": "Caption shown below the Specific Dates period chip explaining that this budget type is non-recurring with no carry-over",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مناسب للرحلة أو نهاية الأسبوع، أو أي نافذة إنفاق لمرة واحدة. عند انتهاءها، تنتهي. لا تكرار، لا مُرحَّل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ভ্রমণ, জন্মদিন সপ্তাহান্তের জন্য বা যেকোনো এককালীন খরচ উইন্ডোর জন্য ভালো। শেষ হলে শেষ। পুনরাবৃত্তি বা উদ্বৃত্ত স্থানান্তর নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal per a un viatge, un cap de setmana d'aniversari o qualsevol finestra de despesa puntual. Quan hagi acabat, haurà acabat. Sense repeticions, sense romanent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideální pro cestu, víkend narozenin nebo libovolné jednorázové výdaje. Jakmile skončí, je to fakt. Žádné opakování, žádný převod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godt til en tur, en fødselsdagsweekend eller ethvert engangsbudget. Når det er slut, er det slut. Ingen gentagelse, ingen overførsel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfekt für eine Reise, ein Wochenende oder eine einmalige Ausgabenspanne. Wenn es vorbei ist, ist es vorbei. Keine Wiederholungen, kein Übertrag."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ιδανικό για ένα ταξίδι, ένα σαββατοκύριακο γενεθλίων ή οποιοδήποτε μεμονωμένο παράθυρο δαπανών. Όταν τελειώνει, τελειώνει. Χωρίς επανάληψη, χωρίς Μεταφορά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good for a trip, a birthday weekend, or any one-off spending window. When it's done, it's done. No repeating, no carry-over."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Good for a trip, a birthday weekend, or any one-off spending window. When it's done, it's done. No repeating, no carry-over."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Good for a trip, a birthday weekend, or any one-off spending window. When it's done, it's done. No repeating, no carry-over."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Good for a trip, a birthday weekend, or any one-off spending window. When it's done, it's done. No repeating, no carry-over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfecto para un viaje, un fin de semana de cumpleaños o cualquier gasto puntual. Cuando se acaba, se acaba. Sin repeticiones, sin remanente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para un viaje, un fin de semana de cumpleaños o cualquier gasto puntual. Cuando termine, termina. Sin repetición, sin saldo acumulado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopii matkalle, syntymäpäiväretkelle tai mihin tahansa kertaluonteiseen menojaksoon. Kun se on ohi, se on ohi. Ei toistamista, ei siirtoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idéal pour un voyage, un week-end festif ou une dépense ponctuelle. Une fois terminé, c'est fini. Pas de répétition, pas de report."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Parfait pour un voyage, une fin de semaine d'anniversaire ou tout autre type de dépense ponctuelle. Quand c'est fait, c'est fait. Pas de répétition, pas de report."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટ્રિપ, જન્મદિનની વીકએન્ડ, અથવા કોઈ એકવારની ખર્ચ વિંડો માટે સારું. એક વાર પૂર્ણ થવા પછી, તે સમાપ્ત છે. કોઈ પુનરાવર્તન નથી, કોઈ આગળ વહન નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתאים לטיול, סוף שבוע יום הולדת, או כל חלון הוצאה חד פעמי. כשזה מסתיים, זה מסתיים. ללא חזרות, ללא יתרה מועברת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह विकल्प किसी यात्रा, जन्मदिन के सप्ताहांत, या किसी एकबारगी खर्च की खिड़की के लिए अच्छा है। जब यह पूरा हो जाए, तो हो गया। कोई दोहराव नहीं, कोई कैरी-ओवर नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Savršeno za putovanje, vikend rođendana ili bilo koji jednokratni rashod. Kada je gotovo, gotovo je. Bez ponavljanja, bez prijenosa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideális egy úthoz, egy születésnapi hétvégéhez vagy bármilyen egymagas kiadási időszakhoz. Ha vége, vége. Nincs ismétlődés, nincs átvitel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocok untuk liburan, perayaan ulang tahun, atau jendela pengeluaran sekali saja. Ketika selesai, ya sudah selesai. Tidak berulang, tidak ada saldo bawaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfetto per una gita, un weekend di compleanno o qualsiasi finestra di spesa una tantum. Quando è finito, è finito. Niente ripetizioni, niente riporto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行や誕生日の週末、その他の一時的な支出の期間に向いています。終わったら終わり。繰り返しなし、繰り越しなし。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟ್ರಿಪ್, ಜನ್ಮದಿನದ ವಾರಾಂತ್ಯ ಅಥವಾ ಯಾವುದೇ ಏಕ-ಬಾರಿ ಖರ್ಚಾಗತಿಕೆಯ ವಿಂಡೋಗಾಗಿ ಸೂಕ್ತ. ಮುಗಿದಾಗ, ಮುಗಿದೆ. ಪುನರಾವರ್ತನೆ ಅಥವಾ ಮುಂದಕ್ಕೆ ಸಾಗಿಸುವಿಕೆ ಇಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행, 생일 주말, 또는 일회성 지출 기간에 좋습니다. 끝나면 끝입니다. 반복 없음, 이월 없음."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "യാത്ര, ജന്മദിന പലായനം, അല്ലെങ്കിൽ ഏതെങ്കിലും ഒരു തവണ വ്യയ വിൻഡോയ്ക്ക് നല്ലത്. കഴിഞ്ഞാൽ കഴിഞ്ഞത്. ആവർത്തനം ഇല്ല, കാരി-ഓവർ ഇല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यात्रेसाठी, वाढदिवस सुट्टीसाठी किंवा कोणत्याही एकबारी खर्च खिडकीसाठी चांगले. एकदा संपल्यानंतर, संपले. पुन्हा न होणारे, पुढे नेलेली शिल्लक नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagus untuk perjalanan, ulang tahun akhir pekan, atau tetingkap perbelanjaan sekali sahaja. Apabila selesai, selesai. Tiada pengulangan, tiada bawa ke hadapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Egnet til en tur, en bursdagshelg eller et hvilket som helst engangs-utgiftsvinduer. Når det er gjort, er det gjort. Ingen gjentagelse, ingen overføring."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handig voor een tripje, een verjaardagsweekend of een eenmalig uitgavenkader. Klaar is klaar. Geen herhaling, geen overdracht."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯାତ୍ରା, ଜନ୍ମଦିନ ସପ୍ତାହ, କିମ୍ବା ଯେକୌଣସି ଏକକାଳୀନ ଖର୍ଚ୍ଚ ଜାନକାରୀ ପାଇଁ ଭଲ। ସାରିବାପରେ ସାରିଯାଏ। ପୁନରାବୃତ୍ତି ନାହିଁ, ଆଗକୁ ନିଆ ବାକି ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਫ਼ਰ, ਜਨਮਦਿਨ ਦਾ ਪਿੱਛਾ ਖਿਲਾਰੀ, ਜਾਂ ਕੋਈ ਵੀ ਇਕੱਲੀ ਖਰਚ ਖਿੜਕੀ ਲਈ ਚੰਗਾ। ਜਦੋਂ ਇਹ ਪੂਰਾ ਹੋ, ਇਹ ਪੂਰਾ ਹੋ। ਕੋਈ ਦੋਬਾਰਾ ਨਹੀਂ, ਕੋਈ ਅੱਗੇ ਲਿਜਾਣਾ ਨਹੀਂ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Idealne na wyjazd, weekend urodzin czy każdy jednorazowy okres wydatków. Kiedy się skończy, koniec. Bez powtarzania, bez przeniesienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para uma viagem, um fim de semana de aniversário ou qualquer período de gastos pontuais. Quando acaba, acaba. Sem repetição, sem saldo acumulado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para uma viagem, um fim de semana de aniversário ou qualquer período de gastos único. Quando termina, termina. Sem repetição, sem transição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal pentru o călătorie, un weekend de ziua de naștere sau orice fereastră de cheltuieli o singură dată. Când se termină, se termină. Fără repetări, fără report."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходит для поездки, выходных или разового периода трат. Когда закончится — всё. Без повторения, без переноса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vhodné na cestu, narodeninový víkend alebo akýkoľvek jednorázový výdavkový okno. Keď je to hotové, je to hotové. Bez opakovania, bez prenosu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobro za potovanje, praznovanje ali dogovoren čas porabe. Ko je končano, je končano. Brez ponavljanja, brez prenosa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bra för en resa, en födelsedag eller någon engångskostnad. När det är klart, är det klart. Ingen upprepning, ingen överföring."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு பயணம், ஜன்மநாள் வார முடிவு அல்லது எந்தவொரு ஒரு முறை செலவு சாளரத்திற்கும் நல்லது. முடிந்தவுடன், முடிந்துவிட்டது. மீண்டும் செய்தல் இல்லை, முன்கொண்டுசெல் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రిప్, పుట్టినరోజు వాయిదా, లేదా ఏదైనా ఏకైక ఖర్చు విండోకు మంచిది. ఇది పూర్తయిన తర్వాత, ఇది పూర్తయింది. పునరావృత్తి లేదు, క్యారీ-ఓవర్ లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหมาะสำหรับการเดินทาง วันเกิด หรือช่วงเวลาใช้จ่ายครั้งเดียว เมื่อสิ้นสุด ก็จบสิ้น ไม่มีการเกิดซ้ำ ไม่มียอดยกมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir gezi, doğum günü hafta sonu ya da tek seferlik harcama penceresine uygun. Bittiyse, bitti. Tekrar etmez, devir olmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підходить для подорожі, святкових вихідних або будь-якого разового періоду витрат. Коли закінчиться — готово. Без повторень, без перенесення залишку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک سفر، سالگرہ کے ہفتہ انت، یا کسی بھی ایک مرتبہ خرچ کی کھڑکی کے لیے اچھا ہے۔ جب یہ ختم ہو تو ختم ہو۔ کوئی دہرایا جانا نہیں، کوئی آگے منتقلی نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phù hợp cho chuyến đi, một kỳ lễ sinh nhật hay bất kỳ khoảng thời gian chi tiêu một lần nào. Khi nó kết thúc, nó kết thúc. Không lặp lại, không chuyển tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合出游、生日聚会或任何一次性消费周期。完成后就此结束，无需重复，无需结转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適合旅行、生日週末或任何一次性消費期間。完成後就結束。無重複，無結轉。"
          }
        }
      }
    },
