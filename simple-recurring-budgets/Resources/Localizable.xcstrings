        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoví rozpočet, abyste mohli znovu zaznamenávat výdaje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoptager budgettet, så du kan registrere udgifter igen"
          }
