    "budgetDetail.action.resume.accessibilityHint": {
      "comment": "VoiceOver hint for the resume budget button",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستأنف الميزانية حتى تتمكن من تسجيل النفقات مرة أخرى"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাজেট পুনরায় শুরু করে যাতে আপনি খরচ লগ করতে পারেন"
