    "budgetDetail.resetBudget.dialog.message": {
      "comment": "Body of the reset-budget confirmation dialog.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف جميع المصروفات نهائياً، وسيتم إعادة تعيين المُرحَّل إلى صفر، وإذا كانت متوقفة مؤقتاً، ستستأنف الميزانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমস্ত খরচ স্থায়ীভাবে মুছে ফেলা হবে, উদ্বৃত্ত স্থানান্তর শূন্যে রিসেট হবে এবং বিরতিতে থাকলে বাজেট পুনরায় শুরু হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Totes les despeses es suprimiran permanentment, el romanent es restablirà a zero i, si està en pausa, el pressupost es reprendrà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny výdaje budou trvale smazány, převod se resetuje na nulu a pokud je pozastavený, rozpočet se obnoví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle udgifter slettes permanent, overførsel nulstilles til nul, og hvis budgettet er på pause, genoptages det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Ausgaben werden dauerhaft gelöscht, der Übertrag wird auf null zurückgesetzt, und das Budget wird fortgesetzt, falls pausiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα τα Έξοδα θα διαγραφούν μόνιμα, η Μεταφορά θα επαναφερθεί στο μηδέν και, εάν είναι σε παύση, ο Προϋπολογισμός θα συνεχιστεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All expenses will be permanently deleted, carry-over will reset to zero, and if paused, the budget will resume."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "All expenses will be permanently deleted, carry-over will reset to zero, and if paused, the budget will resume."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "All expenses will be permanently deleted, carry-over will reset to zero, and if paused, the budget will resume."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "All expenses will be permanently deleted, carry-over will reset to zero, and if paused, the budget will resume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los gastos se eliminarán permanentemente, el remanente se restablecerá a cero y, si está en pausa, el presupuesto se reanudará."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los gastos se eliminarán permanentemente, el saldo acumulado se restablecerá a cero y, si está en pausa, el presupuesto se reanudará."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki menot poistetaan pysyvästi, siirto nollataan ja jos budjetti on keskeytetty, se jatketaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les dépenses seront définitivement supprimées, le report sera réinitialisé à zéro et, s'il est suspendu, le budget reprendra."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les dépenses seront supprimées définitivement, le report sera réinitialisé à zéro, et si le budget est suspendu, il sera repris."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધો ખર્ચ સ્થાયી રીતે કાઢી નાખવામાં આવશે, આગળ વહન શૂન્યમાં ફરી સેટ થશે, અને બજેટ થોભાવેલો હોય તો તે ફરી શરૂ થશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל ההוצאות יימחקו לצמיתות, יתרה מועברת תאופס לאפס, ואם מושהה, התקציב יחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी खर्चों को स्थायी रूप से हटा दिया जाएगा, कैरी-ओवर शून्य पर रीसेट हो जाएगा, और यदि रोका गया है तो बजट फिर से शुरू हो जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi će se troškovi trajno izbrisati, prijenos će biti poništen na nulu i ako je pauzirano, proračun će se nastaviti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összes kiadás véglegesen törlődik, az átvitel nullára áll vissza, és ha szünetel, a költségkeret folytatódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua pengeluaran akan dihapus secara permanen, saldo bawaan akan diatur ulang ke nol, dan jika dijeda, anggaran akan dilanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le spese verranno eliminate definitivamente, il riporto verrà reimpostato a zero e, se sospeso, il budget verrà ripreso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての支出が完全に削除され、繰り越しがゼロにリセットされ、一時停止中であれば予算が再開されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲಾ ಖರ್ಚುಗಳನ್ನು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಲಾಗುತ್ತದೆ, ಮುಂದಕ್ಕೆ ಸಾಗಿಸುವಿಕೆ ಶೂನ್ಯಕ್ಕೆ ಮರುಹೊಂದಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ವಿರಾಮಗೊಂಡಿದ್ದರೆ, ಬಜೆಟ್ ಮುಂದುವರಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 지출이 영구 삭제되고, 이월은 0으로 재설정되며, 일시 중지됨 상태라면 예산이 재개됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ ചെലവുകളും നിരന്തരമായി ഇല്ലാതാക്കപ്പെടും, കാരി-ഓവർ പൂജ്യത്തിലേക്ക് പുനഃസജ്ജിക്കപ്പെടും, ഉം നിർത്തിയാണെങ്കിൽ ബജറ്റ് പുനരാരംഭിക്കപ്പെടും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व खर्च कायमचे हटवले जाईल, पुढे नेलेली शिल्लक शून्यावर रीसेट होईल, आणि जर थांबवलेले असेल तर budget पुन्हा सुरू होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua perbelanjaan akan dipadamkan secara kekal, bawa ke hadapan akan ditetapkan semula kepada sifar, dan jika dijeda, bajet akan disambung semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle utgifter slettes permanent, overføring nullstilles til null, og hvis budsjettet er på pause, gjenopptas det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle uitgaven worden permanent verwijderd, de overdracht wordt ingesteld op nul en het budget wordt hervat als het was gepauzeerd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସମସ୍ତ ଖର୍ଚ୍ଚ ସ୍ଥାୟୀଭାବେ ବିଲୋପ ହେବ, ଆଗକୁ ନିଆ ବାକି ଶୂନ୍ୟକୁ ପୁନଃସେଟ୍ ହେବ, ଏବଂ ବିରତ ଥିଲେ ବଜେଟ୍ ପୁନଃଆରମ୍ଭ ହେବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰੇ ਖਰਚੇ ਸਥਾਈ ਤੌਰ ਤੇ ਮਿਟਾ ਦਿੱਤੇ ਜਾਣਗੇ, ਅੱਗੇ ਲਿਜਾਣਾ ਸਿਫ਼ਰ ਵਿੱਚ ਮੁੜ-ਸੈੱਟ ਹੋਵੇਗਾ, ਅਤੇ ਜੇ ਰੋਕਿਆ ਹੋ ਤਾਂ ਬਜਟ ਮੁੜ-ਸ਼ੁਰੂ ਹੋਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie wydatki zostaną trwale usunięte, przeniesienie resetuje się do zera, a budżet zostanie wznowiony, jeśli był wstrzymany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as despesas serão permanentemente deletadas, o saldo acumulado será redefinido para zero e, se pausado, o orçamento será retomado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as despesas serão apagadas permanentemente, a transição será reposta para zero e, se em pausa, o orçamento será retomado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate cheltuielile vor fi șterse permanent, reportul va fi resetat la zero, iar dacă este întrerupt, bugetul va fi reluat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все расходы будут безвозвратно удалены, перенос обнулится, и если бюджет приостановлен, он возобновится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky výdavky budú natrvalo odstránené, prenos bude vynulovaný na nulu a ak je pozastavený, rozpočet bude obnovený."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi stroški bodo trajno izbrisani, prenos se bo ponastavil na nič in, če je pavziran, se bo proračun nadaljeval."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla utgifter raderas permanent, överföring återställs till noll och budgeten återupptas om den är pausad."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்து செலவுகளும் நிரந்தரமாக நீக்கப்படும், முன்கொண்டுசெல் பூஜ்ஜியத்திற்கு மீட்டமைக்கப்படும், மற்றும் இடைநிறுத்தப்பட்டால், பட்ஜெட் தொடர்ப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమస్త ఖర్చులు శాశ్వతంగా తొలగించబడతాయి, క్యారీ-ఓవర్ సున్నాకు రీసెట్ చేయబడుతుంది మరియు బడ్జెట్ విరామంలో ఉంటే కొనసాగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายจ่ายทั้งหมดจะถูกลบอย่างถาวร ยอดยกมาจะรีเซ็ตเป็นศูนย์ และถ้าหยุดชั่วคราว งบประมาณจะดำเนินต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm harcamalar kalıcı olarak silinecek, devir sıfıra sıfırlanacak ve bütçe duraklatılmışsa sürdürülecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Всі витрати будуть назавжди видалені, перенесення залишку скидається до нуля, і якщо бюджет призупинено, він буде відновлений."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام اخراجات مستقل طور پر حذف ہوں گے، آگے منتقلی صفر پر ری سیٹ ہوگی، اور اگر روکا ہوا ہے تو بجٹ دوبارہ شروع ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi khoản chi sẽ bị xóa vĩnh viễn, chuyển tiếp sẽ đặt lại thành không, và nếu tạm dừng, ngân sách sẽ tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有支出将被永久删除、结转重置为零，以及如果已暂停，预算将恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有支出將永久刪除，結轉將重設為零，若已暫停，預算將繼續。"
          }
        }
      }
    },
