    "addEditExpense.addFunds.toggle.caption": {
      "comment": "Explanatory caption below the Add Funds toggle (F-6.01)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف إلى رصيدك المتبقي بدلاً من الطرح."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix al saldo restant en lloc de restar-hi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá k zbývajícímu zůstatku místo odečtení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lægger til din resterende saldo i stedet for at trække fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöht dein Restguthaben, anstatt es zu verringern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προστίθεται στο υπόλοιπό σας αντί να αφαιρείται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds to your remaining balance instead of subtracting."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds to your remaining balance instead of subtracting."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds to your remaining balance instead of subtracting."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds to your remaining balance instead of subtracting."
          }
        },
