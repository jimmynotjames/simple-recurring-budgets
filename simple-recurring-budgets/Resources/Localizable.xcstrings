          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अ‍ॅपमध्ये जतन केल्यात वारंवार अपयश आली. निदान संदर्भ (व्यक्तिगत डेटा नाही):"
          }
        },
        "ms": {
