    "saveError.alert.sendFeedback": {
      "comment": "Button on the save-failure alert that opens an email to the developer prefilled with non-PII error context. Only appears after three consecutive failures.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال ملاحظات"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia comentaris"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeslat zpětnou vazbu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send feedback"
          }
        },
