    "feedback.email.body.intro": {
      "comment": "First sentence of the auto-filled email body shown when the user taps Send Feedback after a repeated save failure. Reassures them that no personal data is included.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الحفظ في التطبيق مرارًا وتكرارًا. سياق تشخيصي (بدون بيانات شخصية):"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপে একটি সংরক্ষণ বারবার ব্যর্থ হয়েছে। ডায়াগনস্টিক প্রসঙ্গ (কোনো ব্যক্তিগত ডেটা নেই):"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una operació de desar a l'app ha fallat repetidament. Context de diagnòstic (sense dades personals):"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukládání v aplikaci se opakovně nezdařilo. Diagnostické informace (bez osobních údajů):"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En gemning i appen mislykkedes gentagne gange. Diagnostisk kontekst (ingen personlige data):"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Speichern in der App ist wiederholt fehlgeschlagen. Diagnosedaten (keine persönlichen Daten):"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποτυχία αποθήκευσης στην εφαρμογή επανειλημμένα. Διαγνωστικό περιεχόμενο (χωρίς προσωπικά δεδομένα):"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A save in the app failed repeatedly. Diagnostic context (no personal data):"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A save in the app failed repeatedly. Diagnostic context (no personal data):"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A save in the app failed repeatedly. Diagnostic context (no personal data):"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A save in the app failed repeatedly. Diagnostic context (no personal data):"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un guardado en la app falló repetidamente. Contexto de diagnóstico (sin datos personales):"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló un guardado en la app repetidamente. Contexto de diagnóstico (sin datos personales):"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksessa tallennus epäonnistui toistuvasti. Diagnostiikat (ei henkilötietoja):"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde dans l'app a échoué plusieurs fois. Contexte de diagnostic (aucune donnée personnelle) :"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde dans l'application a échoué à plusieurs reprises. Contexte de diagnostic (aucune donnée personnelle) :"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપ્લિકેશનમાં સાચવણું વારંવાર નિષ્ફળ થયું. નિદાનસ્થાનીય સંદર્ભ (કોઈ ગોપનીય ડેટા નથી):"
