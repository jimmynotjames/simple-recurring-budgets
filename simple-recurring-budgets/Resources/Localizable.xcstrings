            "value": "يفتح بريداً إلكترونياً جديداً لإرسال تعليقات حول التطبيق"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ সম্পর্কে মতামত পাঠাতে একটি নতুন ইমেল খোলে"
          }
