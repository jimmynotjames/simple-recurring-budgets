          "stringUnit": {
            "state": "translated",
            "value": "Se suma a tu saldo restante en lugar de restar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se suma al saldo restante en lugar de restar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää jäljellä olevaan saldoosi vähentämisen sijaan."
          }
