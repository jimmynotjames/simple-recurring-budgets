    "budgetDetail.menu.resetBudget.accessibilityHint": {
      "comment": "VoiceOver hint for the destructive Reset Budget menu item, communicating the irreversible consequence",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف نهائياً جميع المصروفات لهذه الميزانية، وينعيد تعيين المُرحَّل إلى صفر، ويستأنف الميزانية إن كانت متوقفة مؤقتاً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বাজেটের প্রতিটি খরচ স্থায়ীভাবে মুছে ফেলে, উদ্বৃত্ত স্থানান্তর শূন্যে রিসেট করে এবং বাজেট পুনরায় শুরু করে যদি বিরতিতে থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Suprimeix permanentment totes les despeses d'aquest pressupost, restableix el romanent a zero i repren el pressupost si està en pausa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvale odstraní všechny výdaje pro tento rozpočet, resetuje převod na nulu a obnoví rozpočet, pokud je pozastavený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter alle udgifter for dette budget permanent, nulstiller overførsel til nul og genoptager budgettet, hvis det er på pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht alle Ausgaben dieses Budgets dauerhaft, setzt den Übertrag auf null zurück und setzt das Budget fort, falls pausiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει μόνιμα όλα τα Έξοδα για αυτόν τον Προϋπολογισμό, επαναφέρει τη Μεταφορά στο μηδέν και συνεχίζει το Προϋπολογισμό εάν είναι σε παύση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes every expense for this budget, resets carry-over to zero, and resumes the budget if it is paused."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes every expense for this budget, resets carry-over to zero, and resumes the budget if it is paused."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes every expense for this budget, resets carry-over to zero, and resumes the budget if it is paused."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes every expense for this budget, resets carry-over to zero, and resumes the budget if it is paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente todos los gastos de este presupuesto, restablece el remanente a cero y reanuda el presupuesto si está en pausa."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente todos los gastos de este presupuesto, restablece el saldo acumulado a cero y reanuda el presupuesto si está en pausa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa pysyvästi kaikki tämän budjetin menot, nollaa siirron ja jatkaa budjettia, jos se on keskeytetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement toutes les dépenses de ce budget, réinitialise le report à zéro et reprend le budget s'il est suspendu."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement toutes les dépenses pour ce budget, réinitialise le report à zéro et reprend le budget s'il est suspendu."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ બજેટનો બધો ખર્ચ સ્થાયી રીતે કાઢી નાખે છે, આગળ વહનને શૂન્યમાં ફરી સેટ કરે છે, અને બજેટ થોભાવેલો હોય તો તેને ફરી શરૂ કરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחק לצמיתות כל הוצאה עבור התקציב זה, אפס יתרה מועברת לאפס, וחזור את התקציב אם הוא מושהה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बजट के लिए सभी खर्चों को स्थायी रूप से हटाता है, कैरी-ओवर को शून्य पर रीसेट करता है, और यदि बजट रोका गया है तो फिर से शुरू करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajno briše sve troškove za ovaj proračun, poništava prijenos na nulu i nastavlja proračun ako je pauzirano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Véglegesen törli ennek a költségkeretnek az összes kiadását, nullára állítja az átvitelt és folytatja a költségkeretet, ha szünetel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus semua pengeluaran untuk anggaran ini secara permanen, mengatur ulang saldo bawaan ke nol, dan melanjutkan anggaran jika dijeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente tutte le spese di questo budget, reimposta il riporto a zero e riprende il budget se sospeso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この予算のすべての支出を完全に削除し、繰り越しをゼロにリセットし、一時停止中であれば予算を再開します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಬಜೆಟ್‌ಗಾಗಿ ಪ್ರತಿಯೊಂದು ಖರ್ಚುವನ್ನು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸುತ್ತದೆ, ಮುಂದಕ್ಕೆ ಸಾಗಿಸುವಿಕೆ ಶೂನ್ಯಕ್ಕೆ ಮರುಹೊಂದಿಸುತ್ತದೆ ಮತ್ತು ವಿರಾಮಗೊಂಡಿದ್ದರೆ ಬಜೆಟ್ ಮುಂದುವರಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 예산의 모든 지출을 영구 삭제하고, 이월을 0으로 재설정하며, 일시 중지됨 상태라면 예산을 재개합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ബജറ്റിന്റെ ഓരോ ചെലവും നിരന്തരമായി ഇല്ലാതാക്കുന്നു, കാരി-ഓവർ പൂജ്യത്തിലേക്ക് പുനഃസജ്ജിക്കുന്നു, ഉം നിർത്തിയാണെങ്കിൽ ബജറ്റ് പുനരാരംഭിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या budget साठी प्रत्येक खर्च कायमचे हटवते, पुढे नेलेली शिल्लक शून्यावर रीसेट करते, आणि जर budget थांबवलेले असेल तर पुन्हा सुरू करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadamkan semua perbelanjaan bajet ini secara kekal, menetapkan semula bawa ke hadapan kepada sifar, dan menyambung semula bajet jika dijeda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter alle utgifter for dette budsjettet permanent, nullstiller overføring til null, og gjenopptar budsjettet hvis det er på pause."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert alle uitgaven voor dit budget definitief, stelt overdracht in op nul en hervatting als het budget is gepauzeerd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ବଜେଟ୍ ର ସମସ୍ତ ଖର୍ଚ୍ଚ ସ୍ଥାୟୀଭାବେ ବିଲୋପ କରେ, ଆଗକୁ ନିଆ ବାକି ଶୂନ୍ୟକୁ ପୁନଃସେଟ୍ କରେ, ଏବଂ ବିରତ ଥିଲେ ବଜେଟ୍ ପୁନଃଆରମ୍ଭ କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਬਜਟ ਲਈ ਹਰ ਖਰਚ ਸਥਾਈ ਤੌਰ ਤੇ ਮਿਟਾ ਦਿੰਦਾ ਹੈ, ਅੱਗੇ ਲਿਜਾਣਾ ਸਿਫ਼ਰ ਵਿੱਚ ਮੁੜ-ਸੈੱਟ ਕਰਦਾ ਹੈ, ਅਤੇ ਜੇ ਰੋਕਿਆ ਹੋ ਤਾਂ ਬਜਟ ਮੁੜ-ਸ਼ੁਰੂ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usuwa wszystkie wydatki dla tego budżetu, resetuje przeniesienie do zera i wznawia budżet, jeśli jest wstrzymany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleta permanentemente todas as despesas deste orçamento, reseta o saldo acumulado para zero e retoma o orçamento se pausado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga permanentemente todas as despesas deste orçamento, repõe a transição para zero e retoma o orçamento se estiver em pausa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge permanent fiecare cheltuială pentru acest buget, resetează reportul la zero și reia bugetul dacă este întrerupt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удаляет все расходы, сбрасывает перенос на ноль и возобновляет бюджет, если он приостановлен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrvalo odstráni všetky výdavky tohto rozpočtu, vynuluje prenos na nulu a obnoví rozpočet, ak je pozastavený."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajno izbriše vse stroške za ta proračun, ponastavi prenos na nič in nadaljuje proračun, če je začasno ustavljen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderar varje utgift för denna budget, återställer överföring till noll och återupptar budgeten om den är pausad."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பட்ஜெட்டின் ஒவ்வொரு செலவையும் நிரந்தரமாக நீக்குகிறது, முன்கொண்டுசெல்லை பூஜ்ஜியமாக மீட்டமைக்கிறது, மற்றும் பட்ஜெட் இடைநிறுத்தப்பட்டால் அதைத் தொடர்க்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ బడ్జెట్ కోసం ప్రతి ఖర్చును శాశ్వతంగా తొలగిస్తుంది, క్యారీ-ఓవర్‌ను సున్నాకు రీసెట్ చేస్తుంది మరియు బడ్జెట్ విరామంలో ఉంటే కొనసాగిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบรายจ่ายทั้งหมดของงบประมาณนี้อย่างถาวร รีเซ็ตยอดยกมาเป็นศูนย์ และดำเนินต่องบประมาณถ้าหยุดชั่วคราวไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bütçenin tüm harcamalarını kalıcı olarak siler, devir bakiyesini sıfırlarla ve bütçe duraklatılmışsa sürdürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назавжди видаляє всі витрати цього бюджету, скидає перенесення залишку до нуля й відновлює бюджет, якщо він призупинено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس بجٹ کے ہر اخراج کو مستقل طور پر حذف کرتا ہے، آگے منتقلی کو صفر پر ری سیٹ کرتا ہے، اور اگر روکا ہوا ہے تو بجٹ کو دوبارہ شروع کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa vĩnh viễn mọi khoản chi cho ngân sách này, đặt lại chuyển tiếp thành không và tiếp tục ngân sách nếu nó đã tạm dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除此预算的所有支出、重置结转为零，以及恢复已暂停的预算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除此預算的所有支出，將結轉重設為零，並在暫停時繼續預算。"
          }
        }
      }
    },
