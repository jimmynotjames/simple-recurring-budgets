    "budgetDetail.action.resume.caption.format": {
      "comment": "Caption below the Resume Budget button; argument is the abbreviated pause date",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقفة منذ %@. استأنف لتسجيل نفقات جديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ থেকে বিরতিতে। নতুন খরচ লগ করতে পুনরায় শুরু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa des de %@. Reprèn per registrar noves despeses."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastaveno od %@. Obnovte pro zaznamenání nových výdajů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat på pause siden %@. Genoptag for at registrere nye udgifter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert seit %@. Fortsetzen, um neue Ausgaben zu erfassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε παύση από %@. Συνέχισε για να καταγράψεις νέα έξοδα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused since %@. Resume to log new expenses."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused since %@. Resume to log new expenses."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused since %@. Resume to log new expenses."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused since %@. Resume to log new expenses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa desde %@. Reanuda para registrar nuevos gastos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa desde %@. Reanuda para registrar nuevos gastos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskeytetty %@ lähtien. Jatka kirjataksesi uusia kuluja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendu depuis le %@. Reprendre pour enregistrer de nouvelles dépenses."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendu depuis %@. Reprendre pour enregistrer de nouvelles dépenses."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ થી થોભાવેલું. નવો ખર્ચ નોંધવા માટે ફરી શરૂ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מושהה מאז %@. חדש כדי לרשום הוצאות חדשות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ से रुका हुआ। नए खर्च दर्ज करने के लिए फिर शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzirano od %@. Nastavi za unos novih troškova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szüneteltetve %@ óta. Folytasd új kiadások rögzítéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda sejak %@. Lanjutkan untuk mencatat pengeluaran baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa dal %@. Riprendi per registrare nuove spese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から一時停止中。再開して新しい支出を記録してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ರಿಂದ ವಿರಾಮಗೊಂಡಿದೆ. ಹೊಸ ಖರ್ಚುಗಳನ್ನು ಲಾಗ್ ಮಾಡಲು ಮುಂದುವರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@부터 일시정지됨. 재개하여 새 지출을 기록하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ മുതൽ താൽക്കാലികമായി നിർത്തിയിരിക്കുന്നു. പുതിയ ചെലവുകൾ ലോഗ് ചെയ്യാൻ പുനരാരംഭിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पासून थांबवलेले. नवीन खर्च नोंद करण्यासाठी पुन्हा सुरू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda sejak %@. Sambung semula untuk log perbelanjaan baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Satt på pause siden %@. Gjenoppta for å registrere nye utgifter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerd sinds %@. Hervat om nieuwe uitgaven bij te houden."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ଠାରୁ ବିରତ। ଖର୍ଚ୍ଚ ଲଗ୍ କରିବା ଆରମ୍ଭ କରିବାକୁ ପୁନଃଆରମ୍ଭ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਤੋਂ ਰੋਕਿਆ। ਨਵੇਂ ਖਰਚੇ ਲਾਗ ਕਰਨ ਲਈ ਮੁੜ-ਸ਼ੁਰੂ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymano od %@. Wznów, aby rejestrować nowe wydatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado desde %@. Retome para registrar novas despesas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em pausa desde %@. Retoma para registar novas despesas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În pauză din %@. Reia pentru a înregistra cheltuieli noi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На паузе с %@. Возобнови, чтобы добавлять расходы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastavené od %@. Obnovte pre zaznamenanie nových výdavkov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začasno ustavljeno od %@. Nadaljuj za beleženje novih stroškov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausad sedan %@. Återuppta för att registrera nya utgifter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ முதல் இடைநிறுத்தப்பட்டது. புதிய செலவுகளைப் பதிவுசெய்ய தொடர்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "విరామం %@ నుండి. కొత్త ఖర్చులను నమోదు చేయడానికి కొనసాగించండి."
