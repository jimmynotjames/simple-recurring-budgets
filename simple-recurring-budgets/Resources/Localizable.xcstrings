        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಪ್ಲಿಕೇಶನ್ ಬಗ್ಗೆ ಪ್ರತಿಕ್ರಿಯೆ ಕಳುಹಿಸಲು ಹೊಸ ಇಮೇಲ್ ತೆರೆಯುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에 대한 피드백을 보낼 새 이메일을 열어요"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്ലിക്കേഷനെക്കുറിച്ച് ഫീഡ്‌ബാക്ക് അയയ്ക്കാൻ പുതിയ ഈ-മെയിൽ തുറക്കുന്നു"
          }
        },
        "mr": {
