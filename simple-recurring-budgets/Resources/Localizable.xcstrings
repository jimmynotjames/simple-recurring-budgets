        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На паузі з %@. Ви все ще можете додавати витрати з ранішою датою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạm dừng từ %@. Bạn vẫn có thể thêm chi phí có ngày trước thời điểm đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自%@起已暂停。您仍可添加更早日期的支出。"
          }
