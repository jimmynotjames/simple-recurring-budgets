    "budgetDetail.menu.resetCarryOver.accessibilityHint": {
      "comment": "VoiceOver hint for the Reset Carry-Over menu item, communicating the destructive (but non-cascading) consequence",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسح رصيد المُرحَّل إلى صفر. المصروفات لن تتأثر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উদ্বৃত্ত স্থানান্তর ব্যালেন্স শূন্যে সাফ করে। খরচ প্রভাবিত হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Buida el saldo del romanent a zero. Les despeses no es veuen afectades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vynuluje zůstatek převodu na nulu. Výdaje nejsou ovlivněny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rydder overførselssaldoen til nul. Udgifter påvirkes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt den Übertrag auf null zurück. Ausgaben bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει το Υπόλοιπο Μεταφοράς. Τα Έξοδα δεν επηρεάζονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears the carry-over balance to zero. Expenses are not affected."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears the carry-over balance to zero. Expenses are not affected."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears the carry-over balance to zero. Expenses are not affected."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears the carry-over balance to zero. Expenses are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacía el saldo de remanente a cero. Los gastos no se ven afectados."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra el saldo acumulado a cero. Los gastos no se ven afectados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjentää siirron saldoon nollaan. Menot eivät muutu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface le solde du report à zéro. Les dépenses ne sont pas affectées."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface le solde du report à zéro. Les dépenses ne sont pas affectées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આગળ વહન શેષ રાશિને શૂન્યમાં સાફ કરે છે. ખર્ચ અસરગ્રસ્ત નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקה את יתרת היתרה המועברת לאפס. הוצאות לא מושפעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैरी-ओवर शेष को शून्य पर साफ़ करता है। खर्च प्रभावित नहीं होते हैं।"
