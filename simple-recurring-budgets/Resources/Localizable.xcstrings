    "consent.analytics.sheet.accept" : {
      "comment" : "Accept button on the analytics consent sheet; tapping opts the user in to analytics",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Share Anonymous Usage Data"
          }
        }
      }
    },
    "consent.analytics.sheet.body" : {
      "comment" : "Body of the first-run analytics consent sheet. Describes what is and is not transmitted (mirrors §5 analytics-spec.md). Discloses budget_name and budget_allocation_amount as accepted-risk exceptions per §5.4.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To understand how the app is used, this app can send anonymous usage data to Mixpanel. Here's what's shared:\n\n✓ Categorical Budget settings (period, currency code, carry-over on/off)\n✓ Bucketed counts (number of budgets)\n✓ Budget names and allocation amounts are included as an accepted trade-off so patterns across budgets are visible in aggregate\n\nHere's what's never shared:\n\n✗ Expense names, amounts, or dates\n✗ Any iCloud or Apple ID identifier\n✗ Free-text notes or personal information\n\nThe initial setting was chosen automatically based on your device's region and can be changed at any time in Settings → Diagnostics & Analytics."
          }
        }
      }
    },
    "consent.analytics.sheet.decline" : {
      "comment" : "Decline button on the analytics consent sheet; tapping keeps analytics off",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No Thanks"
          }
        }
      }
    },
