    "addEditExpense.recents.tile.accessibilityHint": {
      "comment": "VoiceOver hint for an F-7.04 Recents tile; explains the tap populates the draft for review and does not save.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يملأ المبلغ والوصف للمراجعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পর্যালোচনার জন্য পরিমাণ এবং বিবরণ পূরণ করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Omple l'import i la descripció per revisar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplní částku a popis ke kontrole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udfylder beløbet og beskrivelsen til gennemsyn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt den Betrag und die Beschreibung zur Überprüfung aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμπληρώνει το ποσό και την περιγραφή για αναθεώρηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fills the amount and description for review."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Fills the amount and description for review."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Fills the amount and description for review."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Fills the amount and description for review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa el importe y la descripción para revisar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa la cantidad y descripción para revisar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täyttää summan ja kuvauksen tarkistusta varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplit le montant et la description pour examen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplit le montant et la description pour révision."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમીક્ષા માટે રકમ અને વર્ણન ભરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מילוי הסכום והתיאור לבדיקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राशि और विवरण समीक्षा के लिए भरता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popunjava iznos i opis za pregled."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítja az összeget és a leírást az ellenőrzéshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengisi jumlah dan deskripsi untuk ditinjau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compila l'importo e la descrizione per la revisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額と説明を入力して確認できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿಮರ್ಶೆಗಾಗಿ ಮೊತ್ತ ಮತ್ತು ವಿವರಣೆಯನ್ನು ಭರ್ತಿ ಮಾಡುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액과 설명이 검토를 위해 입력됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സമീക്ഷയ്ക്കായി തുക ഉം വിവരണം പൂരിപ്പിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनरावलोकनसाठी रक्कम आणि वर्णन भरते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengisi jumlah dan penerangan untuk semakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyller inn beløpet og beskrivelsen for gjennomgang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vult het bedrag en de beschrijving in ter controle."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସମୀକ୍ଷା ପାଇଁ ରାଶି ଏବଂ ବର୍ଣ୍ଣନା ଭରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਾਂਚ ਲਈ ਰਕਮ ਅਤੇ ਵੇਰਵਾ ਭਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypełnia kwotę i opis do przeglądu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenche o valor e a descrição para revisão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenche o valor e a descrição para revisão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Completează suma și descrierea pentru revizuire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполняет сумму и описание для проверки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplní sumu a popis na kontrolu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izpolni znesek in opis za pregled."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyller i belopp och beskrivning för granskning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மதிப்பாய়வுக்கான தொகை மற்றும் விளக்கத்தை நிரப்புகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమీక్ష కోసం మొత్తం మరియు వివరణను నింపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอกจำนวนเงินและคำอธิบายสำหรับการตรวจสอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutar ve açıklamayı gözden geçirme için doldurur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заповнює суму та опис для перевірки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جائزے کے لیے رقم اور تفصیل بھرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điền số tiền và mô tả để xem xét."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填充金额和说明以供审核。"
