    "addEditBudget.note.carryOver": {
      "comment": "Caption below the carry-over toggle explaining what carry-over does",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تراكمي للإنفاق الزائد والناقص عبر الفترات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Acumula les despeses i els estalvis de períodes anteriors."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumulativní přečerpání a nedočerpání napříč obdobími."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumulativ over- og underforbrug på tværs af perioder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumulative Über- und Unterschreitung über Zeiträume hinweg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συσσωρευτικό υπέρ- και υπό-δαπάνη σε όλες τις περιόδους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumulative over- and under-spending across periods."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumulative over- and under-spending across periods."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumulative over- and under-spending across periods."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumulative over- and under-spending across periods."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasto acumulado de más o de menos entre períodos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Acumula el exceso y el déficit de gasto entre periodos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumulatiivinen ylite ja alijäämä jaksojen välillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumul des dépassements et économies sur plusieurs périodes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumule les dépassements et économies d'une période à l'autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צבירה של הוצאות יתר והוצאות חסרות לאורך תקופות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अवधियों में संचित अधिक- और कम-खर्च।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumulativna prekoračenja i uštedine kroz razdoblja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felhalmozódó túl- és alulköltés az időszakok között."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengakumulasi kelebihan dan kekurangan pengeluaran lintas periode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accumula saldi positivi e negativi tra i periodi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間をまたいだ累積的な予算超過と不足。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기간별 초과 및 미달 지출이 누적 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
