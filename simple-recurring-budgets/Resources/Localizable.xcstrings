    "addEditExpense.paused.caption.format": {
      "comment": "Proactive caption shown below the When card in Add/Edit Expense when the bound budget is paused; argument is the abbreviated pausedSince date",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقفة منذ %@. لا يزال بإمكانك إضافة نفقات بتاريخ سابق لذلك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa des de %@. Encara pots afegir despeses amb data anterior a aquell moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastaveno od %@. Stále můžete přidávat výdaje s datem před tímto okamžikem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat på pause siden %@. Du kan stadig tilføje udgifter dateret før det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert seit %@. Du kannst weiterhin Ausgaben mit einem früheren Datum hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε παύση από %@. Μπορείς να προσθέσεις έξοδα με ημερομηνία πριν από τότε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused since %@. You can still add expenses dated before then."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused since %@. You can still add expenses dated before then."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused since %@. You can still add expenses dated before then."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused since %@. You can still add expenses dated before then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa desde %@. Aún puedes añadir gastos con fecha anterior a ese momento."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa desde %@. Aún puedes agregar gastos con fecha anterior a ese momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskeytetty %@ lähtien. Voit silti lisätä kuluja, joiden päivämäärä on ennen sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendu depuis le %@. Tu peux toujours ajouter des dépenses datées d'avant."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendu depuis %@. Tu peux quand même ajouter des dépenses datées avant cette date."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מושהה מאז %@. עדיין ניתן להוסיף הוצאות בתאריך מוקדם מכך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ से रुका हुआ। आप अभी भी उससे पहले की तारीख वाले खर्च जोड़ सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
