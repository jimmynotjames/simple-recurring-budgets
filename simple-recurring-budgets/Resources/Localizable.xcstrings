            "value": "Dette kan ikke ændres, efter du har oprettet dit budget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann nach dem Erstellen deines Budgets nicht mehr geändert werden."
          }
        },
