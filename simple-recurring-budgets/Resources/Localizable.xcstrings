    "addEditBudget.action.delete.accessibilityHint": {
      "comment": "VoiceOver hint for the Delete Budget button, communicating the destructive and irreversible consequence",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف هذه الميزانية ونفقاتها نهائياً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বাজেট এবং এর খরচগুলি স্থায়ীভাবে মুছে ফেলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentment aquest pressupost i les seves despeses."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvale odstraní tento rozpočet a jeho výdaje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter dette budget og dets udgifter permanent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht dieses Budget und alle Ausgaben dauerhaft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει οριστικά αυτόν τον προϋπολογισμό και τα έξοδά του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes this budget and its expenses."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes this budget and its expenses."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes this budget and its expenses."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes this budget and its expenses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente este presupuesto y sus gastos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente este presupuesto y sus gastos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa tämän budjetin ja sen kulut pysyvästi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement ce budget et ses dépenses."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement ce budget et ses dépenses."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ બજેટ અને તેના ખર્ચને સ્થાયી રીતે કાઢી નાખે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוחק לצמיתות את התקציב והוצאותיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बजट और इसके सभी खर्च स्थायी रूप से हटा देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajno briše ovaj proračun i sve troškove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Véglegesen törli ezt a büdzsét és a hozzá tartozó kiadásokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus anggaran ini beserta pengeluarannya secara permanen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente questo budget e le sue spese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この予算とその支出を完全に削除します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಬಜೆಟ್ ಮತ್ತು ಅದರ ಖರ್ಚುಗಳನ್ನು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 예산과 모든 지출을 영구적으로 삭제해요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ബജറ്റ്‌ നിരന്തരമായി ഇല്ലാതാക്കി അതിന്റെ ചെലവുകളും ഇല്ലാതാക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा budget आणि त्याचे सर्व खर्च कायमचे हटवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadamkan belanjawan ini dan perbelanjaannya secara kekal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter dette budsjettet og alle utgifter permanent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert dit budget en de uitgaven permanent."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ବଜେଟ୍ ଏବଂ ଏହାର ଖର୍ଚ୍ଚ ସ୍ଥାୟୀভାବେ ବିଲୋପ କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਬਜਟ ਅਤੇ ਇਸ ਦੇ ਖਰਚੇ ਸਥਾਈ ਤੌਰ ਤੇ ਮਿਟਾ ਦਿੱਤਾ ਜਾਵੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usuwa ten budżet i jego wydatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui permanentemente este orçamento e suas despesas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente este orçamento e as suas despesas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge definitiv acest buget și cheltuielile sale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет этот бюджет и все его расходы безвозвратно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrvalo odstráni tento rozpočet a jeho výdavky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajno izbriše ta proračun in njegove stroške."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort den här budgeten och dess utgifter permanent."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பட்ஜெட்டையும் அதன் செலவுகளையும் நிரந்தரமாக நீக்குகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ బడ్జెట్‌ను మరియు దాని ఖర్చులను శాశ్వతంగా తొలగిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
