    "budgetDetail.resetBudget.dialog.message": {
      "comment": "Body of the reset-budget confirmation dialog.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف جميع النفقات نهائيًا، وسيُعاد تعيين Carry-Over إلى الصفر، وإن كانت الميزانية موقوفة فستُستأنف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Totes les despeses s'eliminaran permanentment, el Carry-Over es restablirà a zero i, si està en pausa, el pressupost es reprendrà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny výdaje budou trvale smazány, Carry-Over se vynuluje a pokud je rozpočet pozastaven, bude obnoven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle udgifter slettes permanent, carry-over nulstilles, og hvis budgettet er på pause, genoptages det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Ausgaben werden dauerhaft gelöscht, der Carry-Over auf null zurückgesetzt und das Budget fortgesetzt, falls es pausiert ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα τα έξοδα θα διαγραφούν οριστικά, το Carry-Over θα μηδενιστεί και, αν ο προϋπολογισμός είναι σε παύση, θα συνεχιστεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All expenses will be permanently deleted, carry-over will reset to zero, and if paused, the budget will resume."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "All expenses will be permanently deleted, carry-over will reset to zero, and if paused, the budget will resume."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "All expenses will be permanently deleted, carry-over will reset to zero, and if paused, the budget will resume."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "All expenses will be permanently deleted, carry-over will reset to zero, and if paused, the budget will resume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los gastos se eliminarán permanentemente, el saldo acumulado se restablecerá a cero y, si está pausado, el presupuesto se reanudará."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los gastos se eliminarán permanentemente, el Carry-Over se reiniciará a cero y, si está pausado, el presupuesto se reanudará."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki kulut poistetaan pysyvästi, Carry-Over nollataan ja tauolla oleva budjetti jatkuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les dépenses seront définitivement supprimées, le solde reporté sera réinitialisé à zéro, et le budget reprendra s'il est en pause."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les dépenses seront supprimées définitivement, le Carry-Over sera réinitialisé à zéro et, si suspendu, le budget reprendra."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל ההוצאות יימחקו לצמיתות, ה-Carry-Over יאופס לאפס, ואם התקציב מושהה הוא יחודש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी खर्च स्थायी रूप से हटा दिए जाएंगे, आगे ले जाई गई राशि शून्य में रीसेट हो जाएगी, और यदि बजट रोका गया है, तो यह फिर से चालू हो जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi troškovi bit će trajno izbrisani, Carry-Over se poništava na nulu, a ako je pauziran, proračun će se nastaviti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden kiadás véglegesen törlődik, a Carry-Over nullára áll vissza, és ha szüneteltetve volt, a költségkeret folytatódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua pengeluaran akan dihapus secara permanen, Carry-Over akan diatur ulang ke nol, dan jika dijeda, anggaran akan dilanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le spese verranno eliminate definitivamente, il Carry-Over verrà azzerato e, se sospeso, il budget riprenderà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての支出が完全に削除され、繰越額がゼロにリセットされ、一時停止中の場合は予算が再開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 지출이 영구적으로 삭제되고, 이월액이 0으로 초기화되며, 일시 중지된 경우 예산이 재개됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua perbelanjaan akan dipadam kekal, Carry-Over akan ditetapkan semula kepada sifar, dan jika dijeda, bajet akan disambung semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle utgifter slettes permanent, Carry-Over nullstilles til null, og hvis budsjettet er på pause, gjenopptas det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle uitgaven worden permanent verwijderd, de carry-over wordt teruggezet naar nul en als het budget gepauzeerd is, wordt het hervat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie wydatki zostaną trwale usunięte, Carry-Over zostanie zresetowany do zera, a budżet wznowi działanie, jeśli jest wstrzymany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as despesas serão excluídas permanentemente, o Carry-Over será zerado e, se pausado, o orçamento será retomado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as despesas serão eliminadas permanentemente, o saldo será reposto a zero e, se pausado, o orçamento será retomado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate cheltuielile vor fi șterse definitiv, Carry-Over va fi resetat la zero, iar dacă bugetul este întrerupt, va fi reluat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все расходы будут удалены навсегда, Carry-Over сбросится до нуля, а если бюджет приостановлен — он возобновится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky výdavky budú natrvalo vymazané, Carry-Over sa vynuluje na nulu, a ak je rozpočet pozastavený, bude obnovený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla utgifter raderas permanent, carry-over återställs till noll och budgeten återupptas om den är pausad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการค่าใช้จ่ายทั้งหมดจะถูกลบอย่างถาวร ยอดเงินที่นำไปยังงวดถัดไปจะรีเซ็ตเป็นศูนย์ และหากงบประมาณหยุดชั่วคราวอยู่ จะเริ่มทำงานอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm harcamalar kalıcı olarak silinecek, bakiye sıfırlanacak ve duraklatılmışsa bütçe devam edecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі витрати буде остаточно видалено, carry-over скинуто до нуля, а бюджет відновлено, якщо він на паузі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả chi phí sẽ bị xóa vĩnh viễn, số dư chuyển tiếp sẽ được đặt lại về 0 và nếu ngân sách đang tạm dừng, nó sẽ được tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有支出将被永久删除，结转金额将重置为零，如已暂停，预算将恢复运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有支出將被永久刪除、結餘結轉將重設為零，以及若預算已暫停，將恢復執行。"
          }
        }
      }
    },
