    "addEditBudget.orphanWarning.inline": {
      "comment": "Inline warning rendered inside the expanded Schedule disclosure on Edit Budget when the drafted startDate is after at least one already-logged expense. Quieter sibling of the Save-time alert. %lld is the count of orphaned expenses.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تاريخ البدء يقع بعد %lld مصروفات مسجّلة. تظل هذه المصروفات ظاهرة في قائمتك لكن لن تحتسبها هذه الميزانية."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تاريخ البدء يقع بعد %lld مصروفاً مسجّلاً. تظل هذه المصروفات ظاهرة في قائمتك لكن لن تحتسبها هذه الميزانية."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تاريخ البدء يقع بعد %lld مصروف مسجّل. يظل هذا المصروف ظاهراً في قائمتك لكن لن تحتسبه هذه الميزانية."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تاريخ البدء يقع بعد %lld مصروف مسجّل. تظل هذه المصروفات ظاهرة في قائمتك لكن لن تحتسبها هذه الميزانية."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تاريخ البدء يقع بعد %lld مصروفين مسجّلين. يظل هذان المصروفان ظاهرين في قائمتك لكن لن تحتسبهما هذه الميزانية."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تاريخ البدء يقع بعد %lld مصروف مسجّل. تظل المصروفات ظاهرة في قائمتك لكن لن تحتسبها هذه الميزانية."
                }
              }
            }
          }
        },
        "ca": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "La data d'inici és posterior a %lld despesa registrada. Aquesta despesa segueix apareixent a la llista però no serà comptabilitzada per aquest pressupost."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "La data d'inici és posterior a %lld despeses registrades. Aquestes despeses segueixen apareixent a la llista però no seran comptabilitzades per aquest pressupost."
                }
              }
            }
          }
        },
        "cs": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Datum začátku je po %lld zaznamenané výdajích. Tyto výdaje se stále zobrazují v seznamu, ale nebudou počítány tímto rozpočtem."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Datum začátku je po %lld zaznamenané výdaji. Tento výdaj se stále zobrazuje v seznamu, ale nebude počítán tímto rozpočtem."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Datum začátku je po %lld zaznamenané výdajích. Tyto výdaje se stále zobrazují v seznamu, ale nebudou počítány tímto rozpočtem."
                }
              }
            }
          }
        },
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Startdato er efter %lld logget udgift. Den udgift vises stadig på listen, men bliver ikke talt af dette budget."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Startdato er efter %lld loggede udgifter. Disse udgifter vises stadig på listen, men bliver ikke talt af dette budget."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Startdatum liegt nach %lld erfasster Ausgabe. Diese Ausgabe wird weiterhin in deiner Liste angezeigt, wird aber von diesem Budget nicht berücksichtigt."
                }
