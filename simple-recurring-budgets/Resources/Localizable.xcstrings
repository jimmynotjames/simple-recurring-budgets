            "value": "अवधियों में संचित अधिक- और कम-खर्च।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumulativna prekoračenja i uštedine kroz razdoblja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felhalmozódó túl- és alulköltés az időszakok között."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengakumulasi kelebihan dan kekurangan pengeluaran lintas periode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accumula saldi positivi e negativi tra i periodi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間をまたいだ累積的な予算超過と不足。"
